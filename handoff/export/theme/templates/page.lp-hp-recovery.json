    "lp_faq": {
      "type": "muto-lp-faq-2",
      "blocks": {
        "q1": {
          "type": "q",
          "settings": {
            "q": "Will it improve my HRV?",
            "a": "<p>We won’t promise what any number will do. Take a 7-day baseline, read 30-day averages rather than single nights, and judge it yourself over 90 days. If you don’t see a difference, you’re covered.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "q": "When should I take it around training?",
            "a": "<p>It doesn’t matter. Two capsules with your first meal, every day, training day or not. Consistency is what counts.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "q": "Can I take it with creatine and protein?",
            "a": "<p>Yes. MUTO sits alongside creatine and protein; your first order even includes our Ultrapure Creatine.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "q": "How do I track it?",
            "a": "<p>Take a 7-day baseline before your first capsule: HRV, resting heart rate, sleep and your recovery or readiness score, plus a 1–10 rating for how you feel. Then compare 30-day averages at day 30, 60 and 90. Single nights are noise; months are signal.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "q": "Which devices work?",
            "a": "<p>Any device that records HRV, resting heart rate and sleep: Garmin, WHOOP, Oura, Apple Watch, Polar, Coros and others. Use the same one for the whole 90 days. No device? A weekly 1–10 check-in works too.</p>"
          }
        },
        "q6": {
          "type": "q",
          "settings": {
            "q": "Am I locked into a subscription?",
            "a": "<p>No. Skip, pause or cancel online, any time. We remind you 5 days before every payment.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],
      "settings": {
        "heading": "You’ve got questions?\nWe’ve got answers.",
        "open_first": true,
        "schema_on": true
      }
    },
