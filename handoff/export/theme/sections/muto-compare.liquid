{%- comment -%}
  MUTO — Comparison. Shows "MUTO vs the usual" (snippets/muto-bf-compare.liquid, the same table as the
  Black Friday product page and the science page). Here the table is written straight into the page:
  the snippet's <template> wrapper and its swap script are stripped, so nothing depends on JavaScript.
{%- endcomment -%}
{%- capture cmp -%}{%- render 'muto-bf-compare' -%}{%- endcapture -%}
{%- assign cmp = cmp | split: '<script>' | first | remove: '<template id="mc-cmp-tpl">' | remove: '</template>' -%}
{{ cmp }}
{% schema %}
{
  "name": "MUTO — Comparison",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "The MUTO vs the usual table. Edit its rows in snippets/muto-bf-compare.liquid." }
  ],
  "presets": [{ "name": "MUTO — Comparison" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
