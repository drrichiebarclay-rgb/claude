{%- comment -%}
  MUTO — Black Friday plan cards, AG1-style pricing (muto-bf-ag1-plans).
  Rendered by a custom-liquid section placed straight after the buy box on the Black Friday product templates
  (main, url-2's muto-nad-bf-premium-2, url-3). Rebuilds what each plan card shows, in AG1's order:
    radio · plan name · Save pill (right)
    £33/mo  £70 crossed out
    90-day supply, delivered every 3 months ........ £1.10/serving
    £99 on your first order
    then £125 for your next 3 months, then £150 every 3 months
  with a "Black Friday offer" band on the 3-month card, and under the cards the selected plan's terms and a
  "For comparison" line. The card's own radio, selection and Add to cart are untouched: only the copy inside is
  replaced, and the old price/note/tab text is hidden. Figures are typed below (PLANS); change them there.
  Remove the section from a template and that page goes back to the previous cards.
{%- endcomment -%}
<style>
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag{display:block!important;position:relative;padding:0!important;border:1px solid rgba(36,34,35,.18)!important;border-radius:10px!important;background:#fff!important;box-shadow:none!important;overflow:hidden;min-height:0!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag.is-selected{border:1.5px solid #242223!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag::before,
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag::after{content:none!important;display:none!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag > .mc__plan-prices,
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag > .mc__plan-note,
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-save,
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-name{display:none!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-head::before,
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-head::after{display:none!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-head{display:flex!important;align-items:center!important;gap:12px!important;margin:0!important;padding:0!important;position:static!important}
  html:root body #MainContent#MainContent .mc .mc__plans > label.mc__plan.is-ag.is-ag .mc__plan-dot{flex:0 0 22px!important;width:22px!important;height:22px!important;margin:0!important;position:static!important}
  /* Where the welcome kit hangs off the selected card as one panel (premium designs), the card's bottom joins it:
     square corners, no bottom border; the kit's own sides and dividing rule carry on below */
  html:root body #MainContent#MainContent .mc .mc__plans:has(> .mc__kit) > label.mc__plan.is-ag.is-ag.is-selected{border-bottom:0!important;border-bottom-left-radius:0!important;border-bottom-right-radius:0!important}
  .ag-band{display:flex;align-items:center;gap:10px;padding:11px 18px;background:#242223;color:#fff;font-family:var(--mc-mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase}
  .ag-band i{font-style:normal;color:#5efaff;letter-spacing:0}
  .ag-in{display:block;padding:16px 18px 16px}
  .ag-name{flex:1 1 auto;min-width:0;font-family:var(--mc-font);font-size:18px;font-weight:500;line-height:1.2;color:#242223}
  .ag-save{flex:0 0 auto;margin-left:auto;padding:4px 9px;background:#5efaff;color:#242223;font-family:var(--mc-mono);font-size:10.5px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .ag-body{display:block;padding-left:34px}
  .ag-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;margin-top:8px;font-family:var(--mc-font);color:#242223}
  .ag-price b{font-size:30px;font-weight:500;line-height:1;letter-spacing:-.02em}
  .ag-price em{margin-left:-8px;font-style:normal;font-size:19px;font-weight:500}
  .ag-price s{font-size:17px;color:rgba(36,34,35,.5);text-decoration-thickness:1.5px}
  .ag-line{display:flex;flex-wrap:wrap;justify-content:space-between;gap:2px 12px;margin-top:8px;font-family:var(--mc-font);font-size:15px;line-height:1.4;color:#242223}
  .ag-line span + span{color:rgba(36,34,35,.62)}
  .ag-sm{display:block;margin-top:3px;font-family:var(--mc-font);font-size:14.5px;line-height:1.4;color:rgba(36,34,35,.62)}
  .ag-terms{margin:4px 0 0;padding:14px 2px 0;font-family:var(--mc-font);font-size:13.5px;line-height:1.5;color:#242223}
  .ag-terms p{margin:0}
  .ag-terms p + p{margin-top:8px}
  .ag-terms .ag-cmp{font-style:italic;color:rgba(36,34,35,.62)}
  .ag-terms[hidden]{display:none}
  @media (max-width:749px){
    .ag-body{padding-left:0}
    .ag-name{font-size:17px}
    .ag-price b{font-size:28px}
  }
</style>
<script>
(function () {
  /* The plans, matched on the card's name or price. Typed here so every Black Friday page says the same. */
  var PLANS = [
    { match: /3.?month|quarter|£99/i, band: 'Black Friday offer', name: '3-Month Supply', save: 'Save 53%',
      price: '£33', unit: '/mo', was: '£70',
      line: '90-day supply, delivered every 3 months', per: '£1.10 a day',
      small: ['£99 on your first order', 'then £125 for your next 3 months, then £150 every 3 months'],
      terms: 'Black Friday offer for first-time subscribers, on your first order only, while stock lasts. Your plan then renews automatically every 3 months until you cancel. Skip, pause or cancel online anytime, and we remind you 5 days before each payment.',
      compare: 'For comparison: £33 a month for your first 3 months, £41.67 a month for the next 3, then £50 a month.' },
    { match: /1.?month|monthly|£49/i, band: '', name: '1-Month Supply', save: 'Save 28%',
      price: '£49.99', unit: '/mo', was: '£70',
      line: '30-day supply, delivered every month', per: '£1.79 a day',
      small: ['£49.99 on your first order', 'then £60 every month'],
      terms: 'Offer on your first order only. Your plan then renews automatically every month until you cancel. Skip, pause or cancel online anytime, and we remind you 5 days before each payment.',
      compare: 'For comparison: £49.99 for your first month, then £60 a month.' }
  ];
  function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }
  function find(card) {
    var key = (card.getAttribute('data-name') || '') + ' ' + (card.getAttribute('data-price') || '') + ' ' + ((card.querySelector('.mc__plan-name') || {}).textContent || '');
    for (var i = 0; i < PLANS.length; i++) if (PLANS[i].match.test(key)) return PLANS[i];
    return null;
  }
  function build(card) {
    if (card.classList.contains('is-ag')) return;
    var p = find(card), head = card.querySelector('.mc__plan-head');
    if (!p || !head) return;
    card.classList.add('is-ag');
    card._ag = p;
    if (p.band) card.insertBefore(el('span', 'ag-band', '<i aria-hidden="true">✦</i>' + p.band), head);
    var inner = el('span', 'ag-in');
    card.insertBefore(inner, head);
    inner.appendChild(head);
    head.appendChild(el('span', 'ag-name', p.name));
    if (p.save) head.appendChild(el('span', 'ag-save', p.save));
    var body = el('span', 'ag-body');
    body.appendChild(el('span', 'ag-price', '<b>' + p.price + '</b><em>' + p.unit + '</em>' + (p.was ? '<s><span class="visually-hidden">Was </span>' + p.was + '</s>' : '')));
    body.appendChild(el('span', 'ag-line', '<span>' + p.line + '</span><span>' + p.per + '</span>'));
    p.small.forEach(function (t) { body.appendChild(el('span', 'ag-sm', t)); });
    inner.appendChild(body);
  }
  function terms(plans) {
    var box = plans.querySelector(':scope > .ag-terms');
    if (!box) {
      box = el('div', 'ag-terms');
      var cards = plans.querySelectorAll(':scope > label.mc__plan');
      var last = cards[cards.length - 1];
      if (last && last.nextSibling) plans.insertBefore(box, last.nextSibling); else plans.appendChild(box);
    }
    var sel = plans.querySelector(':scope > label.mc__plan.is-selected') || plans.querySelector(':scope > label.mc__plan');
    var p = sel && sel._ag;
    box.hidden = !p;
    if (p) box.innerHTML = '<p>' + p.terms + '</p><p class="ag-cmp">' + p.compare + '</p>';
  }
  function run() {
    [].forEach.call(document.querySelectorAll('#MainContent .mc .mc__plans'), function (plans) {
      [].forEach.call(plans.querySelectorAll(':scope > label.mc__plan'), build);
      terms(plans);
    });
  }
  run();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  document.addEventListener('muto:home:plan', function () { setTimeout(run, 0); });
  document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.mc__plan')) setTimeout(run, 30); });
})();
</script>
