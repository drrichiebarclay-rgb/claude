{%- comment -%}
  MUTO — Statement. One heading and one line under it, centred, nothing else.
  A pause between two busier bands.
{%- endcomment -%}
{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
{{ 'muto-crea-trust.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign spt = section.settings.space_top | default: 100 | times: 0.01
  assign spb = section.settings.space_bottom | default: 100 | times: 0.01
-%}
<div class="mc mc--stm" style="--mc-spt:{{ spt }};--mc-spb:{{ spb }}">
  <div class="mc__wrap">
    <section class="mc__stm" aria-label="{{ section.settings.heading | escape }}">
      {%- if section.settings.label != blank -%}<p class="mc__mono mc__stm-label">{{ section.settings.label }}</p>{%- endif -%}
      <h2 class="mc__h2 mc__stm-head">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.sub != blank -%}<p class="mc__stm-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </section>
  </div>
</div>
{% schema %}
{
  "name": "MUTO — Statement",
  "tag": "section",
  "class": "mc-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label above (optional)" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A daily supplement." },
    { "type": "text", "id": "sub", "label": "Sub-heading", "default": "Built for your biology after 35 years old." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "MUTO — Statement" }],
  "enabled_on": { "templates": ["product", "page", "index"] }
}
{% endschema %}
