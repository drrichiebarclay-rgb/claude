    "faq": {
      "type": "muto-crea-faq",
      "blocks": {
        "q0": {
          "type": "q",
          "settings": {
            "title": "Is it right for my age?",
            "text": "<p>Yes. MUTO is made for adults over 35, and most of our customers are in their 40s and 50s. You don’t need to be sporty or own a smartwatch.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "title": "Is it safe with my other pills?",
            "text": "<p>Usually, yes. Coffee is fine too.</p><p>Take medicine? Ask your doctor first, especially if you take a blood thinner like warfarin.</p>"
          }
        },
        "q1": {
          "type": "q",
          "settings": {
            "title": "How do I know it’s working?",
            "text": "<p>Before you start, score your energy and sleep out of 10. Do it again at day 30 and day 90. Then compare.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "title": "When will I notice something?",
            "text": "<p>Give it 60 to 90 days. Some people notice a change in a few weeks. For others it takes longer.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "title": "What if it’s not for me?",
            "text": "<p>Email <a href=\"mailto:hello@mutolongevity.com\">hello@mutolongevity.com</a> within 14 days after your 90 days end. We’ll give back what you paid, minus delivery.</p><p>This is for first-time subscribers who buy at muto.co.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "title": "Why not just take one vitamin?",
            "text": "<p>You can. MUTO puts 19 ingredients, each at a declared dose, into 2 capsules: 300mg NR plus the B vitamins, TMG, CoQ10 and PQQ that work alongside it. One jar instead of several pots.</p>"
          }
        },
        "q_tested": {
          "type": "q",
          "settings": {
            "title": "How is it tested?",
            "text": "<p>Every batch is tested by an independent lab for identity, potency, heavy metals and microbes before it’s released. MUTO is made in the UK to GMP standards, in an ISO-certified facility.</p>"
          }
        }
      },
