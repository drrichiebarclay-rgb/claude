    "head_styles": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n/* -2 product page (product.muto-nad-45): Artah-style buy box.\n   Scoped to this template only (this block lives in the template). */\n\n/* ---- Title block ---- */\nhtml body .mc .mc__eyebrow{font-size:13px;letter-spacing:.12em}\nhtml body .mc .mc__buy-title{font-size:clamp(30px,3.2vw,46px);line-height:.95;margin-top:6px}\nhtml body .mc .mc__buy-serving{margin-top:14px;font-size:12px;line-height:1.5;letter-spacing:.08em}\nhtml body .mc .mc__buy-text{margin-top:14px;font-size:15px;line-height:1.55;color:#242223}\nhtml body .mc .mc__buy-text p:first-child{font-size:18px;line-height:1.35;padding-bottom:14px;margin-bottom:14px;border-bottom:2px solid var(--mc-ink-alt,#242223);color:var(--mc-ink-alt,#242223)}\nhtml body .mc .mc__buy-text p:first-child strong{font-weight:500}\nhtml body .mc .mc__buy-text > * + *{margin-top:10px}\nhtml body .mc .mc__buy-text a[href=\"#whats-inside\"]{color:rgba(36,34,35,.7);font-weight:500;text-decoration:underline;text-underline-offset:4px}\n\n/* ---- Benefits: two columns with rules, like a spec list ---- */\nhtml body .mc .mc__buy-points{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;column-gap:28px}\nhtml body .mc .mc__buy-points::before{content:\"Benefits\";grid-column:1/-1;font-size:14px;font-weight:500;color:rgba(36,34,35,.6);padding-bottom:8px}\nhtml body .mc .mc__point{padding:11px 0;padding-left:0;border-top:1px solid rgba(36,34,35,.14);font-size:14px;line-height:1.35;font-weight:500}\nhtml body .mc .mc__point + .mc__point{margin-top:0}\nhtml body .mc .mc__point::before{display:none}\n/* \"Choose your plan\", with a rule either side */\nhtml body .mc .mc__buy-points::after{content:\"Choose your plan\";grid-column:1/-1;margin-top:26px;display:flex;align-items:center;gap:16px;font-size:20px;font-weight:500;letter-spacing:-.01em;color:var(--mc-ink-alt,#242223);\n  background:linear-gradient(var(--mc-ink-alt,#242223),var(--mc-ink-alt,#242223)) left center/calc(50% - 110px) 2px no-repeat,linear-gradient(var(--mc-ink-alt,#242223),var(--mc-ink-alt,#242223)) right center/calc(50% - 110px) 2px no-repeat;justify-content:center}\nhtml body .mc .mc__trust{display:none}\n\n/* ---- Plans: one box per plan; clicking a box selects it and expands it ---- */\nhtml body .mc .mc__plans{margin-top:16px;padding:0;border-radius:0;background:none;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none;overflow:visible;display:flex;flex-direction:column}\nhtml body .mc .mc__plans > *{order:9}\nhtml body .mc .mc__plans-banner{order:1;margin:0;padding:12px 18px;border-radius:14px 14px 0 0;font-size:13px;line-height:1.3;letter-spacing:.06em}\n/* Skio order is monthly (1) then quarterly (2); quarterly leads. The selected plan's detail and\n   the gift area (which the section fills for the selected plan) sit inside that plan's box. */\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2){order:2;margin-top:0}\nhtml body .mc .mc__plans > .mc__plan-detail[data-mc-plan-for=\"2\"]{order:3}\nhtml body .mc .mc__plans:has(> label.mc__plan:nth-of-type(2).is-selected) > .mc__kit{order:4}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(1){order:5;margin-top:14px}\nhtml body .mc .mc__plans > .mc__plan-detail[data-mc-plan-for=\"1\"]{order:6}\nhtml body .mc .mc__plans:has(> label.mc__plan:nth-of-type(1).is-selected) > .mc__kit{order:7}\n/* Collapsed box */\nhtml body .mc .mc__plan{padding:18px 18px 16px;border:0;border-radius:14px;background:#fff;box-shadow:inset 0 0 0 1px #242223}\nhtml body .mc .mc__plan + .mc__plan{padding-top:18px;border-top:0}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2){border-radius:0 0 14px 14px;box-shadow:inset 1px 0 0 #242223,inset -1px 0 0 #242223,inset 0 -1px 0 #242223}\n/* Open box: card, then ticks, then gifts, all inside one outline */\nhtml body .mc .mc__plan.is-selected{border-radius:14px 14px 0 0;box-shadow:inset 2px 0 0 #242223,inset -2px 0 0 #242223,inset 0 2px 0 #242223}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2).is-selected{border-radius:0;box-shadow:inset 2px 0 0 #242223,inset -2px 0 0 #242223}\nhtml body .mc .mc__plan-head{gap:12px;flex-wrap:wrap}\nhtml body .mc .mc__plan-name{font-size:18px;line-height:1.25}\nhtml body .mc .mc__plan-save{height:26px;margin-left:0;padding:0 11px;border-radius:13px;font-size:11.5px;background:#242223;color:#fff;letter-spacing:.06em}\nhtml body .mc .mc__plan-price{font-size:20px}\nhtml body .mc .mc__plan-was{font-size:14px;margin-top:3px}\nhtml body .mc .mc__plan-note{font-size:13px;line-height:1.35;margin-top:6px;margin-left:33px;color:rgba(36,34,35,.7)}\nhtml body .mc .mc__plans > .mc__plan-detail{margin:0;padding:0 18px 4px;border-radius:0;background:#fff;box-shadow:inset 2px 0 0 #242223,inset -2px 0 0 #242223;font-size:15px;line-height:1.4;color:#242223}\nhtml body .mc .mc__plan-detail ul{margin:0;padding:14px 0 0;border-top:1.5px solid #242223;display:grid;gap:8px}\nhtml body .mc .mc__plan-detail li{margin:0;padding-left:24px;list-style:none;position:relative;font-weight:500}\nhtml body .mc .mc__plan-detail li::before{content:\"\";position:absolute;left:0;top:.38em;width:13px;height:10px;background:currentColor;clip-path:polygon(0 52%,13% 38%,38% 64%,88% 2%,100% 16%,38% 92%)}\n/* Gifts for the selected plan, closing the box */\nhtml body .mc .mc__plans > .mc__kit{margin:0;padding:16px 18px 18px;border-top:0;border-radius:0 0 14px 14px;background:#fff;box-shadow:inset 2px 0 0 #242223,inset -2px 0 0 #242223,inset 0 -2px 0 #242223}\nhtml body .mc .mc__kit-title{font-family:var(--mc-mono,monospace);font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}\nhtml body .mc .mc__kit-list{display:grid !important;grid-template-columns:none !important;grid-auto-flow:column;grid-auto-columns:minmax(0,72px);justify-content:start;gap:10px !important;margin-top:12px}\nhtml body .mc .mc__kit-list li{text-align:center}\nhtml body .mc .mc__kit-frame{border-radius:8px;overflow:hidden}\nhtml body .mc .mc__kit-value{font-size:11.5px;margin-top:5px}\nhtml body .mc .mc__kit-name{font-size:11.5px;line-height:1.25}\nhtml body .mc .mc__kit-more{margin-top:16px}\nhtml body .mc .mc__kit-sum{display:flex;align-items:center;justify-content:center;gap:8px;min-height:46px;border-radius:23px;background:rgba(36,34,35,.07);font-size:15px;font-weight:500;cursor:pointer}\n\n/* ---- Welcome kit and later gifts ---- */\nhtml body .mc .mc__kit-month-n,html body .mc .mc__kit-month-v,html body .mc .mc__kit-month-t{font-size:12px;color:#242223}\nhtml body .mc .mc__kit-body{font-size:14px;color:#242223}\n\n/* ---- One-time purchase as its own row, then the button ---- */\nhtml body .mc .mc__onetime{display:block;width:100%;margin-top:14px;padding:16px 20px;border:1px solid rgba(36,34,35,.2);border-radius:14px;background:#fff;text-align:left;text-decoration:none;font-size:15px;line-height:1.3}\nhtml body .mc .mc__onetime:hover{border-color:var(--mc-ink-alt,#242223)}\nhtml body .mc .mc__buy-cta{margin-top:16px;height:58px}\nhtml body .mc .mc__btn{font-size:16px}\n\n/* ---- Folds and review quotes under the button ---- */\nhtml body .mc .mc__acc-sum{font-size:15px;min-height:52px}\nhtml body .mc .mc__acc-body{font-size:15px;line-height:1.5;color:#242223}\nhtml body .mc .mc__rev-q{font-size:15px}\n\n@media (max-width:749px){\n  html body .mc .mc__buy-title{font-size:32px}\n  html body .mc .mc__buy-text p:first-child{font-size:17px}\n  html body .mc .mc__buy-points{column-gap:16px}\n  html body .mc .mc__point{font-size:13.5px}\n  html body .mc .mc__buy-points::after{font-size:18px;background-size:calc(50% - 95px) 2px,calc(50% - 95px) 2px}\n  html body .mc .mc__plan-detail ul{grid-template-columns:1fr}\n}\n\n/* Button: old price struck through, then the price (\"Subscribe · £70 £60\") */\nhtml body .mc .mc-art__cta-was{font-weight:500;opacity:.55;text-decoration:line-through}\nhtml body .mc .mc-art__cta-was:not(:empty)::before{content:\"\\00b7\";display:inline-block;margin:0 .42em;opacity:.9;text-decoration:none}\nhtml body .mc .mc-art__cta-was:not(:empty) + .mc__btn-price::before{content:\"\";margin:0 0 0 .35em}\n\n/* Desktop gallery: thumbnails in their own column to the left of the main image (not over it) */\n@media screen and (min-width:990px){\n  html body .mc .mc__gallery{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:16px;align-items:start}\n  html body .mc .mc__gallery-main{grid-column:2;grid-row:1}\n  html body .mc .mc__thumbs{grid-column:1;grid-row:1;position:static;left:auto;top:auto;z-index:auto;\n    display:flex;flex-direction:column;gap:12px;margin:0;padding:2px;\n    align-self:stretch;height:0;min-height:100%;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin}\n  html body .mc .mc__thumbs[hidden]{display:none}\n  html body .mc .mc__thumb{width:64px;flex:0 0 auto;border-radius:10px}\n}\n\n\n/* Black Friday box, above the plans: white, black outline. Offer on the left, orders left out\n   of 500 on the right (under it on phones), a bar along the foot. */\nhtml body .mc .mc-bf{margin:18px 0 0;padding:16px 18px 16px;border:1.5px solid #242223;border-radius:12px;background:#fff;color:#242223;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;align-items:start}\nhtml body .mc .mc-bf[hidden]{display:none}\n/* Black Friday subhead: fill each line before breaking (no balancing), a touch heavier */\nhtml body .mc .mc-subhead,html body .mc .mc__buy-copy > .mc-subhead{text-wrap:wrap!important;font-weight:500!important}\nhtml body .mc .mc-bf__tag{grid-column:1/-1;display:flex;align-items:center;gap:8px;margin:0 0 4px;font-family:var(--mc-mono,monospace);font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}\nhtml body .mc .mc-bf__dot{width:8px;height:8px;border-radius:50%;background:#242223;animation:mcBfPulse 1.6s ease-in-out infinite}\n@keyframes mcBfPulse{50%{opacity:.25}}\nhtml body .mc .mc-bf__main{grid-column:1;min-width:0}\nhtml body .mc .mc-bf__offer{margin:0;font-size:clamp(24px,2.4vw,30px);font-weight:600;line-height:1.05;letter-spacing:-.01em}\nhtml body .mc .mc-bf__kit{margin:4px 0 0;font-size:16px;font-weight:600;line-height:1.25}\nhtml body .mc .mc-bf__sched{margin:8px 0 0;font-size:14px;line-height:1.4;color:rgba(36,34,35,.75)}\nhtml body .mc .mc-bf__count{grid-column:2;grid-row:2;margin:0;min-width:96px;padding:10px 12px 8px;border:1.5px solid #242223;border-radius:10px;text-align:center}\nhtml body .mc .mc-bf__count b{display:block;font-size:30px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}\nhtml body .mc .mc-bf__count small{display:block;margin-top:4px;font-family:var(--mc-mono,monospace);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}\nhtml body .mc .mc-bf__foot{grid-column:1/-1;display:flex;align-items:center;gap:12px;margin-top:10px}\nhtml body .mc .mc-bf__bar{flex:1;display:block;height:6px;border-radius:3px;background:rgba(36,34,35,.12);overflow:hidden}\nhtml body .mc .mc-bf__bar i{display:block;height:100%;background:#242223;border-radius:3px}\nhtml body .mc .mc-bf__note{flex:0 0 auto;margin:0;font-size:12px;line-height:1.35;color:rgba(36,34,35,.7)}\nhtml body .mc .mc-bf__note b{font-family:var(--mc-mono,monospace);letter-spacing:.06em;color:#242223}\n@media (max-width:480px){\n  html body .mc .mc-bf{grid-template-columns:1fr}\n  html body .mc .mc-bf__count{grid-column:1;grid-row:auto;display:flex;align-items:baseline;gap:8px;margin-top:10px;text-align:left}\n  html body .mc .mc-bf__count b{display:inline;font-size:24px}\n  html body .mc .mc-bf__count small{display:inline;margin:0}\n  html body .mc .mc-bf__foot{flex-wrap:wrap}\n}\n\n/* -2 page only: sections below the buy box back to standard sizes (they were enlarged) */\n/* ---- Rest of the page: back to standard sizes (was enlarged) ---- */\nhtml body .mc .mc__body,html body .mc .mc__ben-body,html body .mc .mc__ben-lede,html body .mc .mc__ben-name,\nhtml body .mc .mc__ben-sub,html body .mc .mc__step-text,html body .mc .mc__faq-body,html body .mc .mc__faq-sum,\nhtml body .mc .mc__gua-text,html body .mc .mc__note-text{font-size:16px;line-height:1.5}\nhtml body .mc .mc__ben-body,html body .mc .mc__faq-body{color:#242223}\nhtml body .mc .mc__prob-lede{font-size:18px;line-height:1.45}\nhtml body .mc .mc__prob-quote{font-size:22px;line-height:1.2}\nhtml body .mc .mc__prob-text{font-size:16px;line-height:1.45}\nhtml body .mc .mc__step-title{font-size:21px;line-height:1.2}\nhtml body .mc .mc__step-chip,html body .mc .mc__gua-chip{font-size:14px}\nhtml body .mc .mc__gua-aside{font-size:20px}\nhtml body .mc .mc__tabs{display:none}\nhtml body .mh .mh__why-title{font-size:22px}\nhtml body .mh .mh__why-text{font-size:16px;line-height:1.5;color:var(--mh-ink,#162f31)}\nhtml body .mh .mh__board-note,html body .mh .mh__res-note{font-size:15px;color:#242223}\nhtml body .mh .mh__res-quote{font-size:15px;line-height:1.45;color:#242223}\nhtml body .mh .mh__res-detail,html body .mh .mh__res-foot{font-size:13px;color:rgba(35,33,35,.8)}\nhtml body .mh__sticky-sub{font-size:13px;color:rgba(249,249,249,.85)}\nhtml body .mh__sticky-btn{font-size:15px}\n\n@media (max-width:749px){\n  html body .mc .mc__prob-quote{font-size:20px}\n  html body .mc .mc__step-title{font-size:19px}\n}\n\n/* ---- 40-60 buy box ---- */\n/* Main PDP buy box for 40-60 year olds who aren't sport focused.\n   Loaded after artah.css + bf.css in the easy_read block, so it only overrides. */\n\n/* ---- Easier to read: bigger type, darker greys ---- */\nhtml body .mc .mc__buy-serving{font-size:13px;color:#242223}\nhtml body .mc .mc__buy-text{font-size:17px;line-height:1.55}\nhtml body .mc .mc__buy-text p:first-child{font-size:21px;line-height:1.3}\nhtml body .mc .mc__buy-text a[href=\"#whats-inside\"]{color:#242223}\nhtml body .mc .mc__point{font-size:16px;line-height:1.35;padding:12px 0}\nhtml body .mc .mc__buy-points::before{content:\"How it helps\";font-size:15px;color:#242223}\nhtml body .mc .mc__plan-name{font-size:19px}\nhtml body .mc .mc__plan-save{font-size:12.5px}\nhtml body .mc .mc__plan-price{font-size:22px}\nhtml body .mc .mc__plan-note{font-size:15px;color:#242223}\nhtml body .mc .mc__plans > .mc__plan-detail{font-size:16px}\nhtml body .mc .mc__plans-banner{font-size:14px}\nhtml body .mc .mc__kit-title{font-size:13px}\nhtml body .mc .mc__kit-list{grid-auto-columns:minmax(0,80px)}\nhtml body .mc .mc__kit-value,html body .mc .mc__kit-name{font-size:13px}\nhtml body .mc .mc__kit-month-n,html body .mc .mc__kit-month-v,html body .mc .mc__kit-month-t{font-size:13px}\nhtml body .mc .mc__kit-sum{font-size:16px;min-height:50px}\nhtml body .mc .mc__onetime{font-size:16px;padding:18px 20px}\nhtml body .mc .mc__btn{font-size:18px}\nhtml body .mc .mc__buy-cta{height:62px}\nhtml body .mc .mc__acc-sum{font-size:17px;min-height:56px}\nhtml body .mc .mc__acc-body{font-size:16px}\nhtml body .mc .mc__rev-q{font-size:18px}\nhtml body .mc .mc__rev-n{font-size:13px;color:#242223}\n\n/* ---- Reassurance before the price: three ticks in one row, then \"Choose your plan\" ---- */\nhtml body .mc .mc__buy-points::after{content:none}\nhtml body .mc .mc__trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:18px 0 0;padding:0;list-style:none}\nhtml body .mc .mc__trust li{display:flex;align-items:flex-start;gap:8px;margin:0;padding:12px;border-radius:12px;background:rgba(36,34,35,.06);font-size:14px;line-height:1.3;font-weight:500;color:#242223}\nhtml body .mc .mc__trust li::before{content:\"\";flex:0 0 13px;height:10px;margin-top:.3em;background:currentColor;clip-path:polygon(0 52%,13% 38%,38% 64%,88% 2%,100% 16%,38% 92%)}\nhtml body .mc .mc__trust::after{content:\"Choose your plan\";grid-column:1/-1;margin-top:20px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:500;letter-spacing:-.01em;color:var(--mc-ink-alt,#242223);\n  background:linear-gradient(var(--mc-ink-alt,#242223),var(--mc-ink-alt,#242223)) left center/calc(50% - 110px) 2px no-repeat,linear-gradient(var(--mc-ink-alt,#242223),var(--mc-ink-alt,#242223)) right center/calc(50% - 110px) 2px no-repeat}\n\n@media (max-width:749px){\n  html body .mc .mc__buy-text p:first-child{font-size:19px}\n  html body .mc .mc__buy-text{font-size:16px}\n  html body .mc .mc__buy-points{grid-template-columns:1fr}\n  html body .mc .mc__point{font-size:16px}\n  html body .mc .mc__trust{grid-template-columns:1fr;gap:6px}\n  html body .mc .mc__trust li{padding:10px 12px;font-size:15px}\n  html body .mc .mc__trust::after{font-size:18px;margin-top:16px;background-size:calc(50% - 95px) 2px,calc(50% - 95px) 2px}\n  html body .mc .mc__kit-list{grid-auto-columns:minmax(0,72px)}\n}\n\n/* New PDP: plain #fafafa behind the buy box, no gradient */\nhtml body .mc.mc--buy,html body .mc.mc--buy.mc--fit-nad{background:#fafafa!important}\n/* New PDP: the pills moved under the button as badges; only the heading stays */\nhtml body .mc .mc__trust li{display:none}\nhtml body .mc .mc__trust::after{margin-top:8px}\n\n/* ---- Plan cards, AG1-style: per-month price, % off tag in the top-left corner, Best value bar ---- */\n/* Skio still bills £150 every 3 months and £60 every 4 weeks. The section prints Skio's price and\n   compare-at, so the per-month figures are drawn here and Skio's are hidden (still in the DOM, so the\n   button keeps reading the billed price). Card 1 = monthly, card 2 = quarterly (Skio's order). */\nhtml body .mc .mc__plans > label.mc__plan{padding-top:44px}\nhtml body .mc .mc__plan-save{position:absolute;top:0;left:0;height:28px;margin:0;padding:0 12px;border-radius:14px 0 10px 0;\n  display:flex;align-items:center;background:#7ee0f0;color:#242223;font-family:var(--mc-mono,monospace);\n  font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2) .mc__plan-save{border-radius:0 0 10px 0}\nhtml body .mc .mc__plan-prices > *{display:none}\nhtml body .mc .mc__plan-prices::before,html body .mc .mc__plan-prices::after{display:block}\nhtml body .mc .mc__plan-prices::before{font-weight:500;font-size:22px;line-height:1.1;letter-spacing:-.01em;color:#242223}\nhtml body .mc .mc__plan-prices::after{margin-top:4px;font-size:16px;line-height:1.2;text-decoration:line-through;color:rgba(36,34,35,.5)}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(1) .mc__plan-prices::before{content:\"£49.99/mo\"}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(1) .mc__plan-prices::after{content:\"£70\"}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2) .mc__plan-prices::before{content:\"£33/mo\"}\nhtml body .mc .mc__plans > label.mc__plan:nth-of-type(2) .mc__plan-prices::after{content:\"£70\"}\n/* Best value: the dark bar over the quarterly box leads with it; the welcome-kit line follows */\nhtml body .mc .mc__plans-banner{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:4px 16px}\nhtml body .mc .mc__plans-banner::before{content:\"\\2726\\00a0\\00a0 Best value\";color:#7ee0f0;font-family:var(--mc-mono,monospace);letter-spacing:.1em}\n\n/* ---- Top of the page, AgeMate-style: stars, title and subhead over the images on phones,\n   then a \"View third-party testing results\" button under them ---- */\nhtml body .mc .mc-subhead{margin:8px 0 0;font-size:17px;line-height:1.4;color:#242223;text-wrap:balance}\nhtml body .mc .mc-tests-btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:52px;margin:14px 0 0;padding:10px 20px;\n  border:1.5px solid #242223;border-radius:999px;background:none;font:inherit;font-size:16px;font-weight:500;color:#242223;cursor:pointer;transition:background .2s,color .2s}\nhtml body .mc .mc-tests-btn:hover{background:#242223;color:#fff}\nhtml body .mc .mc-tests-btn:focus-visible{outline:2px solid #242223;outline-offset:2px}\nhtml body .mc .mc-tests-btn__tick{flex:0 0 20px;display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#7ee0f0;box-shadow:0 0 0 1px #242223;color:#242223}\nhtml body .mc .mc-tests-btn__tick svg{width:11px;height:11px}\n/* Rating row, AgeMate-style: bigger stars, the score in Neue Haas, as typed, no underline */\nhtml body .mc .mc__rating{align-items:center;gap:10px}\nhtml body .mc .mc__stars{gap:4px;margin-top:0}\nhtml body .mc .mc__stars > span{width:19px;height:18px}\nhtml body .mc .mc__rating-text{font-family:var(--mc-font);font-size:17px;line-height:1.2;font-weight:500;letter-spacing:0;text-transform:none;text-decoration:none;color:#242223}\n/* Sticky bar: old price struck through before the per-month price */\nhtml body .mh__sticky .mc-sticky-was{margin-right:.25em;font-weight:500;opacity:.55;text-decoration:line-through}\n/* Room under \"Choose your plan\" before the Black Friday box */\nhtml body .mc .mc__buy-copy > .mc-bf{margin-top:24px}\n/* Order of the copy column, same at every width: stars, title, subhead · the offer (Black Friday box,\n   \"Choose your plan\", plans, one-time, button, badges) · then the serving line, description, reviews and\n   folds. Phones also put the images and testing button between the subhead and the offer (below). */\nhtml body .mc .mc__buy-copy > *{order:3}\nhtml body .mc .mc__buy-copy > .mc-bf,html body .mc .mc__buy-copy > .mc__trust,html body .mc .mc__buy-copy > .mc__plans,\nhtml body .mc .mc__buy-copy > .mc__pf,html body .mc .mc__buy-copy > .mc__onetime,html body .mc .mc__buy-copy > .mc__buy-cta,\nhtml body .mc .mc__buy-copy > .mc__buy-actions,html body .mc .mc__buy-copy > .mpb-x,\nhtml body .mc .mc__buy-copy > .mc__pf > *{order:2} /* .mc__pf is display:contents: its button is the item */\nhtml body .mc .mc__buy-copy > .mc__rating,html body .mc .mc__buy-copy > .mc__eyebrow,\nhtml body .mc .mc__buy-copy > .mc__buy-title,html body .mc .mc__buy-copy > .mc-subhead{order:0}\nhtml body .mc .mc__buy-copy > .mc__buy-serving{margin-top:32px}\n/* Desktop: the copy column is a flex column so the order above applies; \"How it helps\" is dropped */\n@media (min-width:990px){\n  html body .mc .mc__buy-copy{display:flex;flex-direction:column}\n  html body .mc .mc__buy-copy > .mc__buy-points{display:none}\n  html body .mc .mc__buy-copy > .mc__trust{margin-top:36px}\n  html body .mc .mc__buy-copy > .mc__buy-title{margin-top:20px}\n  html body .mc .mc__buy-copy > .mc-subhead{margin-top:18px}\n}\n/* Phones: the copy column dissolves into the page's column (as the left one already does), so the\n   images and testing button can sit between the subhead and the offer; headline centred */\n@media (max-width:989px){\n  html body .mc .mc__buy-grid{gap:0}\n  html body .mc .mc__buy-copy{display:contents}\n  html body .mc .mc__buy-copy > .mc__rating,html body .mc .mc__buy-copy > .mc__eyebrow,\n  html body .mc .mc__buy-copy > .mc__buy-title,html body .mc .mc__buy-copy > .mc-subhead{text-align:center}\n  html body .mc .mc__buy-copy > .mc__rating{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;margin-top:20px}\n  html body .mc .mc__buy-copy > .mc__buy-title{margin-top:16px}\n  html body .mc .mc__buy-copy > .mc-subhead{margin-top:12px}\n  html body .mc .mc__buy-media{order:1;margin:26px 0 22px}\n  html body .mc .mc__note{order:4}\n}\n</style>\n<style>\n/* Flat, alternating band grounds for this page (no gradient washes). Built by make_trust.py. */\n[id$=\"__statement\"],[id$=\"__statement\"] > .mc,[id$=\"__statement\"] > .mh{background:#ffffff!important}\n[id$=\"__board\"],[id$=\"__board\"] > .mc,[id$=\"__board\"] > .mh{background:#ffffff!important}\n[id$=\"__standards\"],[id$=\"__standards\"] > .mc,[id$=\"__standards\"] > .mh{background:#ffffff!important}\n[id$=\"__results\"],[id$=\"__results\"] > .mc,[id$=\"__results\"] > .mh{background:#f2f2f2!important}\n[id$=\"__quotes\"],[id$=\"__quotes\"] > .mc,[id$=\"__quotes\"] > .mh{background:#ffffff!important}\n[id$=\"__founder\"],[id$=\"__founder\"] > .mc,[id$=\"__founder\"] > .mh{background:#f2f2f2!important}\n[id$=\"__problem\"],[id$=\"__problem\"] > .mc,[id$=\"__problem\"] > .mh{background:#ffff