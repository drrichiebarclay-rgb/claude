    "sticky": {
      "type": "muto-home-sticky",
      "settings": {
        "product": "",
        "sticky_cta_label": "Add to cart",
        "sticky_label": "NAD+ Cellular Complex",
        "plan_cta_label": "",
        "cta_link": "",
        "sticky_sub": "Pause or stop any time",
        "schema_on": false
      }
    },
    "easy_read": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div id=\"mc-bf-data\" hidden data-left=\"{{ shop.metafields.muto.bf_boxes_left.value }}\" data-orders=\"{{ shop.metafields.muto.bf_orders_left.value }}\"></div>\n\n\n<script>\n/* \"Ingredients + nutritional information\" opens the What's inside fold and scrolls to it */\ndocument.addEventListener('click', function (e) {\n  var a = e.target.closest && e.target.closest('a[href=\"#whats-inside\"]');\n  if (!a) return;\n  var d = [].find.call(document.querySelectorAll('.mc__acc-item'), function (x) {\n    var s = x.querySelector('summary'); return s && /inside|ingredient/i.test(s.textContent);\n  });\n  if (!d) return;\n  e.preventDefault();\n  d.open = true;\n  d.scrollIntoView({ behavior: 'smooth', block: 'center' });\n});\n\n(function () {\n  var norm = function (t) { return (t || '').replace(/\\s+/g, '').replace(/\\/mo$/, ''); };\n  function cards() { return [].slice.call(document.querySelectorAll('.mc__plans > label.mc__plan')); }\n\n  /* The button shows the old price of whichever plan its price belongs to, struck through */\n  function syncWas() {\n    var price = document.querySelector('.mc__buy-cta [data-mh-cta-price]');\n    if (!price) return;\n    var now = norm(price.textContent);\n    var card = cards().find(function (c) {\n      var p = c.querySelector('.mc__plan-price'); return p && norm(p.textContent) === now;\n    }) || document.querySelector('.mc__plans > label.mc__plan.is-selected');\n    var was = card && card.querySelector('.mc__plan-was');\n    var s = price.parentNode.querySelector('.mc-art__cta-was');\n    if (!s) {\n      s = document.createElement('s');\n      s.className = 'mc-art__cta-was';\n      price.parentNode.insertBefore(s, price);\n    }\n    var t = was ? was.textContent.trim() : '';\n    if (s.textContent !== t) s.textContent = t;\n  }\n\n  /* Start on the quarterly plan (the second card in Skio's order) */\n  function selectQuarterly(tries) {\n    var c = cards()[1];\n    if (!c) return;\n    if (c.classList.contains('is-selected')) return;\n    var input = c.querySelector('.mc__plan-input');\n    if (input && input.disabled) return;\n    c.click();\n    if (input && !input.checked) { input.checked = true; input.dispatchEvent(new Event('change', { bubbles: true })); }\n    if (tries > 0) setTimeout(function () { selectQuarterly(tries - 1); }, 250);\n  }\n\n  function start() {\n    var price = document.querySelector('.mc__buy-cta [data-mh-cta-price]');\n    if (price && window.MutationObserver) {\n      new MutationObserver(syncWas).observe(price, { childList: true, characterData: true, subtree: true });\n    }\n    document.addEventListener('change', function () { setTimeout(syncWas, 0); });\n    document.addEventListener('click', function (e) {\n      if (e.target.closest && e.target.closest('.mc__plan')) setTimeout(syncWas, 0);\n    });\n    syncWas();\n    setTimeout(function () { selectQuarterly(4); setTimeout(syncWas, 50); }, 300);\n  }\n  if (document.readyState === 'complete') start(); else window.addEventListener('load', start);\n})();\n\n/* Clicking anywhere in a plan's gifts box selects that plan */\ndocument.addEventListener('click', function (e) {\n  var d = e.target.closest && e.target.closest('.mc__plans > .mc__plan-detail[data-mc-plan-for]');\n  if (!d || (e.target.closest && e.target.closest('a'))) return;\n  var n = parseInt(d.getAttribute('data-mc-plan-for'), 10);\n  var card = document.querySelectorAll('.mc__plans > label.mc__plan')[n - 1];\n  if (card && !card.classList.contains('is-selected')) card.click();\n});\n\n\n/* Black Friday: 53% off the first order plus the welcome kit, limited to TOTAL orders.\n   Orders left comes from the shop metafield muto.bf_orders_left (printed into #mc-bf-data by the\n   template); it must be the real number left. Blank hides the count. CODE, once set, is applied\n   automatically so it is on the cart and checkout. */\n(function () {\n  var CODE = \"\";\n  var TOTAL = 500;\n  if (CODE) {\n    try {\n      if (!sessionStorage.getItem('mcBf' + CODE)) {\n        fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' })\n          .then(function () { try { sessionStorage.setItem('mcBf' + CODE, '1'); } catch (e) {} });\n      }\n    } catch (e) {\n      fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' });\n    }\n  }\n  function mount() {\n    var plans = document.querySelector('.mc .mc__plans');\n    if (!plans || document.querySelector('.mc-bf')) return;\n    var data = document.getElementById('mc-bf-data');\n    var left = data ? parseInt(data.getAttribute('data-orders'), 10) : NaN;\n    var box = document.createElement('div');\n    box.className = 'mc-bf';\n    box.setAttribute('role', 'note');\n    var html =\n      '<p class=\"mc-bf__tag\"><span class=\"mc-bf__dot\"></span>Black Friday offer</p>' +\n      '<div class=\"mc-bf__main\"><p class=\"mc-bf__offer\">53% off your first order</p>' +\n      '<p class=\"mc-bf__kit\">plus a welcome kit worth £77</p>' +\n      '<p class=\"mc-bf__sched\">£99 for your first order, £125 on your second, £150 on your third.</p></div>';\n    var hasCount = left >= 0 && left <= TOTAL;\n    if (hasCount) {\n      html += '<p class=\"mc-bf__count\" aria-label=\"' + left + ' of ' + TOTAL + ' orders left\"><b>' + left +\n        '</b><small>of ' + TOTAL + ' left</small></p>';\n    }\n    html += '<div class=\"mc-bf__foot\">' +\n      (hasCount ? '<span class=\"mc-bf__bar\" aria-hidden=\"true\"><i style=\"width:' + Math.round(left / TOTAL * 100) + '%\"></i></span>' : '') +\n      '<p class=\"mc-bf__note\">' + (hasCount && left === 0 ? 'All ' + TOTAL + ' have gone.' : 'Limited to ' + TOTAL + ' orders.') +\n      (CODE ? ' Code <b>' + CODE + '</b> is applied at checkout.' : '') + '</p></div>';\n    box.innerHTML = html;\n    plans.parentNode.insertBefore(box, plans);\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount); else mount();\n})();\n\n/* Subhead under the title, and the testing-results button under the images. The button opens the\n   page's test-results panel (the tests section listens for [data-mtr-open]). */\n(function () {\n  var SUBHEAD = \"Our lowest price yet, while stocks last. Been waiting to try MUTO? Now’s the time to run the 90-day test.\";\n  var title = document.querySelector('.mc .mc__buy-title');\n  if (title && !document.querySelector('.mc-subhead')) {\n    var p = document.createElement('p');\n    p.className = 'mc-subhead';\n    p.textContent = SUBHEAD;\n    title.insertAdjacentElement('afterend', p);\n  }\n  var media = document.querySelector('.mc .mc__buy-media');\n  if (media && !media.querySelector('.mc-tests-btn') && document.querySelector('[data-mtr]')) {\n    var b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'mc-tests-btn';\n    b.setAttribute('data-mtr-open', '');\n    b.innerHTML = '<span class=\"mc-tests-btn__tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2.5 6.2 5 8.6l4.5-5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>View third-party testing results';\n    media.appendChild(b);\n  }\n})();\n\n/* Sticky bar: its button price follows the selected plan as Skio bills it (£150 / £60); show it per\n   month like the plan cards (plan-prices.css), old price struck through. Card 1 = monthly, 2 = quarterly. */\n(function () {\n  var PER_MONTH = { 1: ['£49.99/mo', '£70'], 2: ['£33/mo', '£70'] };\n  function update() {\n    var span = document.querySelector('.mh__sticky [data-mh-cta-price]');\n    if (!span) return;\n    var cards = [].slice.call(document.querySelectorAll('.mc__plans > label.mc__plan'));\n    var p = PER_MONTH[cards.findIndex(function (c) { return c.classList.contains('is-selected'); }) + 1];\n    if (!p) return;\n    var html = '<s class=\"mc-sticky-was\">' + p[1] + '</s> ' + p[0];\n    if (span.innerHTML !== html) span.innerHTML = html;\n  }\n  function start() {\n    var span = document.querySelector('.mh__sticky [data-mh-cta-price]');\n    if (span && window.MutationObserver) {\n      new MutationObserver(update).observe(span, { childList: true, characterData: true, subtree: true });\n    }\n    document.addEventListener('click', function (e) {\n      if (e.target.closest && e.target.closest('.mc__plan')) { setTimeout(update, 0); setTimeout(update, 60); }\n    });\n    document.addEventListener('change', function () { setTimeout(update, 0); });\n    document.addEventListener('muto:home:plan', update); /* fired by muto-home.js after it paints the price */\n    update();\n    setTimeout(update, 400);\n  }\n  if (document.readyState === 'complete') start(); else window.addEventListener('load', start);\n})();\n</script>",
