{%- comment -%}
  MUTO — Chapter.
  One idea per chapter, laid out the same way every time so the page is easy
  to scan: the chapter number above a heading, a short intro, an optional simple diagram, the chapter's blocks, a
  takeaway line and small print.

  BLOCKS sit on a 12-column grid by type: points two to a row, quotes three to
  a row, steps four to a row (a timeline), glossary terms two to a row, tables
  full width (optionally folded behind a + row). Cards (white, one per idea)
  and stats (big numbers) group into a row of their own; on phones cards swipe.

  Band "Charcoal" sets the chapter on #242223 with the quotes as outlined cards.
  "Diagram beside the blocks" puts the diagram left and the points right.
  Tables are typed one row per line, cells split with |, the first line being
  the header row.

  The Anchor is what the science hero's chapter links point to.
{%- endcomment -%}
{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = section.id
  assign s = section.settings
-%}
<style>
  /* Theme h1–h3 rules set their own font; headings here use the site's display face and weight */
  #shopify-section-{{ sid }} h1,#shopify-section-{{ sid }} h2,#shopify-section-{{ sid }} h3{font-family:var(--mc-font);font-weight:500;-webkit-font-smoothing:antialiased}
  #shopify-section-{{ sid }} .mch{--mch-bg:{% if s.tint %}#fff{% else %}var(--mc-ground){% endif %};background:var(--mch-bg);padding-top:{{ s.space_top }}px;padding-bottom:{{ s.space_bottom }}px}
  /* One column, full width: the number sits above the heading, and the bands alternate colour instead of ruling a line */
  #shopify-section-{{ sid }} .mch__grid{display:block}
  #shopify-section-{{ sid }} .mch__side{display:block;margin-bottom:20px}
  #shopify-section-{{ sid }} .mch__side:empty{display:none}
  #shopify-section-{{ sid }} .mch__num{font-family:var(--mc-mono);font-size:14px;letter-spacing:.08em;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .mch__label{font-size:17px;line-height:1.25;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__main{max-width:none}
  #shopify-section-{{ sid }} .mch__h{max-width:1100px}
  #shopify-section-{{ sid }} .mch__h{font-weight:500;font-size:clamp(34px,4.444vw,64px);line-height:.906;letter-spacing:-.014em;text-transform:uppercase;color:var(--mc-ink);margin:0;text-wrap:balance}
  #shopify-section-{{ sid }} .mch__intro{margin-top:24px;max-width:700px;font-size:20px;line-height:1.5;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__intro > * + *{margin-top:14px}
  #shopify-section-{{ sid }} .mch__intro ol,#shopify-section-{{ sid }} .mch__intro ul{padding-left:1.2em}
  #shopify-section-{{ sid }} .mch__intro li + li{margin-top:10px}
  #shopify-section-{{ sid }} .mch__art{margin-top:40px;max-width:720px;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__art svg{display:block;width:100%;height:auto}
  #shopify-section-{{ sid }} .mch__blocks{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:28px 24px;margin-top:44px}
  #shopify-section-{{ sid }} .mch__b--point{grid-column:span 6;padding-top:18px;border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--point:nth-child(3):last-child) .mch__b--point{grid-column:span 4}
  #shopify-section-{{ sid }} .mch__b--quote{grid-column:span 6;margin:0;padding-top:20px;border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__b--step{grid-column:span 3;padding-top:18px;border-top:1px solid var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__b--term{grid-column:span 6;padding:16px 0;border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__b--table{grid-column:1/-1;margin-top:20px}
  #shopify-section-{{ sid }} .mch__sum{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;cursor:pointer;list-style:none}
  #shopify-section-{{ sid }} .mch__sum::-webkit-details-marker{display:none}
  #shopify-section-{{ sid }} .mch__sum:focus-visible{outline:2px solid var(--mc-ink);outline-offset:4px;border-radius:4px}
  #shopify-section-{{ sid }} .mch__plus{flex:0 0 32px;width:32px;height:32px;margin-top:-2px;border-radius:50%;border:1px solid var(--mc-hair);position:relative;transition:transform var(--mc-dur) var(--mc-ease),background var(--mc-dur) var(--mc-ease)}
  #shopify-section-{{ sid }} .mch__plus::before,#shopify-section-{{ sid }} .mch__plus::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:1.5px;margin:-.75px 0 0 -6px;background:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__plus::after{transform:rotate(90deg)}
  #shopify-section-{{ sid }} details[open] > .mch__sum .mch__plus{transform:rotate(45deg)}
  #shopify-section-{{ sid }} .mch__sum:hover .mch__plus{background:var(--mc-sage)}
  #shopify-section-{{ sid }} .mch__bt{font-weight:500;font-size:21px;line-height:1.25;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__bx{margin-top:10px;max-width:60ch;font-size:17px;line-height:1.55;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__q{font-family:var(--mc-font);font-style:normal;font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.012em;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__sn{font-family:var(--mc-mono);font-size:13px;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .mch__table-h{margin:0 0 16px;font-weight:500;font-size:22px;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__scroll{overflow-x:auto}
  /* Classed so the theme's default table borders don't apply */
  #shopify-section-{{ sid }} .mch__t{width:100%;border-collapse:separate;border-spacing:0;border:0;box-shadow:none;table-layout:fixed;font-family:var(--mc-font);font-size:17px;line-height:1.45;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__t th,#shopify-section-{{ sid }} .mch__t td{padding:18px 20px;text-align:left;vertical-align:top;border:0;border-bottom:1px solid var(--mc-hair);background:none}
  #shopify-section-{{ sid }} .mch__t th:first-child,#shopify-section-{{ sid }} .mch__t td:first-child{padding-left:0}
  /* Column heads as on the product page's comparison: display face, caps, ink; MUTO as the wordmark */
  #shopify-section-{{ sid }} .mch__t thead th{padding-top:24px;padding-bottom:16px;vertical-align:bottom;font-family:var(--mc-font);font-weight:500;font-size:14px;line-height:1.2;letter-spacing:.02em;text-transform:uppercase;color:var(--mc-ink);border-bottom:1px solid var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__t tbody th{font-size:17px;line-height:1.3}
  /* Comparison: everything but the row names centred, under centred heads */
  #shopify-section-{{ sid }} .mch__wide .mch__t th:not(:first-child),#shopify-section-{{ sid }} .mch__wide .mch__t td{text-align:center}
  #shopify-section-{{ sid }} .mch__wide .mch__t td{vertical-align:middle}
  #shopify-section-{{ sid }} .mch__wide .mch__t{font-size:15px;line-height:1.3}
  #shopify-section-{{ sid }} .mch__wide .mch__t th,#shopify-section-{{ sid }} .mch__wide .mch__t td{padding:13px 14px}
  #shopify-section-{{ sid }} .mch__wide .mch__t th:first-child{padding-left:0}
  #shopify-section-{{ sid }} .mch__wide .mch__t tbody th{font-size:15px;line-height:1.3}
  #shopify-section-{{ sid }} .mch__wide .mch__t thead th{font-size:13px}
  #shopify-section-{{ sid }} .mch__wide .mch__t tbody th{vertical-align:middle}
  #shopify-section-{{ sid }} .mch__wide .mch__logo{margin:0 auto}
  #shopify-section-{{ sid }} .mch__logo{display:block;width:72px;height:auto;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__vh{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;padding:0}
  #shopify-section-{{ sid }} .mch__t tbody th{font-family:var(--mc-font);font-weight:500;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__t .is-us{background:var(--mc-sage);color:var(--mc-ink);font-weight:500;border-bottom-color:rgba(22,47,49,.1)}
  #shopify-section-{{ sid }} .mch__t thead .is-us{color:var(--mc-ink);border-radius:12px 12px 0 0;border-bottom-color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__t tbody tr:last-child .is-us{border-radius:0 0 12px 12px;border-bottom-color:transparent}
  #shopify-section-{{ sid }} .mch__wide-hint{display:none}
  #shopify-section-{{ sid }} .mch__rows{display:none}
  #shopify-section-{{ sid }} .mch__row{padding:18px 0;border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__row:last-child{border-bottom:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__row-body{margin:14px 0 0;display:grid;gap:4px}
  #shopify-section-{{ sid }} .mch__row-body dt{margin-top:8px;font-family:var(--mc-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .mch__row-body dt:first-child{margin-top:0}
  #shopify-section-{{ sid }} .mch__row-body dd{margin:0;font-size:16px;line-height:1.5;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__take{margin-top:48px;max-width:760px;font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.012em;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__line{margin-top:32px;max-width:700px;font-size:20px;line-height:1.5;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__small{margin-top:28px;max-width:820px;font-size:13px;line-height:1.5;color:var(--mc-muted)}
  /* The site's button (.mc__btn as in the benefits band): 64px tall, 8px corners */
  #shopify-section-{{ sid }} .mch__btn{display:inline-flex;align-items:center;gap:10px;width:auto;height:64px;margin-top:32px;padding:0 32px;border-radius:8px;font-size:16px;text-decoration:none}
  #shopify-section-{{ sid }} a:not(.mch__btn){color:inherit;text-decoration:underline;text-underline-offset:3px}
  /* Diagram beside the points rather than above them */
  #shopify-section-{{ sid }} .mch__duo{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:start;margin-top:48px}
  #shopify-section-{{ sid }} .mch__duo .mch__art{margin-top:0;padding:28px 28px 20px;background:#fff;border-radius:8px}
  #shopify-section-{{ sid }} .mch__duo .mch__art text{font-size:22px}
  #shopify-section-{{ sid }} .mch__duo .mch__blocks{display:block;margin-top:0}
  #shopify-section-{{ sid }} .mch__duo .mch__b--point{padding:22px 0}
  #shopify-section-{{ sid }} .mch__duo .mch__b--point:last-child{border-bottom:1px solid var(--mc-hair)}
  /* No heading: it carries on the section before it, so no rule above */
  #shopify-section-{{ sid }} .mch--cont{border-top:0}
  /* Mint band (#c8d2cf): white cards, darker small type */
  #shopify-section-{{ sid }} .mch--mint{--mch-bg:var(--mc-mint,#c8d2cf);--mc-hair:rgba(22,47,49,.18)}
  #shopify-section-{{ sid }} .mch--mint .mch__num,#shopify-section-{{ sid }} .mch--mint .mch__small,#shopify-section-{{ sid }} .mch--mint .mch__sk,#shopify-section-{{ sid }} .mch--mint .mch__wide-hint,#shopify-section-{{ sid }} .mch--mint .mch__row-body dt{color:rgba(22,47,49,.72)}
  #shopify-section-{{ sid }} .mch--mint .mch__intro,#shopify-section-{{ sid }} .mch--mint .mch__line,#shopify-section-{{ sid }} .mch--mint .mch__bx{color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch--mint .mch__t .is-us{background:#fff}
  #shopify-section-{{ sid }} .mch--mint .mch__b--quote,#shopify-section-{{ sid }} .mch--dark .mch__b--quote{grid-column:span 4;display:flex;flex-direction:column;justify-content:space-between;gap:40px;min-height:220px;padding:28px;border-radius:8px}
  #shopify-section-{{ sid }} .mch--mint .mch__b--quote{background:#fff;border:0}
  #shopify-section-{{ sid }} .mch--mint .mch__b--quote::after{content:"What people tell us";font-family:var(--mc-mono);font-weight:400;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .mch--mint .mch__plus{border-color:rgba(22,47,49,.3)}
  /* Dark band: the charcoal of the offer panel */
  #shopify-section-{{ sid }} .mch--dark{--mch-bg:var(--mc-ink-alt,#242223);border-top:0;color:#fff}
  #shopify-section-{{ sid }} .mch--dark .mch__h,#shopify-section-{{ sid }} .mch--dark .mch__q,#shopify-section-{{ sid }} .mch--dark .mch__take,#shopify-section-{{ sid }} .mch--dark .mch__bt{color:#fff}
  #shopify-section-{{ sid }} .mch--dark .mch__intro,#shopify-section-{{ sid }} .mch--dark .mch__line,#shopify-section-{{ sid }} .mch--dark .mch__bx{color:rgba(255,255,255,.78)}
  #shopify-section-{{ sid }} .mch--dark .mch__num{color:var(--mc-cyan)}
  #shopify-section-{{ sid }} .mch--dark .mch__b--quote{border:1px solid rgba(255,255,255,.2)}
  #shopify-section-{{ sid }} .mch--dark .mch__b--quote::after{content:"What people tell us";font-family:var(--mc-mono);font-weight:400;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  /* Stats: big numbers on one rule */
  #shopify-section-{{ sid }} .mch__stats{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;padding-top:24px;border-top:1px solid var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mch__sv{display:block;font-family:var(--mc-font);font-weight:500;font-size:clamp(40px,3.6vw,56px);line-height:.95;letter-spacing:-.02em;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__sl{display:block;margin-top:10px;font-size:15px;line-height:1.35;color:var(--mc-ink-alt)}
  /* Cards: one per job, as on the ingredients page */
  /* Cards keep their own height, so opening one doesn't stretch its row */
  #shopify-section-{{ sid }} .mch__cards{grid-column:1/-1;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;align-items:start}
  #shopify-section-{{ sid }} .mch__b--card{grid-column:span 2;display:flex;flex-direction:column;gap:14px;padding:28px;background:#fff;border-radius:8px}
  #shopify-section-{{ sid }} .mch__cards:has(> :nth-child(5):last-child) > :nth-child(n+4){grid-column:span 3}
  #shopify-section-{{ sid }} .mch__cards:has(> :nth-child(4):last-child) > *{grid-column:span 3}
  #shopify-section-{{ sid }} .mch__cn{display:flex;align-items:center;gap:8px;font-family:var(--mc-mono);font-size:13px;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .mch__cn::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--mc-cyan);box-shadow:0 0 0 1px var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__ct{margin:0;font-weight:500;font-size:clamp(26px,2.4vw,34px);line-height:1;letter-spacing:-.01em;text-transform:uppercase;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__cx{min-height:4.35em;font-size:17px;line-height:1.45;color:var(--mc-ink-alt)}
  /* What's in it: folded, + opens the list inside the card */
  #shopify-section-{{ sid }} .mch__ci{padding-top:14px;border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__ci .mch__sum{align-items:center}
  #shopify-section-{{ sid }} .mch__ci b{font-family:var(--mc-mono);font-weight:400;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__ci p{margin:12px 0 0;font-size:15px;line-height:1.5;color:var(--mc-ink-alt)}
  /* Timeline: one line, a dot per milestone */
  #shopify-section-{{ sid }} .mch__b--step{position:relative;padding:28px 24px 0 0;border-top:2px solid var(--mc-ink)}
  #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step){column-gap:0}
  /* Steps with photos: a photo card each instead of the timeline */
  #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step-img){column-gap:20px}
  #shopify-section-{{ sid }} .mch__b--step.mch__b--step-img{padding:0;border:0;margin:0}
  #shopify-section-{{ sid }} .mch__b--step.mch__b--step-img::before{display:none}
  #shopify-section-{{ sid }} .mch__simg{position:relative;aspect-ratio:4/3;margin-bottom:20px;border-radius:12px;overflow:hidden;background:var(--mc-mint)}
  #shopify-section-{{ sid }} .mch__simg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step:nth-child(3):last-child) .mch__b--step{grid-column:span 4}
  #shopify-section-{{ sid }} .mch__b--step::before{content:"";position:absolute;top:-9px;left:0;width:16px;height:16px;border-radius:50%;background:var(--mc-cyan);border:2px solid var(--mc-ink);box-sizing:border-box}
  #shopify-section-{{ sid }} .mch__sk{font-family:var(--mc-mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
  /* Table folded behind a + row */
  #shopify-section-{{ sid }} .mch__fold{padding:22px 0;border-top:1px solid var(--mc-hair);border-bottom:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .mch__fold[open] > .mch__sum{margin-bottom:8px}
  #shopify-section-{{ sid }} .mch__fold .mch__t tbody tr:last-child > *{border-bottom:0}
  @media (max-width:989px){
    #shopify-section-{{ sid }} .mch__duo{grid-template-columns:1fr;gap:28px}
    #shopify-section-{{ sid }} .mch--dark .mch__b--quote,#shopify-section-{{ sid }} .mch--mint .mch__b--quote{grid-column:1/-1;min-height:0;gap:20px}
    #shopify-section-{{ sid }} .mch__stats{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:28px}
    #shopify-section-{{ sid }} .mch__cards{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;margin:0 calc(-1 * var(--mc-gutter,20px));padding:0 var(--mc-gutter,20px) 4px;scroll-padding:0 var(--mc-gutter,20px);scrollbar-width:none}
    #shopify-section-{{ sid }} .mch__cards::-webkit-scrollbar{display:none}
    #shopify-section-{{ sid }} .mch__cards{align-items:flex-start}
    #shopify-section-{{ sid }} .mch__b--card{flex:0 0 min(78%,340px);scroll-snap-align:start;padding:24px}
  }
  @media (max-width:989px){
    #shopify-section-{{ sid }} .mch__grid{grid-template-columns:1fr;gap:20px}
    #shopify-section-{{ sid }} .mch__b--step{grid-column:span 6}
  }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .mch{padding-top:{{ s.space_top | times: 0.6 | round }}px;padding-bottom:{{ s.space_bottom | times: 0.6 | round }}px}
    #shopify-section-{{ sid }} .mch__intro,#shopify-section-{{ sid }} .mch__line{font-size:16px}
    #shopify-section-{{ sid }} .mch__bx,#shopify-section-{{ sid }} .mch__row-body dd{font-size:15px}
    #shopify-section-{{ sid }} .mch__h{font-size:30px}
    #shopify-section-{{ sid }} .mch__bt{font-size:18px}
    #shopify-section-{{ sid }} .mch__table-h{font-size:19px}
    #shopify-section-{{ sid }} .mch__small{font-size:12px}
    #shopify-section-{{ sid }} .mch__plus{flex-basis:28px;width:28px;height:28px}
    #shopify-section-{{ sid }} .mch__b--point,#shopify-section-{{ sid }} .mch__b--quote,#shopify-section-{{ sid }} .mch__b--term,#shopify-section-{{ sid }} .mch__b--step{grid-column:1/-1}
    #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--point:nth-child(3):last-child) .mch__b--point{grid-column:1/-1}
    #shopify-section-{{ sid }} .mch__q,#shopify-section-{{ sid }} .mch__take{font-size:18px}
    #shopify-section-{{ sid }} .mch__stack .mch__scroll{display:none}
    #shopify-section-{{ sid }} .mch__stack .mch__rows{display:block}
    #shopify-section-{{ sid }} .mch__stack .mch__t,#shopify-section-{{ sid }} .mch__stack tbody{display:block;width:100%;table-layout:auto}
    #shopify-section-{{ sid }} .mch__stack colgroup{display:none}
    #shopify-section-{{ sid }} .mch__stack .mch__t{font-size:16px}
    #shopify-section-{{ sid }} .mch__wide .mch__t{min-width:600px;font-size:13.5px;line-height:1.28}
    #shopify-section-{{ sid }} .mch__wide .mch__t th,#shopify-section-{{ sid }} .mch__wide .mch__t td{padding:11px 10px}
    #shopify-section-{{ sid }} .mch__wide .mch__t tbody th{font-size:13.5px}
    #shopify-section-{{ sid }} .mch__wide .mch__t thead th{font-size:11.5px}
    #shopify-section-{{ sid }} .mch__wide .mch__logo{width:56px}
    #shopify-section-{{ sid }} .mch__wide tbody th,#shopify-section-{{ sid }} .mch__wide thead th:first-child{position:sticky;left:0;z-index:1;min-width:120px;padding-right:10px;background:var(--mch-bg);box-shadow:1px 0 0 var(--mc-hair)}
    #shopify-section-{{ sid }} .mch__wide-hint{display:block;margin-top:10px;font-family:var(--mc-mono);font-size:12px;letter-spacing:.06em;color:var(--mc-muted)}
    #shopify-section-{{ sid }} .mch__stack thead{display:none}
    #shopify-section-{{ sid }} .mch__stack tr{display:block;padding:18px 0;border-bottom:1px solid var(--mc-hair)}
    #shopify-section-{{ sid }} .mch__stack th,#shopify-section-{{ sid }} .mch__stack td{display:block;padding:0;border:0}
    #shopify-section-{{ sid }} .mch__stack tbody th{font-size:19px;margin-bottom:10px}
    #shopify-section-{{ sid }} .mch__stack td + td{margin-top:10px}
    #shopify-section-{{ sid }} .mch__stack td::before{content:attr(data-label);display:block;margin-bottom:2px;font-family:var(--mc-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
    #shopify-section-{{ sid }} .mch__art text{font-size:22px}
    #shopify-section-{{ sid }} .mch__duo .mch__art{padding:20px 18px 14px}
    #shopify-section-{{ sid }} .mch__ct{font-size:24px}
    #shopify-section-{{ sid }} .mch__cx{font-size:15px}
    #shopify-section-{{ sid }} .mch__sl{font-size:14px}
    /* Timeline runs down the page on phones */
    #shopify-section-{{ sid }} .mch__b--step{padding:0 0 28px 28px;border-top:0;border-left:2px solid var(--mc-ink);margin-left:7px}
    #shopify-section-{{ sid }} .mch__b--step:last-of-type{border-left-color:transparent;padding-bottom:0}
    #shopify-section-{{ sid }} .mch__b--step::before{top:0;left:-9px}
    #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step){row-gap:0}
    #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step-img){row-gap:32px}
    #shopify-section-{{ sid }} .mch__b--step.mch__b--step-img{padding:0;border:0;margin:0}
    #shopify-section-{{ sid }} .mch__blocks:has(> .mch__b--step:nth-child(3):last-child) .mch__b--step{grid-column:1/-1}
  }
</style>

<div class="mc mch{% if s.band == 'dark' %} mch--dark{% elsif s.band == 'mint' %} mch--mint{% endif %}{% if s.heading == blank %} mch--cont{% endif %}" id="{{ s.anchor }}">
  <div class="mc__wrap mch__grid">
    <div class="mch__side">
      {%- if s.number != blank -%}<span class="mch__num">{{ s.number }}</span>{%- endif -%}
    </div>
    <div class="mch__main">
      {%- if s.heading != blank -%}<h2 class="mch__h">{{ s.heading | escape | newline_to_br }}</h2>{%- endif -%}
      {%- if s.intro != blank -%}<div class="mch__intro">{{ s.intro }}</div>{%- endif -%}

      {%- if s.art != 'none' and s.art_beside -%}<div class="mch__duo">{%- endif -%}
      {%- if s.art != 'none' -%}
        <div class="mch__art" aria-hidden="true">
          {%- case s.art -%}
            {%- when 'decline' -%}
              <svg viewBox="0 0 720 260" fill="none">
                <text x="0" y="16" fill="#7f9c9e" font-family="Sometype Mono, monospace" font-size="15" letter-spacing="1">NAD+ IN YOUR CELLS</text>
                <path d="M0 236H720" stroke="#242223" stroke-opacity=".3"/>
                <path d="M10 60 C 160 62, 240 66, 300 82 S 520 170, 710 206" stroke="#162f31" stroke-width="3" stroke-linecap="round"/>
                <path d="M300 82V236" stroke="#162f31" stroke-dasharray="4 6"/>
                <circle cx="300" cy="82" r="7" fill="#5efaff" stroke="#162f31" stroke-width="2"/>
                <text x="300" y="256" text-anchor="middle" fill="#162f31" font-family="Sometype Mono, monospace" font-size="17">35</text>
                <text x="710" y="256" text-anchor="end" fill="#7f9c9e" font-family="Sometype Mono, monospace" font-size="15" letter-spacing="1">AGE →</text>
              </svg>
            {%- when 'battery' -%}
              <svg viewBox="0 0 720 200" fill="none">
                {%- assign times = '8AM,12PM,3PM,8PM' | split: ',' -%}
                {%- assign fills = '100,72,38,16' | split: ',' -%}
                {%- for t in times -%}
                  {%- assign x = forloop.index0 | times: 180 | plus: 20 -%}
                  {%- assign w = fills[forloop.index0] | times: 1.16 -%}
                  <rect x="{{ x }}" y="40" width="130" height="70" rx="12" stroke="#162f31" stroke-width="3"/>
                  <rect x="{{ x | plus: 132 }}" y="62" width="8" height="26" rx="3" fill="#162f31"/>
                  <rect x="{{ x | plus: 7 }}" y="47" width="{{ w }}" height="56" rx="7" fill="{% if forloop.index0 < 2 %}#162f31{% else %}#7f9c9e{% endif %}"/>
                  <text x="{{ x | plus: 65 }}" y="150" text-anchor="middle" fill="#162f31" font-family="Sometype Mono, monospace" font-size="17" letter-spacing="1">{{ t }}</text>
                {%- endfor -%}
              </svg>
          {%- endcase -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="mch__blocks">
          {%- assign step_n = 0 -%}
          {%- assign grp = '' -%}
          {%- for block in section.blocks -%}
            {%- comment -%} Runs of cards or stats share a row of their own {%- endcomment -%}
            {%- if block.type == 'card' or block.type == 'stat' -%}{%- assign want = block.type -%}{%- else -%}{%- assign want = '' -%}{%- endif -%}
            {%- if want != grp -%}
              {%- if grp != '' -%}</div>{%- endif -%}
              {%- if want == 'card' -%}<div class="mch__cards">{%- elsif want == 'stat' -%}<div class="mch__stats">{%- endif -%}
              {%- assign grp = want -%}
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'card' -%}
                <article class="mch__b--card" {{ block.shopify_attributes }}>
                  {%- if block.settings.kicker != blank -%}<span class="mch__cn">{{ block.settings.kicker }}</span>{%- endif -%}
                  <h3 class="mch__ct">{{ block.settings.title }}</h3>
                  {%- if block.settings.text != blank -%}<p class="mch__cx">{{ block.settings.text }}</p>{%- endif -%}
                  {%- if block.settings.detail != blank -%}<details class="mch__ci"><summary class="mch__sum"><b>{{ block.settings.detail_label | default: 'What’s in it' }}</b><span class="mch__plus" aria-hidden="true"></span></summary><p>{{ block.settings.detail }}</p></details>{%- endif -%}
                </article>
              {%- when 'stat' -%}
                <p class="mch__b--stat" {{ block.shopify_attributes }}><span class="mch__sv">{{ block.settings.value }}</span><span class="mch__sl">{{ block.settings.label }}</span></p>
              {%- when 'point' -%}
                <details class="mch__b--point" data-mch-more {{ block.shopify_attributes }}>
                  <summary class="mch__sum"><span class="mch__bt">{{ block.settings.title }}</span><span class="mch__plus" aria-hidden="true"></span></summary>
                  <div class="mch__bx">{{ block.settings.text }}</div>
                </details>
              {%- when 'quote' -%}
                <p class="mch__b--quote mch__q" {{ block.shopify_attributes }}>“{{ block.settings.text }}”</p>
              {%- when 'step' -%}
                {%- assign step_n = step_n | plus: 1 -%}
                <div class="mch__b--step{% if block.settings.image != blank or block.settings.image_fallback != blank %} mch__b--step-img{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <div class="mch__simg">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '440,660,900', sizes: '(min-width: 990px) 30vw, 100vw', alt: '' }}</div>
                  {%- elsif block.settings.image_fallback != blank -%}
                    <div class="mch__simg"><img src="{{ block.settings.image_fallback }}" alt="" loading="lazy" width="900" height="675"></div>
                  {%- endif -%}
                  {%- if block.settings.kicker != blank -%}<span class="mch__sk">{{ block.settings.kicker }}</span>{%- else -%}<span class="mch__sn">{{ step_n | prepend: '0' | slice: -2, 2 }}</span>{%- endif -%}
                  <p class="mch__bt" style="margin-top:10px">{{ block.settings.title }}</p>
                  {%- if block.settings.text != blank -%}<div class="mch__bx">{{ block.settings.text }}</div>{%- endif -%}
                </div>
              {%- when 'term' -%}
                <details class="mch__b--term" {{ block.shopify_attributes }}>
                  <summary class="mch__sum"><span class="mch__bt">{{ block.settings.word }}</span><span class="mch__plus" aria-hidden="true"></span></summary>
                  <p class="mch__bx">{{ block.settings.meaning }}</p>
                </details>
              {%- when 'table' -%}
                {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                {%- assign us = block.settings.highlight | default: 0 -%}
                {%- assign head = '' -%}
                {%- for r in rows -%}{%- assign rs = r | strip -%}{%- if rs != blank -%}{%- assign head = rs | split: '|' -%}{%- break -%}{%- endif -%}{%- endfor -%}
                {%- if head.size > 3 -%}{%- assign tkind = 'mch__wide' -%}{%- else -%}{%- assign tkind = 'mch__stack' -%}{%- endif -%}
                <div class="mch__b--table {{ tkind }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.fold -%}
                    <details class="mch__fold"><summary class="mch__sum"><span class="mch__bt">{{ block.settings.heading }}</span><span class="mch__plus" aria-hidden="true"></span></summary>
                  {%- elsif block.settings.heading != blank -%}<h3 class="mch__table-h">{{ block.settings.heading }}</h3>{%- endif -%}
                  <div class="mch__scroll">
                    <table class="mch__t">
                      <colgroup>
                        {%- for h in head -%}
                          {%- if forloop.first -%}<col style="width:24%">
                          {%- elsif head.size == 3 and forloop.index == 2 -%}<col style="width:30%">
                          {%- elsif head.size == 3 -%}<col style="width:46%">
                          {%- else -%}<col>
                          {%- endif -%}
                        {%- endfor -%}
                      </colgroup>
                      {%- assign first = true -%}
                      {%- for r in rows -%}
                        {%- assign rs = r | strip -%}
                        {%- if rs == blank -%}{%- continue -%}{%- endif -%}
                        {%- assign cells = rs | split: '|' -%}
                        {%- if first -%}
                          <thead><tr>{%- for c in cells -%}{%- assign cs = c | strip -%}<th scope="col"{% if forloop.index == us %} class="is-us"{% endif %}>{%- if cs == 'MUTO' -%}<svg class="mch__logo" viewBox="0 0 227 62.215" width="78" height="22" aria-hidden="true" focusable="false" style="display:block;width:78px;height:auto;color:var(--mc-ink)"><path d="M 0.589 1.491 L 14.654 1.491 C 14.902 1.491 15.13 1.647 15.212 1.885 L 29.35 43.58 C 29.526 44.109 30.28 44.109 30.456 43.58 L 44.821 1.885 C 44.903 1.647 45.12 1.491 45.379 1.491 L 59.196 1.491 C 59.516 1.491 59.785 1.751 59.785 2.082 L 59.785 60.139 C 59.785 60.461 59.527 60.73 59.196 60.73 L 48.562 60.73 C 48.242 60.73 47.973 60.471 47.973 60.139 L 47.973 24.656 C 47.973 23.992 47.053 23.837 46.836 24.469 L 34.507 60.326 C 34.424 60.564 34.207 60.72 33.949 60.72 L 25.34 60.72 C 25.092 60.72 24.865 60.564 24.782 60.326 L 12.701 24.832 C 12.484 24.2 11.564 24.355 11.564 25.019 L 11.564 60.129 C 11.564 60.45 11.306 60.72 10.975 60.72 L 0.589 60.72 C 0.269 60.72 0 60.461 0 60.129 L 0 2.082 C 0 1.761 0.258 1.491 0.589 1.491 Z" fill="currentColor"/><path d="M 67.847 36.415 L 67.847 2.082 C 67.847 1.761 68.105 1.491 68.436 1.491 L 80.134 1.491 C 80.455 1.491 80.723 1.751 80.723 2.082 L 80.723 36.995 C 80.723 41.693 81.581 45.197 83.286 47.489 C 84.992 49.78 87.782 50.931 91.637 50.931 C 95.492 50.931 98.396 49.78 100.028 47.489 C 101.661 45.197 102.467 41.693 102.467 36.995 L 102.467 2.082 C 102.467 1.761 102.726 1.491 103.056 1.491 L 114.755 1.491 C 115.075 1.491 115.344 1.751 115.344 2.082 L 115.344 36.581 C 115.344 45.26 113.298 51.709 109.195 55.909 C 105.092 60.108 99.191 62.213 91.482 62.213 C 83.772 62.213 77.902 60.129 73.892 55.95 C 69.872 51.771 67.867 45.26 67.867 36.415 L 67.847 36.415 Z" fill="currentColor"/><path d="M 137.636 12.856 L 121.049 12.856 C 120.729 12.856 120.46 12.597 120.46 12.265 L 120.46 2.082 C 120.46 1.761 120.718 1.491 121.049 1.491 L 168.34 1.491 C 168.66 1.491 168.929 1.751 168.929 2.082 L 168.929 12.275 C 168.929 12.597 168.67 12.866 168.34 12.866 L 151.68 12.866 C 151.36 12.866 151.091 13.126 151.091 13.457 L 151.091 60.15 C 151.091 60.471 150.833 60.741 150.502 60.741 L 138.804 60.741 C 138.483 60.741 138.215 60.481 138.215 60.15 L 138.215 13.447 C 138.215 13.126 137.956 12.856 137.626 12.856 L 137.636 12.856 Z" fill="currentColor"/><path d="M 170.966 31.273 C 170.966 24.637 172.124 18.986 174.428 14.309 C 176.733 9.633 180.009 6.087 184.246 3.65 C 188.483 1.213 193.444 0 199.148 0 C 204.853 0 209.793 1.203 213.968 3.608 C 218.143 6.014 221.368 9.508 223.621 14.102 C 225.874 18.696 227 24.274 227 30.859 C 227 37.443 225.863 43.146 223.579 47.822 C 221.295 52.499 218.071 56.066 213.885 58.523 C 209.7 60.981 204.708 62.215 198.9 62.215 C 193.092 62.215 188.256 61.012 184.081 58.606 C 179.895 56.201 176.671 52.706 174.387 48.113 C 172.103 43.519 170.966 37.91 170.966 31.273 Z M 184.329 31.107 C 184.329 37.298 185.548 42.151 187.998 45.666 C 190.436 49.181 194.105 50.933 198.993 50.933 C 203.882 50.933 207.478 49.181 209.948 45.666 C 212.418 42.151 213.648 37.298 213.648 31.107 C 213.648 24.917 212.418 20.064 209.948 16.549 C 207.478 13.034 203.83 11.282 198.993 11.282 C 194.157 11.282 190.436 13.034 187.998 16.549 C 185.559 20.064 184.329 24.917 184.329 31.107 Z" fill="currentColor"/></svg><span class="mch__vh">MUTO</span>{%- else -%}{{ cs }}{%- endif -%}</th>{%- endfor -%}</tr></thead><tbody>
                          {%- assign first = false -%}
                        {%- else -%}
                          <tr>{%- for c in cells -%}{%- if forloop.first -%}<th scope="row">{{ c | strip }}</th>{%- else -%}<td data-label="{{ head[forloop.index0] | strip | escape }}"{% if forloop.index == us %} class="is-us"{% endif %}>{{ c | strip }}</td>{%- endif -%}{%- endfor -%}</tr>
                        {%- endif -%}
                      {%- endfor -%}
                      </tbody>
                    </table>
                  </div>
                  {%- if tkind == 'mch__wide' -%}<span class="mch__wide-hint">Swipe to compare →</span>{%- endif -%}
                  {%- if tkind == 'mch__stack' -%}
                    {%- comment -%} Phones: the same rows as the points, name first, + to open {%- endcomment -%}
                    <div class="mch__rows">
                      {%- assign first = true -%}
                      {%- for r in rows -%}
                        {%- assign rs = r | strip -%}
                        {%- if rs == blank -%}{%- continue -%}{%- endif -%}
                        {%- if first -%}{%- assign first = false -%}{%- continue -%}{%- endif -%}
                        {%- assign cells = rs | split: '|' -%}
                        <details class="mch__row">
                          <summary class="mch__sum"><span class="mch__bt">{{ cells[0] | strip }}</span><span class="mch__plus" aria-hidden="true"></span></summary>
                          <dl class="mch__row-body">
                            {%- for c in cells offset: 1 -%}
                              <dt>{{ head[forloop.index] | strip }}</dt><dd>{{ c | strip }}</dd>
                            {%- endfor -%}
                          </dl>
                        </details>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.note != blank -%}<p class="mch__small" style="margin-top:14px">{{ block.settings.note }}</p>{%- endif -%}
                  {%- if block.settings.fold -%}</details>{%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
          {%- if grp != '' -%}</div>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.art != 'none' and s.art_beside -%}</div>{%- endif -%}

      {%- if s.takeaway != blank -%}<p class="mch__take">{{ s.takeaway }}</p>{%- endif -%}
      {%- if s.line != blank -%}<div class="mch__line">{{ s.line }}</div>{%- endif -%}
      {%- if s.cta_label != blank -%}<a class="mc__btn mc__btn--cyan mch__btn" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
      {%- if s.small != blank -%}<div class="mch__small">{{ s.small }}</div>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MUTO — Chapter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Used by the chapter links, e.g. what-changes" },
    { "type": "text", "id": "number", "label": "Chapter number", "info": "e.g. 01" },
    { "type": "text", "id": "label", "label": "Chapter name", "info": "For your reference; the page shows only the number and the heading." },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "select", "id": "art", "label": "Diagram", "default": "none", "options": [
      { "value": "none", "label": "None" },
      { "value": "decline", "label": "Gentle decline, marked at 35" },
      { "value": "battery", "label": "Battery draining across the day" }
    ] },
    { "type": "checkbox", "id": "art_beside", "label": "Diagram beside the blocks", "default": false },
    { "type": "text", "id": "takeaway", "label": "Takeaway line" },
    { "type": "richtext", "id": "line", "label": "Line after the blocks" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "richtext", "id": "small", "label": "Small print" },
    { "type": "checkbox", "id": "tint", "label": "White background", "default": false },
    { "type": "select", "id": "band", "label": "Band", "default": "ground", "options": [
      { "value": "ground", "label": "Page background (#fafafa)" },
      { "value": "mint", "label": "Mint (#c8d2cf)" },
      { "value": "dark", "label": "Charcoal (#242223)" }
    ] },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] },
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "text", "id": "text", "label": "Quote (what people tell us)" }
    ] },
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional. With photos, the steps show as photo cards instead of a timeline." },
      { "type": "text", "id": "image_fallback", "label": "Photo URL (if no photo picked)" },
      { "type": "text", "id": "kicker", "label": "Label above", "info": "e.g. Day 30. Blank shows the step number." },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] },
    { "type": "term", "name": "Glossary term", "settings": [
      { "type": "text", "id": "word", "label": "Word" },
      { "type": "textarea", "id": "meaning", "label": "What it means" }
    ] },
    { "type": "table", "name": "Table", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "textarea", "id": "rows", "label": "Rows", "info": "One row per line, cells split with |. The first line is the header row." },
      { "type": "number", "id": "highlight", "label": "Highlight column (e.g. 2 for MUTO)", "info": "0 for none" },
      { "type": "text", "id": "note", "label": "Footnote" },
      { "type": "checkbox", "id": "fold", "label": "Fold behind its heading (+ to open)", "default": false }
    ] },
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "kicker", "label": "Label", "info": "e.g. 01" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "detail_label", "label": "Detail label", "default": "What’s in it" },
      { "type": "textarea", "id": "detail", "label": "Detail" }
    ] },
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "value", "label": "Number", "info": "e.g. 300mg" },
      { "type": "text", "id": "label", "label": "What it is" }
    ] }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "MUTO — Chapter" }],
  "enabled_on": { "templates": ["page", "product"] }
}
{% endschema %}
