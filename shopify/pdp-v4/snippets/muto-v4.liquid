{%- comment -%}
  MUTO — product page v4 (muto-v4). Loaded only by templates/product.muto-nad-v4.json, on top of everything the main
  product page already loads. From the Nov 2026 audit (91% of visits on phones, 1.3% of them add to cart):
  1. Phones: the plan cards and Add to cart come straight after the headline and intro; the reviews box, proof line
     and the testing / nutrition links move below the button.
  2. Phones: the "Includes: NAD+ Cellular Complex (x3)" row is dropped (the plan name says it) so the button is higher.
  3. Phones: the bottom bar shows whenever the page's own Add to cart is off screen, above or below it.
  4. The dark band keeps its headline and line; its four cards (repeated by "What it does" just below) are dropped.
  5. Phones: the ingredient library shows 6 of 19 with a "Show all 19 ingredients" button.
{%- endcomment -%}
<style>
  @media (max-width:749px){
    html:root body #MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__buy-copy > .mc-subhead{order:3!important;margin-top:20px!important}
    html:root body #MainContent#MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__buy-copy > .mc-links{order:3!important;margin:14px 0 4px!important}
    html:root body #MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__buy-copy > .mc__eyebrow{margin-top:18px!important}
    html:root body #MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__buy-copy > .mc__plans{margin-top:18px!important}
    html:root body #MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__kit > .mc__kit-title,
    html:root body #MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__kit > .mc__inc{display:none!important}
    html:root body #MainContent#MainContent [id$="__library"] .mil__grid.v4-clip > li:nth-child(n+7){display:none!important}
  }
  .v4-more{display:none}
  @media (max-width:749px){
    .v4-more{display:block;width:100%;margin:18px 0 0;padding:15px 18px;border:1px solid #242223;border-radius:8px;background:#fff;color:#242223;font-family:var(--mc-font,"Neue Haas Grotesk Display Pro"),sans-serif;font-size:15.5px;font-weight:500;line-height:1.2;text-align:center;cursor:pointer}
    .v4-more[hidden]{display:none}
  }
  html:root body .mc-jobs .mc-jobs__grid{display:none!important}
  html:root body .mc-jobs .mc-jobs__in{padding-bottom:64px}
  @media (max-width:749px){html:root body .mc-jobs .mc-jobs__in{padding-bottom:44px}}
</style>
<script>
(function () {
  function lib() {
    var grid = document.querySelector('#MainContent [id$="__library"] .mil__grid');
    if (!grid || grid.getAttribute('data-v4')) return !!grid;
    grid.setAttribute('data-v4', '1');
    var n = grid.children.length;
    if (n < 8) return true;
    grid.classList.add('v4-clip');
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'v4-more'; b.textContent = 'Show all ' + n + ' ingredients';
    grid.parentNode.insertBefore(b, grid.nextSibling);
    var open = function () { grid.classList.remove('v4-clip'); b.hidden = true; };
    b.addEventListener('click', open);
    [].forEach.call(document.querySelectorAll('#MainContent [id$="__library"] .mil__filter'), function (f) { f.addEventListener('click', open); });
    return true;
  }
  /* The bottom bar on phones: on whenever the page's own Add to cart is off screen (the bar's own script only turns it
     on after the button has been scrolled past) */
  function bar() {
    var sb = document.getElementById('mc-sbar'), cta = document.querySelector('#MainContent .mc__buy-cta');
    if (!sb || !cta || sb.getAttribute('data-v4')) return !!(sb && cta);
    sb.setAttribute('data-v4', '1');
    var mq = window.matchMedia('(max-width: 749px)'), t;
    var set = function () {
      if (!mq.matches) return;
      var r = cta.getBoundingClientRect(), off = r.bottom < 0 || r.top > window.innerHeight;
      var on = off && window.scrollY > 120;
      if (on === sb.classList.contains('is-visible')) return;
      sb.classList.toggle('is-visible', on);
      sb.setAttribute('aria-hidden', on ? 'false' : 'true');
      if ('inert' in sb) sb.inert = !on;
    };
    var later = function () { clearTimeout(t); t = setTimeout(set, 60); };
    window.addEventListener('scroll', later, { passive: true });
    window.addEventListener('resize', later);
    later();
    return true;
  }
  function run() { var a = lib(), b = bar(); return a && b; }
  if (!run()) document.addEventListener('DOMContentLoaded', function () { run(); setTimeout(run, 1500); });
})();
</script>
