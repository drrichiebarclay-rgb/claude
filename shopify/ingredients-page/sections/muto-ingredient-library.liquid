{%- comment -%}
  MUTO — Ingredient library.

  A filterable grid of the formula's ingredients. Clicking a card opens a
  detail drawer (from the right on desktop, a bottom sheet on phones) with
  the dose, what it supports and why this form and dose. Previous / Next step
  through the ingredients in the current filter.

  BLOCKS, one per ingredient. Tags are a comma list; a tag that matches one of
  the section's filters is filterable, any other tag (e.g. Absorption) still
  shows on the card. Until an ingredient has a photo, its tile is a powder
  texture drawn in the browser from the block's colour and pattern, so the
  page works before the photography exists. Upload a photo and it replaces
  the drawing.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign filters = section.settings.filters | split: ','
  assign ings = section.blocks | where: 'type', 'ingredient'
  assign cats = section.blocks | where: 'type', 'category'
-%}

{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ sid }}{--mil-ink:#242223;--mil-muted:#5c5a5b;--mil-rule:rgba(36,34,35,.14);--mil-tile:#f1f1ef;--mil-accent:#2f8fa0;--mil-panel:#f4f5f4;--mil-pill:#e3f4f6;--mil-pill-fg:#1f6f7c;--mil-mono:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace}
  .mil{background:{{ section.settings.bg }};color:var(--mil-ink)}
  /* Brand faces throughout: Neue Haas Grotesk Display for text, Sometype Mono for labels; the theme's own fonts and bold weights don't apply */
  .mil,.mil-d,.mil button,.mil-d button,.mil h1,.mil h2,.mil h3,.mil-d h2,.mil-d h3{font-family:var(--mc-font,"Neue Haas Grotesk Display Pro"),sans-serif;-webkit-font-smoothing:antialiased}
  .mil b,.mil strong,.mil-d b,.mil-d strong{font-weight:500}
  .mil__wrap{max-width:1320px;margin:0 auto;padding:{{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px}
  .mil__head{display:grid;justify-items:center;text-align:center;gap:20px}
  .mil__eyebrow{font-family:var(--mil-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mil-muted);margin:0}
  /* The site's section heading (.mc .mc__h2 / .mh .mh__h2, e.g. "Shop the protocol"). Its size is
     scoped to .mc, which this section isn't inside, so the values are repeated here. */
  .mil .mil__h{margin:0;text-wrap:balance;font-family:var(--mc-font);color:var(--mc-ink);-webkit-font-smoothing:antialiased;
    font-weight:500;font-size:clamp(34px,4.444vw,64px);line-height:.906;letter-spacing:-.014em;text-transform:uppercase}
  .mil__lede{margin:0;max-width:44ch;font-size:clamp(17px,1.4vw,20px);line-height:1.4;text-wrap:balance}
  .mil__filters{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:40px 0 44px}
  .mil__filter{font:inherit;font-size:16px;font-weight:500;line-height:1;padding:15px 24px;border-radius:6px;border:1px solid var(--mil-rule);background:#fff;color:var(--mil-ink);cursor:pointer;display:inline-flex;gap:10px;align-items:center;transition:background .2s,color .2s,border-color .2s}
  .mil__filter:hover{border-color:var(--mil-ink)}
  .mil__filter[aria-pressed="true"]{background:var(--mil-ink);color:#fff;border-color:var(--mil-ink)}
  .mil__filter .n{font-family:var(--mil-mono);font-size:12px;opacity:.6}
  .mil button:focus-visible,.mil-d button:focus-visible{outline:2px solid var(--mil-accent);outline-offset:3px}
  .mil__cats{margin:0 0 56px}
  .mil__cat{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,340px);gap:48px;align-items:start}
  .mil__cat[hidden]{display:none}
  .mil__cat-text{margin:0;font-weight:500;font-size:clamp(24px,2.6vw,40px);line-height:1.15;letter-spacing:-.015em;color:var(--mil-ink)}
  .mil__cat-btn{display:inline-flex;align-items:center;margin-top:32px;min-height:56px;padding:0 28px;border-radius:28px;background:var(--mil-ink);color:#fff;font-size:17px;font-weight:500;text-decoration:none}
  .mil__cat-btn:hover{opacity:.9}
  .mil__cat-label{margin:6px 0 16px;font-family:var(--mil-mono);font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--mil-ink)}
  .mil__cat-sup ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
  .mil__cat-sup li{font-size:clamp(20px,1.8vw,26px);line-height:1.2;letter-spacing:-.01em;color:var(--mil-ink)}
  .mil__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 28px;margin:0;padding:0;list-style:none}
  .mil__card{min-width:0;margin:0}
  .mil__card[hidden]{display:none}
  .mil__open{all:unset;display:grid;gap:14px;width:100%;cursor:pointer;box-sizing:border-box;color:var(--mil-ink)}
  .mil__open:focus-visible{outline:2px solid var(--mil-accent);outline-offset:6px;border-radius:4px}
  .mil__frame{position:relative;display:block;aspect-ratio:1/1;border-radius:4px;overflow:hidden;background:var(--mil-tile)}
  .mil__frame canvas,.mil__frame img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;transition:transform .5s ease}
  .mil__open:hover canvas,.mil__open:hover img{transform:scale(1.04)}
  .mil__tags{position:absolute;left:14px;top:14px;display:grid;gap:8px;justify-items:start;z-index:2}
  .mil__tag{font-family:var(--mil-mono);font-size:11.5px;line-height:1;font-weight:500;letter-spacing:.12em;text-transform:uppercase;padding:9px 12px;border-radius:4px;background:rgba(255,255,255,.92);color:var(--mil-ink)}
  .mil__plus{position:absolute;right:14px;top:14px;z-index:3;width:40px;height:40px;border-radius:50%;background:#fff;color:var(--mil-ink);display:grid;place-items:center;box-shadow:0 1px 3px rgba(0,0,0,.12);transition:transform .25s}
  .mil__open:hover .mil__plus{transform:rotate(90deg)}
  .mil__plus svg{width:14px;height:14px}
  .mil__name{font-weight:500;font-size:21px;line-height:1.2;letter-spacing:-.01em}
  .mil__dose{font-family:var(--mil-mono);font-size:15px;line-height:1;font-weight:500;color:var(--mil-accent);margin-top:-6px}
  .mil__foot{margin:56px auto 0;max-width:62ch;text-align:center;color:var(--mil-muted);font-size:14px}

  /* Drawer: moved to <body> by the script so the theme's header and transforms can't trap it */
  .mil-scrim{position:fixed;inset:0;background:rgba(36,34,35,.45);z-index:2147483000;opacity:0;transition:opacity .3s}
  .mil-scrim.on{opacity:1}
  .mil-d{position:fixed;z-index:2147483001;top:0;right:0;bottom:0;width:min(640px,100%);background:#fff;color:var(--mil-ink,#242223);
    display:flex;flex-direction:column;overflow-y:auto;overscroll-behavior:contain;
    transform:translateX(100%);transition:transform .38s cubic-bezier(.2,.8,.2,1);box-shadow:-24px 0 60px rgba(0,0,0,.18);padding-bottom:env(safe-area-inset-bottom,0px)}
  .mil-d.on{transform:none}
  .mil-d[hidden],.mil-scrim[hidden]{display:none}
  .mil-d__media{position:relative;flex:0 0 auto;aspect-ratio:3/2;background:#f1f1ef;overflow:hidden}
  .mil-d__media canvas,.mil-d__media img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover}
  .mil-d__close{position:absolute;top:18px;right:18px;width:52px;height:52px;border-radius:50%;border:1px solid rgba(36,34,35,.15);background:rgba(255,255,255,.9);color:#242223;cursor:pointer;display:grid;place-items:center;z-index:2;padding:0}
  .mil-d__close svg{width:18px;height:18px}
  .mil-d__grab{display:none}
  .mil-d__body{padding:32px clamp(20px,5vw,44px) 28px;display:grid;gap:24px;flex:1 0 auto}
  .mil-d__pills{display:flex;flex-wrap:wrap;gap:8px}
  .mil-d__pill{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:13px;line-height:1;font-weight:500;letter-spacing:.12em;text-transform:uppercase;padding:10px 14px;border-radius:6px;background:#e3f4f6;color:#1f6f7c}
  .mil-d__name{font-family:var(--mc-font);font-weight:500;-webkit-font-smoothing:antialiased;font-size:clamp(28px,3vw,38px);line-height:1.1;letter-spacing:-.02em;margin:0;padding-bottom:18px;border-bottom:1px solid rgba(36,34,35,.14);text-wrap:balance;color:#242223}
  .mil-d__desc{margin:0;font-size:18px;line-height:1.6}
  .mil-d__facts{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .mil-d__fact{background:#f4f5f4;border-radius:8px;padding:20px 22px;display:grid;gap:10px;align-content:start;min-width:0}
  .mil-d__label{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:12.5px;line-height:1.2;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:#5c5a5b;margin:0}
  .mil-d__val{font-weight:500;font-size:19px;line-height:1.35;margin:0}
  .mil-d__why{display:grid;gap:10px}
  .mil-d__why p:last-child{margin:0;font-size:16.5px;line-height:1.65}
  .mil-d__refs{display:grid;gap:14px;padding-top:24px;border-top:1px solid rgba(36,34,35,.14)}
  .mil-d__refs[hidden]{display:none}
  .mil-d__refs ul{margin:0;padding:0;list-style:none;display:grid;gap:12px}
  .mil-d__refs li{margin:0;padding-left:16px;border-left:3px solid #e3e6e5;font-size:15px;line-height:1.5;color:#5c5a5b}
  .mil-d__nav{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;margin-top:8px;padding-top:24px;border-top:1px solid rgba(36,34,35,.14)}
  .mil-d__nav button{font:inherit;font-size:16px;font-weight:500;line-height:1;padding:17px 28px;border-radius:6px;border:1px solid rgba(36,34,35,.14);background:#fff;color:#242223;cursor:pointer}
  .mil-d__nav button:hover:not(:disabled){border-color:#242223}
  .mil-d__nav button:disabled{opacity:.35;cursor:default}
  .mil-d__count{text-align:center;font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:14px;color:#5c5a5b}
  html.mil-locked,html.mil-locked body{overflow:hidden}

  @media (max-width:1080px){.mil__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media (max-width:820px){.mil__cat{grid-template-columns:1fr;gap:24px}.mil__cats{margin-bottom:40px}.mil__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 16px}.mil__name{font-size:18px}}
  @media (max-width:700px){
    .mil-d{top:auto;left:0;width:100%;height:calc(100% - 64px);border-radius:22px 22px 0 0;transform:translateY(100%);box-shadow:0 -20px 50px rgba(0,0,0,.2)}
    .mil-d__grab{display:block;position:absolute;top:10px;left:50%;width:44px;height:5px;margin-left:-22px;border-radius:3px;background:rgba(36,34,35,.25);z-index:2}
    .mil-d__media{aspect-ratio:4/3}
    .mil-d__close{width:46px;height:46px}
    .mil-d__desc{font-size:17px}
    .mil-d__facts{gap:10px}
    .mil-d__fact{padding:16px}
    .mil-d__val{font-size:17px}
    .mil-d__nav button{padding:15px 20px}
  }
  @media (max-width:480px){
    .mil__wrap{padding-top:{{ section.settings.pad_top | times: 0.66 | round }}px;padding-left:16px;padding-right:16px}
    .mil__filters{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;margin:28px -16px 32px;padding:0 16px 4px;scrollbar-width:none}
    .mil__filter{flex:0 0 auto;padding:13px 18px}
    .mil__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 14px}
    .mil__open{gap:12px}
    .mil__tags{left:8px;top:8px;gap:5px}
    .mil__tag{font-size:10px;padding:6px 8px;letter-spacing:.1em}
    .mil__plus{width:32px;height:32px;right:8px;top:8px}
    .mil__plus svg{width:12px;height:12px}
    .mil__name{font-size:16px;line-height:1.25}
    .mil__dose{font-size:13px;margin-top:-6px}
  }
  @media (prefers-reduced-motion:reduce){.mil *,.mil-d,.mil-scrim{transition:none!important}}
</style>

<div class="mil" data-mil="{{ sid }}">
  <div class="mil__wrap">
    <header class="mil__head">
      {%- if section.settings.eyebrow != blank -%}<p class="mil__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- assign htag = section.settings.heading_tag | default: 'h1' -%}<{{ htag }} class="mc__h2 mil__h">{{ section.settings.heading }}</{{ htag }}>
      {%- if section.settings.lede != blank -%}<p class="mil__lede">{{ section.settings.lede }}</p>{%- endif -%}
      {%- comment -%} Opens the "MUTO — Test results" panel on the same page {%- endcomment -%}
      {%- if section.settings.tests_label != blank -%}<button type="button" class="mtr-btn" data-mtr-open><span class="mtr-btn__tick"><svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.2 5 8.6l4.5-5" stroke="#162f31" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{{ section.settings.tests_label }}</button>{%- endif -%}
    </header>

    <div class="mil__filters" role="group" aria-label="Filter ingredients">
      <button type="button" class="mil__filter" data-f="All" aria-pressed="true">All<span class="n">{{ ings.size }}</span></button>
      {%- for f in filters -%}
        {%- assign fs = f | strip -%}
        {%- assign count = 0 -%}
        {%- for block in ings -%}
          {%- assign tl = block.settings.tags | split: ',' -%}
          {%- for t in tl -%}{%- assign ts = t | strip -%}{%- if ts == fs -%}{%- assign count = count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- endfor -%}
        <button type="button" class="mil__filter" data-f="{{ fs | escape }}" aria-pressed="false">{{ fs }}<span class="n">{{ count }}</span></button>
      {%- endfor -%}
    </div>

    {%- if cats.size > 0 -%}
      <div class="mil__cats">
        {%- for block in cats -%}
          {%- assign sup = block.settings.supports | newline_to_br | split: '<br />' -%}
          <div class="mil__cat" data-cat="{{ block.settings.name | strip | escape }}"{% unless block.settings.name == 'All' %} hidden{% endunless %} {{ block.shopify_attributes }}>
            <div class="mil__cat-main">
              <p class="mil__cat-text">{{ block.settings.text }}</p>
              {%- if section.settings.cta_label != blank -%}<a class="mil__cat-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>{%- endif -%}
            </div>
            {%- if block.settings.supports != blank -%}
              <div class="mil__cat-sup">
                <p class="mil__cat-label">{{ section.settings.supports_label }}</p>
                <ul>{%- for x in sup -%}{%- assign xs = x | strip -%}{%- if xs != blank -%}<li>— {{ xs }}</li>{%- endif -%}{%- endfor -%}</ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <ul class="mil__grid">
      {%- for block in ings -%}
        {%- assign tl = block.settings.tags | split: ',' -%}
        <li class="mil__card" data-tags="{% for t in tl %}|{{ t | strip | escape }}{% endfor %}|" data-i="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <button class="mil__open" type="button" aria-haspopup="dialog" aria-label="{{ block.settings.name | escape }}, {{ block.settings.dose | escape }}. More about this ingredient">
            <span class="mil__frame">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 1080px) 25vw, (min-width: 820px) 33vw, (min-width: 480px) 50vw, 100vw', alt: '' }}
              {%- else -%}
                <canvas aria-hidden="true"></canvas>
              {%- endif -%}
              <span class="mil__tags">
                {%- for t in tl -%}<span class="mil__tag">{{ t | strip }}</span>{%- endfor -%}
              </span>
              <span class="mil__plus" aria-hidden="true"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 1v12M1 7h12"/></svg></span>
            </span>
            <span class="mil__name">{{ block.settings.name }}</span>
            <span class="mil__dose">{{ block.settings.dose }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.foot != blank -%}<p class="mil__foot">{{ section.settings.foot }}</p>{%- endif -%}
  </div>

  <script type="application/json" data-mil-data>
    [
      {%- for block in ings -%}
        {
          "n": {{ block.settings.name | json }},
          "d": {{ block.settings.dose | json }},
          "t": {{ block.settings.tags | split: ',' | json }},
          "c": {{ block.settings.colour | json }},
          "p": {{ block.settings.pattern | json }},
          "img": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1280 | json }}{% else %}null{% endif %},
          "w": {{ block.settings.description | json }},
          "s": {{ block.settings.supports | json }},
          "y": {{ block.settings.why | json }},
          "r": {{ block.settings.refs | newline_to_br | split: '<br />' | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <div class="mil-scrim" data-mil-scrim hidden></div>
  <aside class="mil-d" data-mil-drawer role="dialog" aria-modal="true" aria-labelledby="mil-d-name-{{ sid }}" hidden>
    <div class="mil-d__media" data-mil-media>
      <span class="mil-d__grab" aria-hidden="true"></span>
      <button class="mil-d__close" type="button" data-mil-close aria-label="Close"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15"/></svg></button>
    </div>
    <div class="mil-d__body">
      <div class="mil-d__pills" data-mil-pills></div>
      <h2 class="mil-d__name" id="mil-d-name-{{ sid }}" data-mil-name></h2>
      <p class="mil-d__desc" data-mil-desc></p>
      <div class="mil-d__facts">
        <div class="mil-d__fact"><p class="mil-d__label">Dose per serve</p><p class="mil-d__val" data-mil-dose></p></div>
        <div class="mil-d__fact"><p class="mil-d__label">Supports</p><p class="mil-d__val" data-mil-sup></p></div>
      </div>
      <div class="mil-d__why"><p class="mil-d__label">Why this form &amp; dose</p><p data-mil-why></p></div>
      <div class="mil-d__refs" data-mil-refs-wrap><p class="mil-d__label">Key references</p><ul data-mil-refs></ul></div>
      <nav class="mil-d__nav" aria-label="Ingredients">
        <button type="button" data-mil-prev>Previous</button>
        <span class="mil-d__count" data-mil-count aria-live="polite"></span>
        <button type="button" data-mil-next>Next</button>
      </nav>
    </div>
  </aside>
</div>

<script>
(function () {
  /* Powder texture: seeded so each ingredient looks the same everywhere */
  function rng(seed){var s=seed>>>0;return function(){s=(s+0x6D2B79F5)>>>0;var t=s;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return((t^(t>>>14))>>>0)/4294967296}}
  function gauss(r){var u=0,v=0;while(!u)u=r();while(!v)v=r();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)}
  function hex(h){h=(h||'#e0e0e0').replace('#','');if(h.length===3)h=h.replace(/./g,'$&$&');var n=parseInt(h,16);return[n>>16&255,n>>8&255,n&255]}
  function paint(cv,ing,seed){
    var W=cv.width,H=cv.height,x=cv.getContext('2d'),r=rng(seed),S=Math.min(W,H)/600,M=Math.max(W,H);
    var c=hex(ing.c),lum=c[0]*.3+c[1]*.59+c[2]*.11,pale=lum>215;
    x.fillStyle='#f3f3f1';x.fillRect(0,0,W,H);
    var bg=x.createRadialGradient(W*.5,H*.45,M*.05,W*.5,H*.5,M*.75);
    bg.addColorStop(0,'rgba(255,255,255,.7)');bg.addColorStop(1,'rgba(225,225,222,.6)');x.fillStyle=bg;x.fillRect(0,0,W,H);
    function col(j,a){var k=1+(r()-.5)*j;return'rgba('+Math.min(255,c[0]*k|0)+','+Math.min(255,c[1]*k|0)+','+Math.min(255,c[2]*k|0)+','+a+')'}
    function grain(px,py,sz,a){
      if(px<-10||py<-10||px>W+10||py>H+10)return;
      if(pale){x.fillStyle='rgba(110,110,106,'+(a*.7)+')';x.beginPath();x.arc(px+sz*.7,py+sz*.7,sz*1.05,0,6.283);x.fill()}
      x.fillStyle=col(pale?.06:.45,a);x.beginPath();x.arc(px,py,sz,0,6.283);x.fill();
    }
    var N=(pale?20000:12000)*Math.min(4,(W*H)/(600*600))|0,i,a,d,px,py,cx=W*.5,R=Math.min(W,H),p=ing.p;
    if(p==='ring'){
      for(i=0;i<N*1.4;i++){a=r()*6.283;d=Math.abs(gauss(r))*M*.32+R*.02;var rk=Math.sin(d/(R*.045)*3.1416);if(rk<-.2&&r()<.75)continue;
        grain(cx+Math.cos(a)*d,H*.62+Math.sin(a)*d,(.6+r()*1.4)*S,.55+r()*.45)}
      for(i=0;i<N*.3;i++){a=r()*6.283;d=Math.abs(gauss(r))*R*.09;grain(cx+Math.cos(a)*d,H*.62+Math.sin(a)*d*.9,(.8+r()*1.6)*S,.9)}
    }else if(p==='streak'){
      var ang=-.85+r()*.3,ca=Math.cos(ang),sa=Math.sin(ang);
      for(i=0;i<N;i++){var u=gauss(r)*M*.19,v=gauss(r)*R*.075*(1+Math.abs(u)/(M*.4));grain(W*.52+u*ca-v*sa,H*.5+u*sa+v*ca,(.6+r()*1.6)*S,.5+r()*.5)}
      for(i=0;i<N*.18;i++){grain(cx+gauss(r)*W*.34,H*.5+gauss(r)*H*.34,(.4+r()*1.2+(r()<.03?3:0))*S,.35+r()*.6)}
    }else if(p==='burst'){
      var rays=26+(r()*14|0);
      for(i=0;i<N;i++){var k=r()*rays|0;a=k/rays*6.283+(r()-.5)*.12;d=Math.pow(r(),.6)*M*.62;
        grain(W*.32+Math.cos(a)*d*1.1,H*.68+Math.sin(a)*d*.8,(.4+r()*1.3)*S*Math.max(.2,1-d/(M*.9)),.35+r()*.5)}
      for(i=0;i<N*.35;i++){a=r()*6.283;d=Math.abs(gauss(r))*R*.1;grain(W*.32+Math.cos(a)*d,H*.68+Math.sin(a)*d,(.8+r()*1.5)*S,.85)}
    }else if(p==='pile'){
      for(i=0;i<N*1.5;i++){px=r()*W;var top=H*(.42+.22*Math.sin(px/W*2.4+seed%5)+.06*Math.sin(px/W*9));
        py=top+Math.pow(r(),.55)*(H-top+20*S);x.globalAlpha=1-Math.min(1,(py-top)/(H*.6))*.35;grain(px,py,(.7+r()*1.7)*S,.7+r()*.3);x.globalAlpha=1}
      for(i=0;i<N*.25;i++){grain(r()*W,H*(.2+r()*.35),(.4+r()*1)*S,.25+r()*.4)}
    }else{
      for(i=0;i<N*1.2;i++){a=r()*6.283;d=Math.abs(gauss(r))*R*.2;
        x.globalAlpha=Math.sin(a)>0?1:.82;grain(cx+Math.cos(a)*d*1.35*(W/R),H*.58+Math.sin(a)*d*.75,(.7+r()*1.6)*S,.6+r()*.4);x.globalAlpha=1}
      for(i=0;i<N*.2;i++){grain(cx+gauss(r)*W*.3,H*.58+gauss(r)*H*.2,(.4+r()*1.1)*S,.3+r()*.5)}
    }
    var vg=x.createRadialGradient(W*.5,H*.5,M*.4,W*.5,H*.5,M*.78);
    vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.06)');x.fillStyle=vg;x.fillRect(0,0,W,H);
  }

  function init(root){
    if (!root || root.dataset.milReady) return;
    root.dataset.milReady = '1';
    var data; try { data = JSON.parse(root.querySelector('[data-mil-data]').textContent); } catch (e) { return; }
    data.forEach(function (g) { g.t = (g.t || []).map(function (t) { return t.trim(); }).filter(Boolean); });
    var dpr = Math.min(2, window.devicePixelRatio || 1);
    var cards = [].slice.call(root.querySelectorAll('.mil__card'));
    var buttons = [].slice.call(root.querySelectorAll('.mil__filter'));
    var current = 'All';

    cards.forEach(function (li) {
      var i = +li.dataset.i, cv = li.querySelector('canvas');
      if (cv) { cv.width = cv.height = Math.round(520 * dpr); paint(cv, data[i], i * 7919 + 13); }
      li.querySelector('.mil__open').addEventListener('click', function () { openAt(i, this); });
    });
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        current = b.dataset.f;
        buttons.forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
        cards.forEach(function (li) { li.hidden = !(current === 'All' || li.dataset.tags.indexOf('|' + current + '|') > -1); });
        var cs = [].slice.call(root.querySelectorAll('.mil__cat'));
        var hit = cs.some(function (c) { return c.dataset.cat === current; });
        cs.forEach(function (c) { c.hidden = c.dataset.cat !== (hit ? current : 'All'); });
      });
    });

    /* The drawer goes to <body> so a sticky header or a transformed ancestor can't clip it */
    var scrim = root.querySelector('[data-mil-scrim]'), drawer = root.querySelector('[data-mil-drawer]');
    document.body.appendChild(scrim); document.body.appendChild(drawer);
    var q = function (s) { return drawer.querySelector(s); };
    var media = q('[data-mil-media]'), list = [], pos = 0, opener = null, closeT = null;

    function render() {
      var g = data[list[pos]];
      q('[data-mil-pills]').innerHTML = '';
      g.t.forEach(function (t) { var s = document.createElement('span'); s.className = 'mil-d__pill'; s.textContent = t; q('[data-mil-pills]').appendChild(s); });
      q('[data-mil-name]').textContent = g.n; q('[data-mil-desc]').textContent = g.w; q('[data-mil-dose]').textContent = g.d;
      q('[data-mil-sup]').textContent = g.s; q('[data-mil-why]').textContent = g.y;
      var refs = (g.r || []).map(function (t) { return t.trim(); }).filter(Boolean), ul = q('[data-mil-refs]');
      ul.innerHTML = ''; q('[data-mil-refs-wrap]').hidden = !refs.length;
      refs.forEach(function (t) { var li = document.createElement('li'); li.textContent = t; ul.appendChild(li); });
      q('[data-mil-count]').textContent = (pos + 1) + ' of ' + list.length;
      q('[data-mil-prev]').disabled = pos === 0; q('[data-mil-next]').disabled = pos === list.length - 1;
      var old = media.querySelector('canvas,img'); if (old) old.remove();
      var el;
      if (g.img) { el = document.createElement('img'); el.src = g.img; el.alt = ''; }
      else {
        el = document.createElement('canvas'); el.setAttribute('aria-hidden', 'true');
        var box = media.getBoundingClientRect(), w = box.width || 600, h = box.height || w * 2 / 3;
        el.width = Math.round(w * dpr); el.height = Math.round(h * dpr); paint(el, g, list[pos] * 7919 + 13);
      }
      media.insertBefore(el, media.firstChild);
      drawer.scrollTop = 0;
    }
    function openAt(i, btn) {
      clearTimeout(closeT); opener = btn;
      list = cards.filter(function (li) { return !li.hidden; }).map(function (li) { return +li.dataset.i; });
      pos = Math.max(0, list.indexOf(i));
      scrim.hidden = false; drawer.hidden = false; document.documentElement.classList.add('mil-locked');
      requestAnimationFrame(function () { render(); scrim.classList.add('on'); drawer.classList.add('on'); q('[data-mil-close]').focus({ preventScroll: true }); });
    }
    function close() {
      if (drawer.hidden) return;
      scrim.classList.remove('on'); drawer.classList.remove('on'); document.documentElement.classList.remove('mil-locked');
      closeT = setTimeout(function () { scrim.hidden = true; drawer.hidden = true; }, 380);
      if (opener) opener.focus({ preventScroll: true });
    }
    q('[data-mil-close]').addEventListener('click', close);
    scrim.addEventListener('click', close);
    q('[data-mil-prev]').addEventListener('click', function () { if (pos > 0) { pos--; render(); } });
    q('[data-mil-next]').addEventListener('click', function () { if (pos < list.length - 1) { pos++; render(); } });
    document.addEventListener('keydown', function (e) {
      if (drawer.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight' && pos < list.length - 1) { pos++; render(); }
      else if (e.key === 'ArrowLeft' && pos > 0) { pos--; render(); }
      else if (e.key === 'Tab') {
        var f = drawer.querySelectorAll('button:not(:disabled)'), a = f[0], z = f[f.length - 1];
        if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
        else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
      }
    });
    /* Phone: drag the sheet down to close */
    var y0 = null;
    drawer.addEventListener('touchstart', function (e) { if (drawer.scrollTop <= 0) y0 = e.touches[0].clientY; }, { passive: true });
    drawer.addEventListener('touchmove', function (e) { if (y0 === null) return; var dy = e.touches[0].clientY - y0; if (dy > 0 && window.innerWidth <= 700) { drawer.style.transition = 'none'; drawer.style.transform = 'translateY(' + dy + 'px)'; } }, { passive: true });
    drawer.addEventListener('touchend', function (e) { if (y0 === null) return; var dy = e.changedTouches[0].clientY - y0; y0 = null; drawer.style.transition = ''; drawer.style.transform = ''; if (dy > 120 && window.innerWidth <= 700) close(); });

    /* Theme editor: tidy up the moved drawer when the section reloads */
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === root.dataset.mil) { scrim.remove(); drawer.remove(); document.documentElement.classList.remove('mil-locked'); }
    });
  }

  function boot() { [].forEach.call(document.querySelectorAll('.mil[data-mil]'), init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  document.addEventListener('shopify:section:load', boot);
})();
</script>

{% schema %}
{
  "name": "MUTO Ingredient library",
  "tag": "section",
  "class": "section-mil",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NAD+ Cellular Complex · 19 ingredients · 2 capsules" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every ingredient has a job." },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h1", "info": "h2 on a product page, where the product name is the h1.", "options": [{ "value": "h1", "label": "h1" }, { "value": "h2", "label": "h2" }] },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "Each one supports at least one of five things that change as we get older. Filter below to see which, and why it’s there." },
    { "type": "text", "id": "filters", "label": "Filters", "info": "Comma-separated. Each must match a tag used on the ingredients.", "default": "Energy, Recovery, Stress, Longevity, Immunity" },
    { "type": "text", "id": "supports_label", "label": "Supports label", "default": "Supports:" },
    { "type": "text", "id": "tests_label", "label": "Test results button", "info": "Opens the MUTO — Test results section on this page. Blank hides it.", "default": "View third-party testing results" },
    { "type": "text", "id": "cta_label", "label": "Button under the statement", "default": "Start your 90 days" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "foot", "label": "Note under the grid", "default": "Every dose is on the label. No blends, no fillers, vegan." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f9f9f9" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Space below", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Filter statement",
      "settings": [
        { "type": "text", "id": "name", "label": "Filter", "info": "\"All\" or one of the section's filters, spelt the same.", "default": "All" },
        { "type": "textarea", "id": "text", "label": "Statement" },
        { "type": "textarea", "id": "supports", "label": "Supports", "info": "One per line." }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
        { "type": "text", "id": "dose", "label": "Dose per serve", "default": "10 mg" },
        { "type": "text", "id": "tags", "label": "Tags", "info": "Comma-separated, e.g. Energy, Immunity", "default": "Energy" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square works best. Until set, a powder texture is drawn from the colour and pattern below." },
        { "type": "color", "id": "colour", "label": "Powder colour", "default": "#f4f4f0" },
        { "type": "select", "id": "pattern", "label": "Powder pattern", "default": "mound", "options": [
          { "value": "ring", "label": "Raked rings" }, { "value": "streak", "label": "Smear" }, { "value": "burst", "label": "Spray" },
          { "value": "pile", "label": "Pile" }, { "value": "mound", "label": "Heap" } ] },
        { "type": "textarea", "id": "description", "label": "What it does" },
        { "type": "text", "id": "supports", "label": "Supports" },
        { "type": "textarea", "id": "why", "label": "Why this form & dose" },
        { "type": "textarea", "id": "refs", "label": "Key references", "info": "One per line." }
      ]
    }
  ],
  "presets": [{ "name": "MUTO Ingredient library" }]
}
