{%- comment -%}
  MUTO — reviews in the buy box (muto-bf-review-box). A box in the dropdowns' style, between the buy box's three
  ticks and its Black Friday line: "Sound like you?" with three chips in the customers' own moments (Flat by 3pm,
  Slower to bounce back, Too many pots on the shelf; tap one to see matching reviews, tap again for all), then real
  customer reviews from REVIEWS.io rotating every 6 seconds (pauses on hover, focus or tap; arrows to step; no
  auto-rotation for people who ask for reduced motion).
  Each review: stars, the review word for word (… marks a cut), the name as REVIEWS.io shows it, the age only
  where the reviewer wrote it, a life stage only from the reviewer's own words, and "Verified buyer" only where
  REVIEWS.io marks them verified. The first three are the reviewers closest to the 35–55 buyer (46, 53, 36).
  Built 12 Nov 2026 by shopify/pdp-reviews/build_box.py, which checks every quote against REVIEWS.io; change the
  list there and rebuild. Left out: reviews IDs 51870930–51870962 (pending a check that they are genuine),
  reviews about medical conditions, and repeat postings of the same review.
  Rendered by the custom-liquid section after the buy box (ag1_plans); a script moves it into place.
{%- endcomment -%}
<div class="mc-rv" data-mc-rv hidden role="region" aria-roledescription="carousel" aria-label="Customer reviews">
  <div class="mc-rv__fit">
    <p class="mc-rv__ask" id="mc-rv-ask">Sound like you?</p>
    <div class="mc-rv__chips" role="group" aria-labelledby="mc-rv-ask">
%%CHIPS%%
    </div>
  </div>
  <div class="mc-rv__stack" aria-live="polite">
%%SLIDES%%
  </div>
  <div class="mc-rv__nav">
    <span class="mc-rv__count" aria-hidden="true"><b data-mc-rv-n>1</b> / <span data-mc-rv-t>%%N%%</span></span>
    <button type="button" class="mc-rv__btn" data-mc-rv-step="-1" aria-label="Previous review"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6"/></svg></button>
    <button type="button" class="mc-rv__btn" data-mc-rv-step="1" aria-label="Next review"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.6"/></svg></button>
  </div>
</div>
<style>
  /* Inside the buy box's subhead, which sets its own text to size 0: everything here sets its own size */
  html body #MainContent .mc .mc-rv{display:block;margin:18px 0 6px;padding:14px 18px 12px;border:1px solid #242223;border-radius:10px;background:#fff;font-family:var(--mc-font);font-size:15px;line-height:1.45;letter-spacing:0;text-transform:none;color:#242223;text-align:left;white-space:normal}
  .mc-rv[hidden]{display:none!important}
  html body #MainContent .mc .mc-rv__fit{margin:0 -18px 12px;padding:0 18px 12px;border-bottom:1px solid rgba(36,34,35,.12)}
  html body #MainContent .mc .mc-rv__ask{margin:0 0 8px!important;padding:0;font-family:var(--mc-font);font-size:14px;font-weight:500;line-height:1.3;color:#242223}
  html body #MainContent .mc .mc-rv__chips{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
  .mc-rv__chips::-webkit-scrollbar{display:none}
  html body #MainContent .mc .mc-rv__chip{flex:0 0 auto;min-height:0;margin:0;padding:7px 12px;border:1px solid rgba(36,34,35,.3);border-radius:999px;background:#fff;color:#242223;font-family:var(--mc-font);font-size:14px;font-weight:500;line-height:1.2;letter-spacing:0;text-transform:none;white-space:nowrap;cursor:pointer}
  html body #MainContent .mc .mc-rv__chip:hover{border-color:#242223}
  html body #MainContent .mc .mc-rv__chip[aria-pressed="true"]{background:#242223;border-color:#242223;color:#fff}
  .mc-rv__stack{display:grid}
  .mc-rv__slide{grid-area:1/1;display:flex;flex-direction:column;margin:0;opacity:0;visibility:hidden;transition:opacity .45s ease,visibility 0s linear .45s}
  .mc-rv__slide.is-out{display:none}
  .mc-rv__slide.is-on{opacity:1;visibility:visible;transition:opacity .45s ease}
  .mc-rv__top{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .mc-rv__stars{font-size:15px;letter-spacing:2px;color:#242223}
  html body #MainContent .mc .mc-rv__q{margin:8px 0 0;padding:0;border:0;font-size:15.5px;font-weight:500;line-height:1.42;letter-spacing:-.005em;font-style:normal;quotes:none;color:#242223!important}
  .mc-rv__q::before,.mc-rv__q::after{content:none!important}
  html body #MainContent .mc .mc-rv__who{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px;margin:auto 0 0!important;padding:12px 0 0!important;font-size:13.5px}
  .mc-rv__who b{font-weight:500}
  html body #MainContent .mc .mc-rv__who i{font-style:normal;color:rgba(36,34,35,.72)}
  .mc-rv__who span{margin-left:auto;font-family:var(--mc-mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(36,34,35,.62)}
  .mc-rv__nav{display:flex;align-items:center;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid rgba(36,34,35,.12)}
  .mc-rv__count{margin-right:auto;font-family:var(--mc-mono);font-size:11px;letter-spacing:.1em;color:rgba(36,34,35,.62)}
  .mc-rv__count b{font-weight:500;color:#242223}
  html body #MainContent .mc .mc-rv__btn{display:grid;place-items:center;width:32px;height:32px;min-height:0;padding:0;border:1px solid rgba(36,34,35,.25);border-radius:50%;background:#fff;color:#242223;cursor:pointer}
  .mc-rv__btn:hover{border-color:#242223}
  .mc-rv__btn svg{width:14px;height:14px}
  @media (prefers-reduced-motion:reduce){.mc-rv__slide,.mc-rv__slide.is-on{transition:none}}
  /* Phones: smaller type and tighter spacing, so the box takes less room */
  @media (max-width:749px){
    html body #MainContent .mc .mc-rv{margin:14px 0 4px!important;padding:10px 14px 10px!important}
    html body #MainContent .mc .mc-rv__fit{margin:0 -14px 10px!important;padding:0 14px 10px!important}
    html body #MainContent .mc .mc-rv__ask{margin-bottom:7px!important;font-size:13px!important}
    html body #MainContent .mc .mc-rv__chips{gap:5px!important}
    html body #MainContent .mc .mc-rv__chip{padding:6px 10px!important;font-size:12.5px!important}
    html body #MainContent .mc .mc-rv__stars{font-size:12px!important;letter-spacing:1.5px!important}
    html body #MainContent .mc .mc-rv__q{margin-top:6px!important;font-size:13.5px!important;line-height:1.4!important}
    html body #MainContent .mc .mc-rv__who{padding-top:8px!important;font-size:12.5px!important}
    html body #MainContent .mc .mc-rv__who span{font-size:9.5px!important}
    html body #MainContent .mc .mc-rv__nav{margin-top:8px!important;padding-top:8px!important}
    html body #MainContent .mc .mc-rv__count{font-size:10px!important}
    html body #MainContent .mc .mc-rv__btn{width:28px!important;height:28px!important}
    .mc-rv__btn svg{width:12px;height:12px}
  }
</style>
<script>
(function () {
  function init() {
  var box = document.querySelector('[data-mc-rv]');
  if (!box || box.getAttribute('data-ready')) return;
  /* Between the buy box's ticks and its Black Friday line (both drawn by the subhead's CSS) */
  var sub = document.querySelector('#MainContent [id$="__buy"] .mc-subhead');
  if (!sub) return;
  sub.appendChild(box);
  box.setAttribute('data-ready', '1');
  box.hidden = false;
  var all = [].slice.call(box.querySelectorAll('.mc-rv__slide')), slides = all;
  var n = box.querySelector('[data-mc-rv-n]'), tot = box.querySelector('[data-mc-rv-t]');
  var chips = [].slice.call(box.querySelectorAll('.mc-rv__chip'));
  var i = 0, timer = null, held = false;
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function show(k) {
    i = (k + slides.length) % slides.length;
    all.forEach(function (s) { var on = s === slides[i]; s.classList.toggle('is-on', on); if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
    if (n) n.textContent = i + 1;
  }
  function filter(f) {
    slides = all.filter(function (s) { return f === 'All' || s.getAttribute('data-tags').indexOf('|' + f + '|') > -1; });
    all.forEach(function (s) { s.classList.toggle('is-out', slides.indexOf(s) < 0); });
    chips.forEach(function (c) { c.setAttribute('aria-pressed', c.getAttribute('data-f') === f ? 'true' : 'false'); });
    if (tot) tot.textContent = slides.length;
    show(0);
  }
  function start() { stop(); if (!still && !held) timer = setInterval(function () { show(i + 1); }, 6000); }
  function stop() { if (timer) clearInterval(timer); timer = null; }
  box.addEventListener('mouseenter', function () { held = true; stop(); });
  box.addEventListener('mouseleave', function () { held = false; start(); });
  box.addEventListener('focusin', function () { held = true; stop(); });
  box.addEventListener('focusout', function () { held = false; start(); });
  box.addEventListener('touchstart', function () { held = true; stop(); setTimeout(function () { held = false; start(); }, 8000); }, { passive: true });
  [].forEach.call(box.querySelectorAll('[data-mc-rv-step]'), function (b) {
    b.addEventListener('click', function () { show(i + parseInt(b.getAttribute('data-mc-rv-step'), 10)); });
  });
  chips.forEach(function (c) { c.addEventListener('click', function () { filter(c.getAttribute('aria-pressed') === 'true' ? 'All' : c.getAttribute('data-f')); }); });
  filter('All'); start();
  }
  /* Straight away, and again once the page is parsed in case the buy box wasn't ready yet; it only sets up once */
  init();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else setTimeout(init, 0);
})();
</script>
