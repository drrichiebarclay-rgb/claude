<script>
(function () {
  /* The theme's cart script writes its "New Subtotal…" message into the first [aria-live="polite"] on the page. Give it a
     hidden one at the very top, so the message is still read out by screen readers and never lands in anything visible */
  if (!document.getElementById('mc-cart-live')) {
    var live = document.createElement('p');
    live.id = 'mc-cart-live'; live.className = 'visually-hidden'; live.setAttribute('aria-live', 'polite');
    live.style.cssText = 'position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap';
    (document.body || document.documentElement).insertBefore(live, (document.body || document.documentElement).firstChild);
  }
  function init() {
    var buy = document.querySelector('#MainContent [id$="__buy"]');
    if (!buy) return;
    var sub = document.querySelector('[data-mc-sub]'), h1 = buy.querySelector('.mc__buy-title');
    if (sub && h1 && !sub.getAttribute('data-ready')) {
      h1.parentNode.insertBefore(sub, h1.nextSibling);
      sub.setAttribute('data-ready', '1'); sub.hidden = false;
    }
    var flag = document.querySelector('[data-mc-heroflag]');
    if (flag && !flag.getAttribute('data-ready')) {
      var img = [].find.call(buy.querySelectorAll('[data-mc-slide] img'), function (i) { return /Frame_2147230175/.test(i.currentSrc || i.src || ''); });
      if (img && img.parentNode) {
        img.parentNode.classList.add('has-heroflag');
        img.parentNode.appendChild(flag);
        flag.setAttribute('data-ready', '1'); flag.hidden = false;
      }
    }
    var fo = document.querySelector('[data-mc-for]'), t1 = buy.querySelector('.mc__buy-title');
    if (fo && t1 && !fo.getAttribute('data-ready')) {
      t1.parentNode.insertBefore(fo, t1);
      fo.setAttribute('data-ready', '1'); fo.hidden = false;
    }
    /* The testing-results link: straight to its place above the badges (the theme's layout script would move it there
       a second after the page appears, so it showed under the photo first) */
    var links = document.querySelector('[data-mc-links]'), plansBox = buy.querySelector('.mc__plans');
    if (links && plansBox && !links.getAttribute('data-ready')) {
      /* Phones: above the plan cards. Desktop: under the photo and its tiles */
      var wide = window.matchMedia ? window.matchMedia('(min-width: 750px)') : null;
      var place = function () {
        var gal = buy.querySelector('.mc__gallery');
        if (wide && wide.matches && gal) { if (links.parentNode !== gal) gal.appendChild(links); }
        else if (links.nextElementSibling !== plansBox) plansBox.parentNode.insertBefore(links, plansBox);
      };
      place();
      if (wide) (wide.addEventListener ? wide.addEventListener('change', place) : wide.addListener(place));
      links.setAttribute('data-ready', '1'); links.hidden = false;
    }
    var tb = buy.querySelector('.mc-tests-btn'), bad = buy.querySelector('.mpb-bad');
    if (tb && links && links.getAttribute('data-ready') && !buy.querySelector('.mc-tests-btn[data-placed]')) {
      links.insertBefore(tb, links.firstChild);
      tb.setAttribute('data-placed', '1');
    }
    /* "View nutrition label" straight under the placed testing link; the pop-up lives at the end of the page */
    var lb = document.querySelector('[data-mc-label-btn]'), dlg = document.querySelector('[data-mc-label]'), placedTb = buy.querySelector('.mc-tests-btn[data-placed]');
    if (lb && dlg && placedTb && !lb.getAttribute('data-ready')) {
      links.appendChild(lb);
      lb.setAttribute('data-ready', '1'); lb.hidden = false;
      /* The theme's layout script re-inserts the testing link by the badges later; put both back above the plan cards */
      var keep = function () { var t = buy.querySelector('.mc-tests-btn[data-placed]'); if (t && t.parentNode !== links) links.insertBefore(t, links.firstChild); if (lb.parentNode !== links || links.lastElementChild !== lb) links.appendChild(lb); };
      if (window.MutationObserver) new MutationObserver(keep).observe(buy, { childList: true, subtree: true });
      document.addEventListener('DOMContentLoaded', function () { setTimeout(keep, 0); });
      var shut = function () { if (dlg.open && dlg.close) dlg.close(); else dlg.removeAttribute('open'); document.documentElement.classList.remove('mc-label-open'); };
      lb.addEventListener('click', function () {
        if (dlg.parentNode !== document.body && document.body) document.body.appendChild(dlg);
        if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
        document.documentElement.classList.add('mc-label-open');
      });
      dlg.querySelector('[data-mc-label-close]').addEventListener('click', shut);
