{%- comment -%}
  MUTO — welcome kit as photo tiles (muto-bf-kit-grid). Inside the selected plan's "Includes:" panel, the list of free
  gifts is shown as a grid of tiles: photo, name, the crossed-out value and a FREE badge. The tiles are built from the
  panel's own rows; tapping a tile opens that gift's details (the row's own pop-up). The 1-Month plan shows only its
  five gifts (creatine, socks, guide, Forever Jar, Apple Watch prize-draw entry: £62); the 3-Month plan shows all seven (£87). The "NAD+ Cellular Complex · Included" row stays as a line above the tiles.
  Photos: each gift product's main photo in Products, shown whole on a matching studio-grey background;
  change them in PHOTOS below.
  Rendered by the custom-liquid section after the buy box (ag1_plans).
{%- endcomment -%}
<style>
  html:root body #MainContent#MainContent [id$="__buy"] .mc__kit.has-tiles .mc__inc-row:not(.mc__inc-main){display:none!important}
  .mc-kt{margin:12px 0 4px}
  .mc-kt__h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 0 14px;font-family:var(--mc-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#242223}
  .mc-kt__h span + span{color:rgba(36,34,35,.62)}
  .mc-kt__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 6px;margin:0;padding:0;list-style:none}
  html:root body #MainContent [id$="__buy"] .mc__kit[data-kt-worth="£87"] .mc__inc::after{content:"Free gifts worth £87"!important}
  html:root body #MainContent [id$="__buy"] .mc__kit[data-kt-worth="£62"] .mc__inc::after{content:"Free gifts worth £62"!important}
  .mc-kt__grid > li{display:flex;margin:0;padding:0}
  .mc-kt__grid > li::before{content:none!important}
  .mc-kt__grid > li[hidden]{display:none!important}
  .mc-kt__tile{width:100%;position:relative;display:flex;flex-direction:column;align-items:center;margin:0;padding:11px 4px 8px;border:1px solid rgba(36,34,35,.22);border-radius:8px;background:#fff;text-align:center;cursor:pointer;font:inherit;color:#242223;min-width:0}
  .mc-kt__tile[hidden]{display:none}
  .mc-kt__tile:hover{border-color:#242223}
  .mc-kt__free{position:absolute;top:-8px;left:50%;transform:translateX(-50%);padding:2px 6px;border-radius:999px;background:#242223;color:#fff;font-family:var(--mc-mono);font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;line-height:1.2;white-space:nowrap}
  .mc-kt__img{display:block;width:100%;aspect-ratio:1;border-radius:4px;overflow:hidden;background:linear-gradient(180deg,#222125 0%,#343337 40%,#c9c7c9 85%,#dedcde 100%)}
  .mc-kt__img{display:grid!important;place-items:center}
  .mc-kt__icon{width:46%;height:46%}
  .mc-kt__img img{display:block;width:100%;height:100%;object-fit:contain}
  .mc-kt__name{display:block;margin-top:6px;font-size:11px;font-weight:500;line-height:1.25;text-wrap:balance}
  .mc-kt__was{display:block;margin-top:2px;font-size:10.5px;line-height:1.2;color:rgba(36,34,35,.5)}
  .mc-kt__was s{text-decoration-thickness:1px}
  /* Phones: the prize-draw entry as one wide tile across the row, so it doesn't sit alone */
  @media (max-width:989px){
    .mc-kt__grid > li.is-entry.is-wide{grid-column:1/-1}
    .mc-kt__grid > li.is-entry.is-wide .mc-kt__tile{flex-direction:row;align-items:center;gap:12px;padding:10px 12px;text-align:left}
    .mc-kt__grid > li.is-entry.is-wide .mc-kt__img{flex:0 0 52px;width:52px}
    .mc-kt__grid > li.is-entry.is-wide .mc-kt__name{margin-top:0}
    .mc-kt__grid > li.is-entry.is-wide .mc-kt__was{display:none}
  }
  @media (min-width:990px){.mc-kt__grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:14px 8px}.mc-kt__name{font-size:12px}}
</style>
<script>
(function () {
  /* Gift photos: each gift product's main photo in Products (shown whole, not cropped), matched on the gift's name */
  var PHOTOS = [
    /* name, photo, zoom (1 = the whole photo; above 1 fills the tile and zooms in on the product) */
    [/creatine/i, 'Frame2147230125.png?v=1791393368', 1.4],
    [/sock/i, 'home-essentials-socks.jpg?v=1791037580', 1.45],
    [/bottle/i, 'muto-bottle-front.jpg?v=1791291422', 1.6],
    [/vial/i, 'travel-vial-square.jpg?v=1793355284', 1],
    [/forever|jar to keep/i, 'gift-forever-jar.jpg?v=1791023224', 1.05],
    [/guide|protocol/i, 'image_8.png?v=1791392460', 1.1],
    [/apple watch|garmin|watch/i, '', 1] /* no Apple Watch photo yet: a watch icon shows until one is added here */
  ];
  /* Which gifts each plan includes, and what they're worth (the theme's own rows don't change with the plan) */
  var ONE_MONTH = /creatine|sock|guide|protocol|forever|jar to keep|garmin|watch/i;
  var WATCH_ICON = '<svg class="mc-kt__icon" viewBox="0 0 48 48" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 10l1.5-6h11L31 10"/><path d="M17 38l1.5 6h11L31 38"/><rect x="13" y="10" width="22" height="28" rx="7"/><path d="M24 19v6l4 2"/></svg>';
  var WORTH = { three: '£87', one: '£62' };
  var CDN = 'https://cdn.shopify.com/s/files/1/0976/2724/2843/files/';
  function photo(n) { for (var i = 0; i < PHOTOS.length; i++) if (PHOTOS[i][0].test(n)) return PHOTOS[i][1] ? CDN + PHOTOS[i][1] + '&width=420' : ''; return ''; }
  function zoom(n) { for (var i = 0; i < PHOTOS.length; i++) if (PHOTOS[i][0].test(n)) return PHOTOS[i][2] || 1; return 1; }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function build(kit) {
    var rows = [].slice.call(kit.querySelectorAll('.mc__inc-row:not(.mc__inc-main)'));
    if (!rows.length) return;
    var wrap = kit.querySelector('.mc-kt');
    if (!wrap) {
      var total = 0;
      wrap = document.createElement('div'); wrap.className = 'mc-kt';
      var ul = document.createElement('ul'); ul.className = 'mc-kt__grid'; ul.setAttribute('role', 'list');
      rows.forEach(function (r, i) {
        var nameEl = r.querySelector('.mc__inc-name') || r.firstElementChild;
        var name = (nameEl.textContent || '').replace(/\s+/g, ' ').trim();
        var wasEl = r.querySelector('.mc__inc-was');
        var was = wasEl ? wasEl.textContent.trim() : '';
        var free = (r.querySelector('.mc__inc-free') || {}).textContent || 'Free';
        var li = document.createElement('li');
        li.innerHTML = '<button type="button" class="mc-kt__tile"><span class="mc-kt__free">' + esc(/entry/i.test(free) ? 'Free entry' : 'Free') + '</span>' +
          '<span class="mc-kt__img">' + (photo(name) ? '<img src="' + photo(name) + '" alt="" width="150" height="150" loading="lazy"' + (zoom(name) > 1 ? ' style="object-fit:cover;transform:scale(' + zoom(name) + ')"' : '') + '>' : (/watch/i.test(name) ? WATCH_ICON : '')) + '</span>' +
          '<span class="mc-kt__name">' + esc(name.replace(/\s*\(one size fits all\)/i, '')) + '</span>' +
          '<span class="mc-kt__was">' + (was ? '<s><span class="visually-hidden">Worth </span>' + esc(was) + '</s>' : '&nbsp;') + '</span></button>';
        var btn = li.firstChild;
        btn._row = r;
        if (/entry/i.test(free)) li.className = 'is-entry';
        btn.setAttribute('aria-label', name + (was ? ', worth ' + was : '') + ', free. Show details');
        btn.addEventListener('click', function () { var b = r.querySelector('.mc__inc-link'); if (b) b.click(); });
        ul.appendChild(li);
      });
      var kitTitle = kit.querySelector('.mc__inc');
      wrap.appendChild(ul);
      (kitTitle && kitTitle.parentNode === kit ? kit.insertBefore(wrap, kitTitle.nextSibling) : kit.appendChild(wrap));
      kit.classList.add('has-tiles');
    }
    sync(kit);
  }
  /* Show only the gifts in the chosen plan, and its kit value; on phones the prize-draw entry goes full width if it
     would otherwise sit alone on its row */
  function sync(kit) {
    var plans = kit.closest('.mc__plans');
    var sel = plans && (plans.querySelector(':scope > label.mc__plan.is-selected') || plans.querySelector(':scope > label.mc__plan input:checked') && plans.querySelector(':scope > label.mc__plan input:checked').closest('label'));
    var name = sel ? (sel.getAttribute('data-name') || sel.textContent) : '';
    var one = /1.?month|monthly/i.test(name) && !/3.?month/i.test(name);
    var shown = 0, entry = null;
    [].forEach.call(kit.querySelectorAll('.mc-kt__tile'), function (t) {
      var n = t.querySelector('.mc-kt__name').textContent;
      var off = one && !ONE_MONTH.test(n);
      t.parentNode.hidden = off;
      if (!off) { shown++; if (t.parentNode.classList.contains('is-entry')) entry = t.parentNode; }
    });
    [].forEach.call(kit.querySelectorAll('.mc-kt__grid > li.is-entry'), function (li) { li.classList.toggle('is-wide', li === entry && shown % 4 === 1); });
    kit.setAttribute('data-kt-worth', one ? WORTH.one : WORTH.three);
  }
  function run() { [].forEach.call(document.querySelectorAll('#MainContent [id$="__buy"] .mc__kit'), build); }
  run();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.mc__plan')) setTimeout(run, 60); });
})();
</script>
