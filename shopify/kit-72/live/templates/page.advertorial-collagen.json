        "ch_product": {
          "type": "chapter",
          "settings": {
            "kicker": "05 · The product",
            "heading": "What MUTO is",
            "text": "<p>One product. Sixty capsules, a thirty-day supply, two a day. A cellular energy formula built around nicotinamide riboside - the raw material your body converts into NAD⁺ - working on the production side rather than the supply side. Three jobs, no overlap:</p>"
          }
        },
        "needle1": {
          "type": "needle",
          "settings": {
            "label": "Produce",
            "text": "<p>Nicotinamide riboside at 300mg, plus zinc, copper and six B vitamins in active forms - the cofactors NAD⁺ production and use depend on.</p>",
            "dark": false
