        "description_text_RRJGKW": {
          "type": "description_text",
          "settings": {
            "description_bullet": "<p><strong>60 Capsules, 30 Servings</strong></p>",
            "custom_class": "font-C8D2CF"
          }
        },
        "description_text_jrpnxQ": {
          "type": "description_text",
          "settings": {
            "description_bullet": "<p><strong>I didn't build MUTO because I saw an opportunity.<br/>I built it because I couldn't find a product I'd take myself.</strong></p><p>This category runs on single ingredients, proprietary blends and claims nobody has to answer for. MUTO is the opposite of that: fifteen ingredients, every dose printed, every batch third-party tested, and independent university trials I don't control the outcome of. My name is on the label because I'm accountable for what's behind it.</p>",
            "custom_class": ""
          }
        },
        "custom_liquid_NVnjAC": {
          "type": "custom_liquid",
          "settings": {
