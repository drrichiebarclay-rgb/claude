    "custom_energy_card_slider_EkaDTn": {
      "type": "custom-energy-card-slider",
      "blocks": {
        "item_RXMBMR": {
          "type": "item",
          "settings": {
            "card_type": "default",
            "image": "shopify://shop_images/energy-hold.jpg",
            "heading": "<p>ENERGY THAT HOLDS.</p>",
            "sub_heading": "<p>No spike, no crash.<br/>Just the next hour, and the one after.</p>",
            "show_badge": true,
            "badge_icon": "shopify://shop_images/Energy-Icon.svg",
            "badge_label": "Energy",
            "show_more_modal": true,
            "description": "<p>Most energy is borrowed - caffeine and stimulants that spike fast and fade faster, then cost your recovery and readiness tomorrow. NAD+ Cellular Complex feeds the system that makes your own energy, so the afternoon doesn't flatten and the crash never shows up in the first place.</p>"
          }
        },
        "item_RetjCE": {
          "type": "item",
          "settings": {
            "card_type": "default",
            "image": "shopify://shop_images/compundes.jpg",
            "heading": "<p>OUTPUT THAT COMPOUNDS.</p>",
            "sub_heading": "<p>Greater output, day after<br/>day - not just today.</p>",
            "show_badge": true,
            "badge_icon": "shopify://shop_images/Performance-Icon.svg",
            "badge_label": "Performance",
            "show_more_modal": true,
            "description": "<p>One good session is luck, a pattern of them is a system. NAD+ Cellular Complex supports the cellular engines behind output, so the work you put in today is still paying off in week twelve, not reset back to zero tomorrow.</p>"
          }
        },
        "item_Np4PbA": {
          "type": "item",
          "settings": {
            "card_type": "default",
            "image": "shopify://shop_images/recovery-card.jpg",
            "heading": "<p>ADAPT FASTER.</p>",
            "sub_heading": "<p>Get back to full output sooner.</p>",
            "show_badge": true,
            "badge_icon": "shopify://shop_images/Recovery-Icon.svg",
            "badge_label": "Recovery",
            "show_more_modal": true,
            "description": "<p>Recovery happens overnight, at cellular level, not just in bed. NAD+ Cellular Complex supports the repair systems your body relies on while you sleep, so the next session starts from a stronger baseline - not from behind.</p>"
          }
        },
        "item_wt7EJy": {
          "type": "item",
          "settings": {
            "card_type": "default",
            "image": "shopify://shop_images/shift-energy.jpg",
            "heading": "<p>SEE THE SHIFT.</p>",
            "sub_heading": "<p>HRV up. Sleep score up.<br/>Recovery trend up.</p>",
            "show_badge": true,
