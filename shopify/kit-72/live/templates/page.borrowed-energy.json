        "custom_liquid_NVnjAC": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"product-benifits\">\n  <div class=\"product-benifits-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_HRV.svg\" alt=\"HRV\" width=\"26\" />\n    <div class=\"product-benifits-info\">\n      <strong>HRV</strong>\n      <p>You felt fine. It said otherwise. MUTO supports the cellular system HRV reports on.</p>\n    </div>\n  </div>\n  <div class=\"product-benifits-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Recovery_Score.svg\" alt=\"Recovery score\" width=\"26\" />\n    <div class=\"product-benifits-info\">\n      <strong>Recovery</strong>\n      <p>Eight hours in bed, still 61%. Recovery is cellular work - MUTO supports the system doing it.</p>\n    </div>\n  </div>\n  <div class=\"product-benifits-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Energy.svg\" alt=\"Energy\" width=\"26\" />\n    <div class=\"product-benifits-info\">\n      <strong>Energy</strong>\n      <p>Your energy engines, not a spike. No artificial fuel, no crash.</p>\n    </div>\n  </div>\n  <div class=\"product-benifits-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Readiness_Score.svg\" alt=\"Measure score\" width=\"26\" />\n    <div class=\"product-benifits-info\">\n      <strong>Measure</strong>\n      <p>Recovery, readiness, HRV. Your wearable reports the output. MUTO is the input.</p>\n    </div>\n  </div>\n</div>"
          }
        },
        "custom_liquid_4pRkRn": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"guarantees\">\n  <li class=\"guarantee__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Thrid_Party.svg\" alt=\"Third-party tested\" width=\"24\" />\n    <span>90-day money-back guarantee</span>\n  </li>\n  <li class=\"guarantee__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Thrid_Party.svg\" alt=\"Third-party tested\" width=\"24\" />\n    <span>Third-party tested</span>\n  </li>\n  <li class=\"guarantee__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_ISO_manufacturing.svg\" alt=\"UK GMP ISO manufacturing\" width=\"24\" />\n    <span>UK GMP ISO manufacturing</span>\n  </li>\n  <li class=\"guarantee__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_6_person_board.svg\" alt=\"6-person Scientific Advisory Board\" width=\"24\" />\n    <span>6-person Scientific Advisory Board</span>\n  </li>\n  <li class=\"guarantee__pill\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0976/2724/2843/files/Muto_Research.svg\" alt=\"Independent research\" width=\"24\" />\n    <span>Independent research with Coventry, Westminster & Newcastle Australia Universities</span>\n  </li>\n</ul>"
          }
