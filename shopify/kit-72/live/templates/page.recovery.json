            "custom_liquid": "<div class=\"custom-reviews-info\">\n  <div class=\"CarouselWidget-prefix\">\n    <div class=\"CarouselWidget\">\n      <div class=\"R-ReviewsList\">\n        <div class=\"R-ReviewsList__item\">\n          <div tabindex=\"0\" role=\"button\" aria-label=\"Review by Henry Warhurst, 5 out of 5 stars\">\n            <div class=\"item__inner\">\n              <div>\n                <div>\n                  <div\n                    class=\"R-TextHeading R-TextHeading--xxxxs R-TextHeading--inline u-textLeft--all u-verticalAlign--middle u-marginRight--xs\">\n\n                    <div class=\"cssVar-authorName\">Henry Warhurst</div>\n\n                  </div>\n\n                  <div\n                    class=\"R-RatingStars R-RatingStars--xs u-verticalAlign--middle cssVar-starDisplay cssVar-starDisplay\"\n                    title=\"5 Stars\">\n                    <div aria-hidden=\"true\" class=\"R-RatingStars__stars\">\n                      <i class=\"stars__icon ricon-percentage-star--100\"></i><i\n                        class=\"stars__icon ricon-percentage-star--100\"></i><i\n                        class=\"stars__icon ricon-percentage-star--100\"></i><i\n                        class=\"stars__icon ricon-percentage-star--100\"></i><i\n                        class=\"stars__icon ricon-percentage-star--100\"></i>\n                    </div>\n                  </div>\n                </div>\n                <div>\n                  <div class=\"R-ReviewsList__item--body R-TextBody R-TextBody--xxs u-textLeft--all\">This stuff should be\n                    illegal\n                    it’s so good! HRV was 30 now an average of over 90. A monthly supplement you simply can’t miss out\n                    on.</div>\n                </div>\n              </div>\n              <div class=\"R-flex-row R-flex-row--noMargin R-flex-between-xxs R-flex-bottom-xxs\">\n                <div></div>\n                <div>\n                  <div class=\"R-TextBody R-TextBody--xxxxs u-textRight--all u-marginBottom--xs\">GB</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"
          }
