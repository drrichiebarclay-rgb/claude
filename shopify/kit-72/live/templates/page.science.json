    "custom_pathways_aFKW8F": {
      "type": "custom-pathways",
      "blocks": {
        "pathway_k9Bfym": {
          "type": "pathway",
          "settings": {
            "title": "PRODUCE - the fuel your cells need",
            "sub_title": "Your cells need raw material to make NAD+, plus a few essentials to turn it into energy.",
            "content": "<p>Key ingredients</p><ul><li><strong>Nicotinamide Riboside (NR), 300mg<br/></strong>the building block your cells turn into NAD+.</li><li><strong>B1, B2, B3, B6, Folate, B12</strong><br/>the vitamins that power energy production. We use the active forms of folate and B12, so your body can use them straight away.</li><li><strong>Zinc, 15mg</strong><br/>a key mineral your cells rely on to turn raw material into usable NAD+.</li><li><strong>Copper, 1mg</strong><br/>works alongside zinc to keep that energy-making process running smoothly.</li></ul>"
          }
        },
        "pathway_qHPpVM": {
          "type": "pathway",
          "settings": {
            "title": "PROTECT - keeping your NAD+ working",
            "sub_title": "Your body breaks NAD+ down as fast as it makes it. Protecting it matters as much as producing it.",
            "content": "<p>Key ingredients</p><ul><li><strong>Quercetin, 250mg<br/></strong>helps block the enzyme that breaks NAD+ down, so more of it sticks around.</li><li><strong>Pterostilbene, 100mg</strong><br/>supports your cells' natural defences.</li><li><strong>Grapeseed Extract, 200mg</strong><br/>a plant antioxidant that helps shield your cells from everyday wear and tear.</li><li><strong>Turmeric Extract, 200mg</strong><br/>supports your cells' natural defences, so they can keep protecting your NAD+ over time.</li></ul>"
          }
        },
        "pathway_D6Q3Pc": {
          "type": "pathway",
          "settings": {
            "title": "PUT TO WORK - turning it into energy you feel",
            "sub_title": "The final step: making sure that energy actually gets used.",
            "content": "<p>Key ingredients</p><ul><li><strong>Coenzyme Q10, 50mg<br/></strong>works inside the mitochondria, where energy is actually made.</li><li><strong>BioPerine®️, 20mg</strong><br/>helps your body absorb everything above, instead of losing it.</li></ul>"
          }
        }
      },
