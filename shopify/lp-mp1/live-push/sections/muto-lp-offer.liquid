{%- comment -%}
  MUTO landing page — the offer. Kit photograph beside a dark panel that itemises
  the first order: the product and its price, what's included free, the total,
  the button and a line of ticks.
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  if s.image != blank
    assign img_src = s.image | image_url: width: 1400
  else
    assign img_src = s.image_fallback
  endif
  assign ticks = s.ticks | newline_to_br | split: '<br />'
-%}
<div class="mlp">
  <section class="mlp-offer" id="offer-{{ section.id }}" aria-labelledby="mlp-offer-{{ section.id }}">
    <div class="mlp-offer__in">
      <h2 class="mlp-offer__h" id="mlp-offer-{{ section.id }}">{{ s.heading | escape | newline_to_br }}</h2>
      <div class="mlp-offer__grid">
        {%- if img_src != blank -%}
          <div class="mlp-offer__media"><img src="{{ img_src }}" alt="{{ s.image_alt | escape }}" width="1290" height="968" loading="lazy"></div>
        {%- endif -%}
        <div class="mlp-offer__panel">
          <div class="mlp-offer__main">
            <div class="mlp-offer__line"><p class="mlp-offer__name">{{ s.product_name }}</p><p class="mlp-offer__price">{{ s.product_price }}</p></div>
            {%- if s.product_sub != blank -%}<p class="mlp-offer__sub">{{ s.product_sub }}</p>{%- endif -%}
          </div>
          {%- if s.includes_label != blank -%}<p class="mlp-offer__label">{{ s.includes_label }}</p>{%- endif -%}
          <ul class="mlp-offer__items">
            {%- assign items = section.blocks | where: 'type', 'item' -%}
            {%- for block in items -%}
              <li {{ block.shopify_attributes }}>
                <div class="mlp-offer__line"><p class="mlp-offer__name">{{ block.settings.name }}</p><p>{% if block.settings.was != blank %}<s>{{ block.settings.was }}</s>{% endif %}<span class="mlp-offer__free">{{ block.settings.now | default: 'free' }}</span></p></div>
                {%- if block.settings.desc != blank -%}<p class="mlp-offer__sub">{{ block.settings.desc }}</p>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if s.total_now != blank -%}
            <div class="mlp-offer__line mlp-offer__total"><p>{{ s.total_label | default: 'Total' }}</p><p>{% if s.total_was != blank %}<s>{{ s.total_was }}</s>{% endif %}{{ s.total_now }}</p></div>
          {%- endif -%}
        </div>
      </div>
      {%- assign future = section.blocks | where: 'type', 'future' -%}
      {%- if future.size > 0 -%}
        <div class="mlp-offer__future">
          <p class="mlp-offer__label">{{ s.future_label | default: 'Future monthly gifts' }}</p>
          <ul class="mlp-future">
            {%- for block in future -%}
              {%- liquid
                if block.settings.image != blank
                  assign f_src = block.settings.image | image_url: width: 240
                else
                  assign f_src = block.settings.image_fallback
                endif
              -%}
              <li class="mlp-future__item" {{ block.shopify_attributes }}>
                <span class="mlp-future__img">{%- if f_src != blank -%}<img src="{{ f_src }}" alt="{{ block.settings.image_alt | escape }}" width="120" height="120" loading="lazy">{%- endif -%}</span>
                <span class="mlp-future__txt">
                  <span class="mlp-future__when">{{ block.settings.when }}</span>
                  <span class="mlp-future__what">{{ block.settings.name }}</span>
                  <span class="mlp-future__val">{{ block.settings.value }}</span>
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if s.cta_label != blank -%}<div class="mlp-offer__cta"><a class="mlp__btn mlp__btn--arrow" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a></div>{%- endif -%}
      {%- if s.ticks != blank -%}<ul class="mlp-ticks">{%- for t in ticks -%}{%- assign x = t | strip -%}{%- if x != blank -%}<li>{{ x }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "MUTO LP — Offer",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_fallback", "label": "Image URL (fallback)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "product_name", "label": "Product line" },
    { "type": "text", "id": "product_price", "label": "Product price" },
    { "type": "text", "id": "product_sub", "label": "Product small line" },
    { "type": "text", "id": "includes_label", "label": "Includes label" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "future_label", "label": "Future gifts label", "default": "Future monthly gifts" },
    { "type": "text", "id": "total_was", "label": "Total, struck through" },
    { "type": "text", "id": "total_now", "label": "Total now" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "textarea", "id": "ticks", "label": "Ticks", "info": "One per line." }
  ],
  "blocks": [
    { "type": "item", "name": "Included item", "settings": [
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "desc", "label": "Description" },
      { "type": "text", "id": "was", "label": "Usual price" },
      { "type": "text", "id": "now", "label": "Price now", "default": "free" }
    ] },
    { "type": "future", "name": "Future gift", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_fallback", "label": "Image URL (fallback)" },
      { "type": "text", "id": "image_alt", "label": "Alt text" },
      { "type": "text", "id": "when", "label": "When", "default": "Order 2" },
      { "type": "text", "id": "name", "label": "Gift" },
      { "type": "text", "id": "value", "label": "Value" }
    ] }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "MUTO LP — Offer" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
