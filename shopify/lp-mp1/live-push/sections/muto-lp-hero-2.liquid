{%- comment -%}
  MUTO landing page — hero. Product photograph left, offer copy right: rating,
  headline, body, a bold one-liner, the button and a line of ticks. On a phone
  the copy comes first so the headline and button sit on the first screen.
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  if s.image != blank
    assign img_src = s.image | image_url: width: 1400
  else
    assign img_src = s.image_fallback
  endif
  assign ticks = s.ticks | newline_to_br | split: '<br />'
-%}
<div class="mlp">
  <section class="mlp-hero" aria-labelledby="mlp-hero-{{ section.id }}">
    <div class="mlp-hero__copy">
      {%- if s.rating_text != blank -%}<p class="mlp-rating"><span class="mlp-rating__stars" aria-hidden="true">★★★★★</span><span>{{ s.rating_text }}</span></p>{%- endif -%}
      <h1 class="mlp-hero__h1" id="mlp-hero-{{ section.id }}">{{ s.heading | escape | newline_to_br }}</h1>
      {%- if s.body != blank -%}<div class="mlp-hero__body">{{ s.body }}</div>{%- endif -%}
      {%- if s.strong != blank -%}<p class="mlp-hero__strong">{{ s.strong }}</p>{%- endif -%}
      {%- if s.cta_label != blank -%}
        <div class="mlp-hero__cta"><a class="mlp__btn mlp__btn--cyan mlp__btn--arrow" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a></div>
      {%- endif -%}
      {%- if s.ticks != blank -%}<ul class="mlp-ticks">{%- for t in ticks -%}{%- assign x = t | strip -%}{%- if x != blank -%}<li>{{ x }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
    </div>
    <div class="mlp-hero__media">
      {%- if img_src != blank -%}<img src="{{ img_src }}" alt="{{ s.image_alt | escape }}" width="1400" height="1050" loading="eager" fetchpriority="high"{% if s.image_position != blank %} style="object-position:{{ s.image_position }}"{% endif %}>{%- endif -%}
    </div>
  </section>
</div>
{%- if section.settings.schema_on -%}
  {%- assign sp = all_products[section.settings.schema_product] -%}
  {%- if sp != blank -%}
    {%- assign sp_url = shop.url | append: sp.url -%}
    {%- assign sp_variant = sp.selected_or_first_available_variant -%}
    {%- if section.settings.image != blank -%}
      {%- assign sp_page_img = section.settings.image | image_url: width: 1200 | prepend: 'https:' -%}
    {%- elsif section.settings.image_fallback != blank -%}
      {%- assign sp_page_img = section.settings.image_fallback -%}
    {%- else -%}
      {%- assign sp_page_img = sp.featured_image | image_url: width: 1200 | prepend: 'https:' -%}
    {%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ page_title | json }},
      "description": {{ page_description | default: section.settings.heading | json }},
      "inLanguage": "en-GB",
      "isPartOf": { "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
      "about": { "@id": {{ sp_url | append: '#product' | json }} },
      "primaryImageOfPage": {{ sp_page_img | json }}
    },
    {
      "@type": "Product",
      "@id": {{ sp_url | append: '#product' | json }},
      "name": {{ section.settings.schema_name | default: sp.title | json }},
      "brand": { "@type": "Brand", "name": "MUTO" },
      "description": {{ section.settings.schema_description | default: sp.description | strip_html | truncate: 300 | json }},
      "image": {{ sp.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
      "url": {{ sp_url | json }},
      "offers": {
        "@type": "Offer",
        "url": {{ sp_url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ sp_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if sp.available %}InStock{% else %}OutOfStock{% endif %}",
        "seller": { "@type": "Organization", "name": "MUTO" }
      }
    }
  ]
}
</script>
  {%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "MUTO LP — Offer hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_fallback", "label": "Image URL (fallback)" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "image_position", "label": "Image focus", "info": "CSS object-position, e.g. 50% 50%." },
    { "type": "text", "id": "rating_text", "label": "Rating line" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "strong", "label": "Bold line" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "textarea", "id": "ticks", "label": "Ticks", "info": "One per line." },
    { "type": "header", "content": "Search and answer engines" },
    { "type": "checkbox", "id": "schema_on", "label": "Emit WebPage and Product structured data", "default": true },
    { "type": "text", "id": "schema_product", "label": "Product handle", "default": "muto-nad-cellular-complex" },
    { "type": "text", "id": "schema_name", "label": "Product name for structured data" },
    { "type": "textarea", "id": "schema_description", "label": "Product description for structured data" }
  ],
  "presets": [{ "name": "MUTO LP — Offer hero" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
