{%- comment -%}
  MUTO landing page — numbered reasons for an advertorial. Each reason has a
  number badge, a title, rich-text body and an optional MUTO answer panel and
  photo. Dose grid, featured review, big figure, callout and button blocks sit
  between reasons as their own cards. Numbering is automatic.
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- capture ic_bolt -%}<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>{%- endcapture -%}
{%- capture ic_heart -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>{%- endcapture -%}
{%- capture ic_sparkle -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/><path d="M19 16v4M17 18h4"/>{%- endcapture -%}
{%- capture ic_leaf -%}<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19l8-8"/>{%- endcapture -%}
{%- capture ic_sun -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>{%- endcapture -%}
{%- capture ic_shield -%}<path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/>{%- endcapture -%}
{%- capture ic_flask -%}<path d="M9 3h6M10 3v6L5 19a1.5 1.5 0 0 0 1.3 2h11.4A1.5 1.5 0 0 0 19 19l-5-10V3"/>{%- endcapture -%}
{%- capture ic_drop -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>{%- endcapture -%}
{%- capture ic_capsule -%}<rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/>{%- endcapture -%}
<div class="mlp">
  <section class="mlp-rs" id="{{ section.settings.anchor | default: 'reasons' }}">
    <ol class="mlp-rs__list">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'reason' -%}
          {%- assign n = n | plus: 1 -%}
          {%- liquid
            if block.settings.image != blank
              assign r_src = block.settings.image | image_url: width: 1200
            else
              assign r_src = block.settings.image_fallback
            endif
          -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <div class="mlp-rs__top"><span class="mlp-rs__num" aria-hidden="true">{{ n }}</span><h2 class="mlp-rs__h">{{ block.settings.title }}</h2></div>
            <div class="mlp-rs__body">{{ block.settings.body }}</div>
            {%- if r_src != blank -%}<div class="mlp-rs__img"><img src="{{ r_src }}" alt="{{ block.settings.image_alt | escape }}" width="1200" height="750" loading="lazy"{% if block.settings.image_position != blank %} style="object-position:{{ block.settings.image_position }}"{% endif %}></div>{%- endif -%}
            {%- if block.settings.answer != blank -%}
              <div class="mlp-rs__answer"><p class="mlp-rs__answer-label">{{ block.settings.answer_label | default: 'The MUTO way' }}</p>{{ block.settings.answer }}</div>
            {%- endif -%}
          </li>
        {%- elsif block.type == 'doses' -%}
          {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
          <li class="mlp-rs__item mlp-rs__item--doses" {{ block.shopify_attributes }}>
            <div class="mlp-rs__doses">
              <p class="mlp-rs__doses-fig">{{ block.settings.figure }}</p>
              <p class="mlp-rs__doses-label">{{ block.settings.label }}</p>
              {%- if block.settings.sub != blank -%}<p class="mlp-rs__doses-sub">{{ block.settings.sub }}</p>{%- endif -%}
              <ul class="mlp-rs__doses-grid">
                {%- for r in rows -%}
                  {%- assign parts = r | split: '|' -%}
                  {%- assign nm = parts[0] | strip -%}
                  {%- if nm != blank -%}<li><strong>{{ nm }}</strong><span>{{ parts[1] | strip }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if block.settings.foot != blank -%}<p class="mlp-rs__doses-foot">{{ block.settings.foot }}</p>{%- endif -%}
            </div>
          </li>
        {%- elsif block.type == 'review' -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            {%- if block.settings.lead != blank -%}<div class="mlp-rs__body mlp-rs__body--lead">{{ block.settings.lead }}</div>{%- endif -%}
            <figure class="mlp-rs__review">
              <p class="mlp-rs__review-stars" aria-label="5 out of 5 stars">★★★★★</p>
              <blockquote>{{ block.settings.quote }}</blockquote>
              {%- if block.settings.name != blank -%}<figcaption>{{ block.settings.name }}</figcaption>{%- endif -%}
            </figure>
            {%- if block.settings.cta_label != blank -%}<p class="mlp-rs__review-cta"><a class="mlp__btn mlp__btn--arrow" href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}">{{ block.settings.cta_label }}</a></p>{%- endif -%}
          </li>
        {%- elsif block.type == 'stat' -%}
          <li class="mlp-rs__item mlp-rs__item--flat" {{ block.shopify_attributes }}>
            <div class="mlp-rs__stat"><p class="mlp-rs__stat-fig">{{ block.settings.figure }}</p><p class="mlp-rs__stat-text">{{ block.settings.text }}</p></div>
            {%- if block.settings.source != blank -%}<p class="mlp-rs__source">{{ block.settings.source }}</p>{%- endif -%}
          </li>
        {%- elsif block.type == 'table' -%}
          {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <div class="mlp-rs__table">
              {%- if block.settings.heading != blank -%}<h3 class="mlp-rs__table-h">{{ block.settings.heading }}</h3>{%- endif -%}
              <table>
                <thead><tr><th scope="col">{{ block.settings.col1 | default: 'Ingredient' }}</th><th scope="col">{{ block.settings.col2 | default: 'Cost a month*' }}</th></tr></thead>
                <tbody>
                  {%- for r in rows -%}
                    {%- assign parts = r | split: '|' -%}
                    {%- assign nm = parts[0] | strip -%}
                    {%- if nm != blank -%}<tr><td><span class="mlp-rs__tick" aria-hidden="true">✓</span>{{ nm }}</td><td>{{ parts[1] | strip }}</td></tr>{%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
              <p class="mlp-rs__table-total"><span>{{ block.settings.total_label | default: 'Total a month' }}</span><strong>{{ block.settings.ours }}</strong><em>vs</em><s>{{ block.settings.theirs }}</s></p>
              {%- if block.settings.plus != blank -%}<p class="mlp-val__plus mlp-rs__table-plus"><span class="mlp-val__plus-tag">{{ block.settings.plus_label | default: 'Plus' }}</span><span>{{ block.settings.plus }}</span></p>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="mlp-rs__table-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          </li>
        {%- elsif block.type == 'replaces' -%}
          {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <div class="mlp-rs__replaces">
              <p class="mlp-rs__replaces-label">{{ block.settings.label }}</p>
              <p class="mlp-rs__replaces-fig">{{ block.settings.figure }}</p>
              {%- if block.settings.items != blank -%}
                <ul class="mlp-rs__pots">
                  {%- for r in rows -%}
                    {%- assign parts = r | split: '|' -%}
                    {%- assign nm = parts[0] | strip -%}
                    {%- assign ic = parts[1] | strip -%}
                    {%- if nm != blank -%}
                      <li><span class="mlp-rs__pot-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        {%- case ic -%}{%- when 'bolt' -%}{{ ic_bolt }}{%- when 'heart' -%}{{ ic_heart }}{%- when 'sparkle' -%}{{ ic_sparkle }}{%- when 'leaf' -%}{{ ic_leaf }}{%- when 'sun' -%}{{ ic_sun }}{%- when 'shield' -%}{{ ic_shield }}{%- when 'flask' -%}{{ ic_flask }}{%- when 'drop' -%}{{ ic_drop }}{%- else -%}{{ ic_capsule }}{%- endcase -%}
                      </svg></span>{{ nm }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}<a class="mlp__btn mlp-rs__pots-btn" href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}">{{ block.settings.cta_label }}</a>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="mlp-rs__replaces-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          </li>
        {%- elsif block.type == 'compare' -%}
          {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <div class="mlp-rs__table mlp-rs__cmp">
              {%- if block.settings.heading != blank -%}<h3 class="mlp-rs__table-h">{{ block.settings.heading }}</h3>{%- endif -%}
              <table>
                <thead><tr><th scope="col">{{ block.settings.col1 }}</th><th scope="col">{{ block.settings.col2 }}</th><th scope="col" class="mlp-rs__cmp-us">{{ block.settings.col3 }}</th></tr></thead>
                <tbody>
                  {%- for r in rows -%}
                    {%- assign parts = r | split: '|' -%}
                    {%- assign a = parts[0] | strip -%}
                    {%- if a != blank -%}<tr><th scope="row">{{ a }}</th><td>{{ parts[1] | strip }}</td><td class="mlp-rs__cmp-us">{{ parts[2] | strip }}</td></tr>{%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
              {%- if block.settings.note != blank -%}<p class="mlp-rs__table-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          </li>
        {%- elsif block.type == 'person' -%}
          {%- liquid
            if block.settings.image != blank
              assign pe_src = block.settings.image | image_url: width: 240
            else
              assign pe_src = block.settings.image_fallback
            endif
          -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <figure class="mlp-rs__person">
              {%- if block.settings.label != blank -%}<p class="mlp-rs__person-label">{{ block.settings.label }}</p>{%- endif -%}
              {%- if pe_src != blank -%}<img src="{{ pe_src }}" alt="" width="120" height="120" loading="lazy"{% if block.settings.position != blank %} style="object-position:{{ block.settings.position }}"{% endif %}>{%- endif -%}
              <blockquote>{{ block.settings.quote }}</blockquote>
              <figcaption><strong>{{ block.settings.name }}</strong>{%- if block.settings.role != blank -%}<span>{{ block.settings.role }}</span>{%- endif -%}</figcaption>
            </figure>
          </li>
        {%- elsif block.type == 'callout' -%}
          {%- liquid
            if block.settings.image != blank
              assign c_src = block.settings.image | image_url: width: 1200
            else
              assign c_src = block.settings.image_fallback
            endif
          -%}
          <li class="mlp-rs__item" {{ block.shopify_attributes }}>
            <div class="mlp-rs__callout">{{ block.settings.text }}</div>
            {%- if c_src != blank -%}<div class="mlp-rs__img mlp-rs__img--product"><img src="{{ c_src }}" alt="{{ block.settings.image_alt | escape }}" width="1200" height="800" loading="lazy"{% if block.settings.image_position != blank %} style="object-position:{{ block.settings.image_position }}"{% endif %}></div>{%- endif -%}
          </li>
        {%- else -%}
          <li class="mlp-rs__cta" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            <a class="mlp__btn mlp__btn--cyan mlp__btn--arrow" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.label }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </section>
</div>
{% schema %}
{
  "name": "MUTO LP — Reasons",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reasons" }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "body", "label": "Body" },
      { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
      { "type": "text", "id": "image_fallback", "label": "Photo URL" },
      { "type": "text", "id": "image_alt", "label": "Photo description" },
      { "type": "text", "id": "image_position", "label": "Photo focus" },
      { "type": "text", "id": "answer_label", "label": "Answer panel label", "default": "The MUTO way" },
      { "type": "richtext", "id": "answer", "label": "Answer panel" }
    ] },
    { "type": "doses", "name": "Dose grid", "settings": [
      { "type": "text", "id": "figure", "label": "Big figure" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "sub", "label": "Small line" },
      { "type": "textarea", "id": "items", "label": "Ingredients (one per line: Name | dose)" },
      { "type": "text", "id": "foot", "label": "Line under grid" }
    ] },
    { "type": "review", "name": "Featured review", "settings": [
      { "type": "richtext", "id": "lead", "label": "Text above (optional)" },
      { "type": "textarea", "id": "quote", "label": "Customer quote (real words only)" },
      { "type": "text", "id": "name", "label": "Customer name" },
      { "type": "text", "id": "cta_label", "label": "Button (optional)" },
      { "type": "url", "id": "cta_link", "label": "Button link" }
    ] },
    { "type": "stat", "name": "Big figure", "settings": [
      { "type": "text", "id": "figure", "label": "Figure" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "source", "label": "Source line" }
    ] },
    { "type": "table", "name": "Cost table", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "col1", "label": "Column 1", "default": "Ingredient" },
      { "type": "text", "id": "col2", "label": "Column 2", "default": "Cost a month*" },
      { "type": "textarea", "id": "rows", "label": "Rows (one per line: Name | price)" },
      { "type": "text", "id": "total_label", "label": "Total label", "default": "Total a month" },
      { "type": "text", "id": "ours", "label": "Our price" },
      { "type": "text", "id": "theirs", "label": "Their price (struck through)" },
      { "type": "text", "id": "plus_label", "label": "Extra line tag", "default": "Plus" },
      { "type": "textarea", "id": "plus", "label": "Extra line under the total" },
      { "type": "textarea", "id": "note", "label": "Footnote" }
    ] },
    { "type": "replaces", "name": "Replaces card", "settings": [
      { "type": "text", "id": "label", "label": "Small label" },
      { "type": "text", "id": "figure", "label": "Big line" },
      { "type": "textarea", "id": "items", "label": "Products (Name | icon)", "info": "One per line. Icons: bolt, heart, sparkle, leaf, sun, shield, flask, drop, capsule" },
      { "type": "text", "id": "cta_label", "label": "Button" },
      { "type": "url", "id": "cta_link", "label": "Button link" },
      { "type": "text", "id": "note", "label": "Footnote" }
    ] },
    { "type": "compare", "name": "Comparison table", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "col1", "label": "Column 1" },
      { "type": "text", "id": "col2", "label": "Column 2" },
      { "type": "text", "id": "col3", "label": "Column 3 (MUTO)" },
      { "type": "textarea", "id": "rows", "label": "Rows (one per line: Want | Them | MUTO)" },
      { "type": "text", "id": "note", "label": "Footnote" }
    ] },
    { "type": "person", "name": "Person quote", "settings": [
      { "type": "text", "id": "label", "label": "Small label" },
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_fallback", "label": "Photo URL" },
      { "type": "text", "id": "position", "label": "Photo focus" },
      { "type": "textarea", "id": "quote", "label": "Quote (their own approved words only)" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "role", "label": "Role" }
    ] },
    { "type": "callout", "name": "Callout", "settings": [
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
      { "type": "text", "id": "image_fallback", "label": "Photo URL" },
      { "type": "text", "id": "image_alt", "label": "Photo description" },
      { "type": "text", "id": "image_position", "label": "Photo focus" }
    ] },
    { "type": "cta", "name": "Button", "settings": [
      { "type": "text", "id": "text", "label": "Line above button" },
      { "type": "text", "id": "label", "label": "Button" },
      { "type": "url", "id": "link", "label": "Button link" }
    ] }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "MUTO LP — Reasons" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
