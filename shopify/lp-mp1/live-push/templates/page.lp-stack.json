    "lp_faq": {
      "type": "muto-lp-faq",
      "settings": {
        "heading": "You’ve got questions?\nWe’ve got answers.",
        "open_first": true,
        "schema_on": true
      },
      "blocks": {
        "q1": {
          "type": "q",
          "settings": {
            "q": "What does MUTO replace?",
            "a": "<p>For many customers, several separate pots: NR, CoQ10, PQQ, B vitamins, vitamin D3, K2, zinc and resveratrol are all in here, at the doses shown. Never stop anything you take for a medical reason, and check with your GP if you take medicine.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "q": "What’s actually in it?",
            "a": "<p>19 ingredients, every dose on the label: 300mg NR (the most allowed in Great Britain), a full B complex, vitamin D3 and K2, zinc, copper, CoQ10, PQQ, TMG, grapeseed, trans-resveratrol and BioPerine®. Ask your AI, your GP, or Richie, who answers formula questions himself.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "q": "Is it worth the money?",
            "a": "<p>Bought separately at similar doses, the main ingredients cost about £5.25 a day at UK retail. MUTO is £2 a day on subscription, and you have 90 days to decide.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "q": "Who is Richie Barclay?",
            "a": "<p>MUTO’s founder: a PhD cell biologist and former cricketer. He isn’t a medical doctor; our Scientific Advisory Board includes doctors and scientists who review the formula.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "q": "Is it safe with what I already take?",
            "a": "<p>Usually, yes. If you take medicine, check with your GP first, and don’t stop anything you take for a medical reason.</p>"
          }
        },
        "q6": {
          "type": "q",
          "settings": {
            "q": "Will it work for me?",
            "a": "<p>We won’t promise what it’ll do for you. Note your starting point, give it 90 days, and judge it yourself. If you don’t see a difference, you’re covered.</p>"
          }
        },
        "q7": {
          "type": "q",
          "settings": {
            "q": "Am I locked into a subscription?",
            "a": "<p>No. Skip, pause or cancel online, any time. We remind you 5 days before every payment.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6",
        "q7"
      ]
    },
