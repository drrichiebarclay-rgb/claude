{%- comment -%}
  MUTO landing page — three proof cards: an optional big figure, a title, text
  and a citation line (a customer's name, or the survey a figure comes from).
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="mlp">
  <section class="mlp__band{% if s.tint %} mlp-cards--tint{% endif %}" aria-labelledby="mlp-cards-{{ section.id }}">
    <div class="mlp__wrap">
      <div class="mlp__head">
        {%- if s.pill != blank -%}<p class="mlp__pill">{{ s.pill }}</p>{%- endif -%}
        <h2 class="mlp__h2" id="mlp-cards-{{ section.id }}">{{ s.heading | escape }}{% if s.heading_accent != blank %}<span>{{ s.heading_accent | escape }}</span>{% endif %}</h2>
        {%- if s.sub != blank -%}<p class="mlp__sub">{{ s.sub }}</p>{%- endif -%}
      </div>
      <div class="mlp-cards__grid">
        {%- for block in section.blocks -%}
          <div class="mlp-card" {{ block.shopify_attributes }}>
            {%- if block.settings.figure != blank -%}<p class="mlp-card__fig">{{ block.settings.figure }}</p>{%- endif -%}
            <h3 class="mlp-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="mlp-card__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.cite != blank -%}<p class="mlp-card__cite">{{ block.settings.cite }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if s.foot != blank -%}<p class="mlp-cards__foot">{{ s.foot }}</p>{%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "MUTO LP — Proof cards",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": true },
    { "type": "text", "id": "pill", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Heading, accent line" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },
    { "type": "text", "id": "foot", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "figure", "label": "Big figure (optional)" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "cite", "label": "Citation" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "MUTO LP — Proof cards" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
