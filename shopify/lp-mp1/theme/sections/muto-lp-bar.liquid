{%- comment -%}
  MUTO landing page — sticky offer bar. Slides up once the visitor scrolls past
  the first screen, and stays. A spacer keeps it from covering the footer.
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="mlp">
  <div class="mlp-bar" id="mlp-bar-{{ section.id }}" aria-hidden="true">
    <div class="mlp-bar__in">
      <p class="mlp-bar__text">{{ s.text }}</p>
      <a class="mlp__btn mlp__btn--cyan" href="{{ s.cta_link | default: routes.all_products_collection_url }}" tabindex="-1">{{ s.cta_label }}{% if s.cta_sub != blank %}<small>{{ s.cta_sub }}</small>{% endif %}</a>
    </div>
  </div>
  <div class="mlp-bar-spacer" aria-hidden="true"></div>
</div>
<script>
  (function () {
    var bar = document.getElementById('mlp-bar-{{ section.id }}');
    if (!bar) return;
    var link = bar.querySelector('a');
    function check() {
      var on = window.scrollY > window.innerHeight * 0.6;
      bar.classList.toggle('is-on', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      link.tabIndex = on ? 0 : -1;
    }
    window.addEventListener('scroll', check, { passive: true });
    check();
  })();
</script>
{% schema %}
{
  "name": "MUTO LP — Sticky offer bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Offer text" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "text", "id": "cta_sub", "label": "Button small line" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "MUTO LP — Sticky offer bar" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
