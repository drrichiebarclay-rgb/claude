{%- comment -%}
  MUTO landing page — the old way vs the MUTO way. Two cards; one item per line.
{%- endcomment -%}
{{ 'muto-lp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign old_items = s.old_items | newline_to_br | split: '<br />'
  assign new_items = s.new_items | newline_to_br | split: '<br />'
-%}
<div class="mlp">
  <section class="mlp__band" aria-labelledby="mlp-vs-{{ section.id }}">
    <div class="mlp__wrap">
      <div class="mlp__head">
        {%- if s.pill != blank -%}<p class="mlp__pill">{{ s.pill }}</p>{%- endif -%}
        <h2 class="mlp__h2" id="mlp-vs-{{ section.id }}">{{ s.heading | escape }}{% if s.heading_accent != blank %}<span>{{ s.heading_accent | escape }}</span>{% endif %}</h2>
        {%- if s.sub != blank -%}<p class="mlp__sub">{{ s.sub }}</p>{%- endif -%}
      </div>
      <div class="mlp-vs">
        <div class="mlp-vs__card mlp-vs__card--old">
          <h3 class="mlp-vs__title">{{ s.old_title }}</h3>
          <ul class="mlp-vs__list">{%- for i in old_items -%}{%- assign t = i | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
        </div>
        <div class="mlp-vs__card mlp-vs__card--new">
          <h3 class="mlp-vs__title">{{ s.new_title }}</h3>
          <ul class="mlp-vs__list">{%- for i in new_items -%}{%- assign t = i | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
        </div>
      </div>
      {%- if s.cta_label != blank -%}<div class="mlp-vs__cta"><a class="mlp__btn" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label }}</a></div>{%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "MUTO LP — Old way vs MUTO",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "pill", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Heading, accent line" },
    { "type": "textarea", "id": "sub", "label": "Subheading" },
    { "type": "text", "id": "old_title", "label": "Left card title", "default": "The old way" },
    { "type": "textarea", "id": "old_items", "label": "Left card items", "info": "One per line." },
    { "type": "text", "id": "new_title", "label": "Right card title", "default": "The MUTO way" },
    { "type": "textarea", "id": "new_items", "label": "Right card items", "info": "One per line." },
    { "type": "text", "id": "cta_label", "label": "Button (optional)" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "MUTO LP — Old way vs MUTO" }],
  "enabled_on": { "templates": ["page", "index", "product"] }
}
{% endschema %}
