    "ingredients": {
      "type": "muto-crea-ingredients",
      "blocks": {
        "i1": {
          "type": "ingredient",
          "settings": {
            "name": "Nicotinamide riboside",
            "dose": "300mg",
            "group": "",
            "text": "A direct NAD+ precursor: your cells convert it in two steps. 300mg is the dose the published human work is built on, not a fraction of it."
          }
        },
        "i2": {
          "type": "ingredient",
          "settings": {
            "name": "Trimethylglycine",
            "dose": "450mg",
            "group": "",
            "text": "A methyl donor. NAD+ metabolism uses methyl groups up, so TMG puts them back rather than leaving the rest of the pathway competing for them."
          }
        },
        "i3": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin D3",
            "dose": "2000IU",
            "group": "",
            "text": "Most people in the UK run low between October and March. Included at a daily dose rather than a token one."
          }
        },
        "i4": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin K2 (MK-7)",
            "dose": "100µg",
            "group": "",
            "text": "Pairs with D3: K2 directs calcium towards bone rather than soft tissue. The MK-7 form stays in circulation longest."
          }
        },
        "i5": {
          "type": "ingredient",
          "settings": {
            "name": "Methylated B complex",
            "dose": "8 vitamins",
            "group": "",
            "text": "Eight B vitamins, every dose declared: thiamin 5mg, riboflavin 5mg, niacin 16mg NE, pantothenic acid 10mg, B6 as P5P 5mg, folate 400µg, B12 100µg and biotin 300µg. Active forms throughout — B6 as P5P, folate and B12 methylated — because NAD+ metabolism spends methyl groups, and these are the forms that put them back without the liver having to convert them first."
          }
        },
        "i13": {
          "type": "ingredient",
          "settings": {
            "name": "Zinc (bisglycinate)",
            "dose": "15mg",
            "group": "",
            "text": "Chelated for absorption, and easier on an empty stomach than the oxide form."
          }
        },
        "i14": {
          "type": "ingredient",
          "settings": {
            "name": "Copper (bisglycinate)",
            "dose": "1mg",
            "group": "",
            "text": "Balances the zinc. A daily zinc dose without copper beside it depletes copper over time."
          }
        },
        "i15": {
          "type": "ingredient",
          "settings": {
            "name": "Grapeseed extract",
            "dose": "150mg",
            "group": "",
            "text": "Polyphenols, standardised rather than a whole-fruit powder, so the dose on the label means something."
          }
        },
        "i16": {
          "type": "ingredient",
          "settings": {
            "name": "Trans-resveratrol",
            "dose": "50mg",
            "group": "",
            "text": "The trans isomer specifically — the form the research uses, and the one that survives the shelf."
          }
        },
        "i17": {
          "type": "ingredient",
          "settings": {
            "name": "Coenzyme Q10",
            "dose": "150mg",
            "group": "",
            "text": "Carries electrons inside the mitochondria. Levels fall from your thirties onwards, and statins lower them further."
          }
        },
        "i18": {
          "type": "ingredient",
          "settings": {
            "name": "PQQ",
            "dose": "20mg",
            "group": "",
            "text": "Studied for its role in mitochondrial biogenesis: making new mitochondria rather than only running the ones you have."
          }
        },
        "i19": {
          "type": "ingredient",
          "settings": {
            "name": "Bioperine®",
            "dose": "5mg",
            "group": "",
            "text": "Black pepper extract. It is here because it improves the absorption of several of the ingredients above."
          }
        }
      },
