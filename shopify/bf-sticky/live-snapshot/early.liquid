<div id="mc-bf-data" hidden data-left="{{ shop.metafields.muto.bf_boxes_left.value }}" data-orders="{{ shop.metafields.muto.bf_orders_left.value }}"></div>
<script>
/* Open on the Quarterly plan (the second card) before first paint: the same switch muto-home.js makes
   on a click, so its own start-up then announces Quarterly and nothing changes on screen. */
(function () {
  var cards = [].slice.call(document.querySelectorAll('.mc__plans > label.mc__plan'));
  var q = cards[1];
  if (!q || q.classList.contains('is-selected') || q.classList.contains('is-unavailable')) return;
  var qi = q.querySelector('.mc__plan-input');
  if (qi && qi.disabled) return;
  cards.forEach(function (c) {
    var on = c === q;
    c.classList.toggle('is-selected', on);
    var r = c.querySelector('input[type="radio"]');
    if (r && !r.disabled) r.checked = on;
  });
  var idx = q.getAttribute('data-index');
  [].forEach.call(document.querySelectorAll('[data-mc-plan-for]'), function (el) {
    var list = (el.getAttribute('data-mc-plan-for') || '').split(/\s+/);
    el.classList.toggle('is-plan-off', list.indexOf(idx) === -1);
  });
  var price = q.getAttribute('data-price-full') || q.getAttribute('data-price') || '';
  if (price) [].forEach.call(document.querySelectorAll('[data-mh-cta-price]'), function (s) { s.textContent = price; });
  var v = q.getAttribute('data-variant');
  if (v) {
    var plan = q.getAttribute('data-plan') || '';
    [].forEach.call(document.querySelectorAll('[data-mh-cart-id]'), function (f) { f.value = v; });
    [].forEach.call(document.querySelectorAll('[data-mh-cart-plan]'), function (f) { f.value = plan; f.disabled = !plan; });
  }
})();
</script>
<script>
/* Black Friday: 53% off the first order plus the welcome kit, limited to TOTAL orders.
   Orders left comes from the shop metafield muto.bf_orders_left (printed into #mc-bf-data by the
   template); it must be the real number left. Blank hides the count. CODE, once set, is applied
   automatically so it is on the cart and checkout. */
(function () {
  var CODE = "";
  var TOTAL = 500;
  if (CODE) {
    try {
      if (!sessionStorage.getItem('mcBf' + CODE)) {
        fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' })
          .then(function () { try { sessionStorage.setItem('mcBf' + CODE, '1'); } catch (e) {} });
      }
    } catch (e) {
      fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' });
    }
  }
  function mount() {
    var plans = document.querySelector('.mc .mc__plans');
    if (!plans || document.querySelector('.mc-bf')) return;
    var data = document.getElementById('mc-bf-data');
    var left = data ? parseInt(data.getAttribute('data-orders'), 10) : NaN;
    var box = document.createElement('div');
    box.className = 'mc-bf';
    box.setAttribute('role', 'note');
    var html =
      '<p class="mc-bf__tag"><span class="mc-bf__dot"></span>Black Friday offer</p>' +
      '<div class="mc-bf__main"><p class="mc-bf__offer">53% off your first order</p>' +
      '<p class="mc-bf__kit">plus a welcome kit worth £87</p>' +
      '<p class="mc-bf__sched">£99 for your first order, £125 on your second, £150 on your third.</p></div>';
    var hasCount = left >= 0 && left <= TOTAL;
    if (hasCount) {
      html += '<p class="mc-bf__count" aria-label="' + left + ' out of ' + TOTAL + ' remaining"><b>' + left +
        '</b><small>out of ' + TOTAL + ' remaining</small></p>';
    }
    html += '<div class="mc-bf__foot">' +
      (hasCount ? '<span class="mc-bf__bar" aria-hidden="true"><i style="width:' + Math.round(left / TOTAL * 100) + '%"></i></span>' : '') +
      '<p class="mc-bf__note">' + (hasCount && left === 0 ? 'All ' + TOTAL + ' have gone.' : 'Limited to ' + TOTAL + ' orders.') +
      (CODE ? ' Code <b>' + CODE + '</b> is applied at checkout.' : '') + '</p></div>';
    box.innerHTML = html;
    plans.parentNode.insertBefore(box, plans);
  }
  /* Straight away: this runs right after the buy box, so the plans are already there */
  mount();
  if (!document.querySelector('.mc-bf')) document.addEventListener('DOMContentLoaded', mount);
})();

/* Subhead under the title, and the testing-results button under the images. The button opens the
   page's test-results panel (the tests section listens for [data-mtr-open]). */
(function () {
  var SUBHEAD = 'Everything your body needs after 35 for energy, recovery, stress, immunity and longevity.';
  var title = document.querySelector('.mc .mc__buy-title');
  if (title && !document.querySelector('.mc-subhead')) {
    var p = document.createElement('p');
    p.className = 'mc-subhead';
    p.textContent = SUBHEAD;
    title.insertAdjacentElement('afterend', p);
  }
  var media = document.querySelector('.mc .mc__buy-media');
  if (media && !media.querySelector('.mc-tests-btn')) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'mc-tests-btn';
    b.setAttribute('data-mtr-open', '');
    b.innerHTML = '<span class="mc-tests-btn__tick" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.6l4.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>View third-party testing results';
    media.appendChild(b);
  }
})();
</script>
<script>
(function () {
  var sub = document.querySelector('.mc .mc-subhead');
  if (!sub || document.querySelector('.mc-collab')) return;
  var p = document.createElement('p');
  p.className = 'mc-collab';
  p.textContent = "In collaboration with seven leading scientists from world-leading research institutions, including four universities in the UK and Australia.";
  sub.insertAdjacentElement('afterend', p);
})();
</script>
<script>
(function () {
  var STATS = [[94, "reported better recovery"], [92, "reported improved energy"], [88, "bounce back quicker"]];
  var btn = document.querySelector('.mc .mc__buy-cta');
  if (!btn || document.querySelector('.mc-stats')) return;
  var box = document.createElement('div');
  box.className = 'mc-stats';
  box.innerHTML = '<span class="mc-stats__bar" aria-hidden="true"><i></i></span><p class="mc-stats__text" aria-live="polite"></p>';
  btn.insertAdjacentElement('afterend', box);
  var bar = box.querySelector('i'), text = box.querySelector('.mc-stats__text');
  var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var n = 0;
  function show(i) {
    var s = STATS[i];
    text.innerHTML = '<b>' + s[0] + '%</b> ' + s[1];
    /* Snap back to empty with no transition, then fill left to right */
    bar.style.transition = 'none';
    bar.style.width = '0';
    void bar.offsetWidth;
    bar.style.transition = '';
    if (still) { bar.style.width = s[0] + '%'; return; }
    requestAnimationFrame(function () { bar.style.width = s[0] + '%'; });
  }
  show(0);
  setInterval(function () {
    if (document.hidden) return;
    n = (n + 1) % STATS.length;
    if (still) { show(n); return; }
    box.classList.add('is-fading');
    setTimeout(function () { show(n); box.classList.remove('is-fading'); }, 350);
  }, 3500);
})();
</script>
<script>
(function () {
  var el = document.querySelector('.mc .mpb-del');
  if (!el || el.dataset.ship) return;
  el.dataset.ship = '1';
  /* Royal Mail logo (theme/assets/royal-mail-logo.png), inline so it needs no upload */
  var RM_LOGO = 'data:image/png;base64,';
  var CUTOFF = 21;
  var DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  function ord(n) { var t = n % 100; if (t > 10 && t < 14) return 'th'; return ['th', 'st', 'nd', 'rd'][n % 10] || 'th'; }
  function tomorrowUK() {
    var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: 'numeric', day: 'numeric',
      hour: 'numeric', hourCycle: 'h23' }).formatToParts(new Date());
    var get = function (t) { return +p.filter(function (x) { return x.type === t; })[0].value; };
    /* Next-day cut-off is 9pm UK time: from 21:00 it arrives the day after tomorrow */
    var days = get('hour') >= CUTOFF ? 2 : 1;
    var d = new Date(Date.UTC(get('year'), get('month') - 1, get('day') + days));
    return DAYS[d.getUTCDay()] + ' ' + d.getUTCDate() + ord(d.getUTCDate()) + ' ' + MONTHS[d.getUTCMonth()];
  }
  var last = '';
  function paint() {
    var t = tomorrowUK();
    if (t === last) return;
    last = t;
    el.innerHTML = '<span class="mc-ship__dot" aria-hidden="true"></span><span>Ready to ship — arrives by <b>' + t + '</b></span>' +
      '<span class="mc-ship__rm"><img src="' + RM_LOGO + '" alt="Royal Mail" width="32" height="22">Tracked 24hr delivery</span>';
  }
  paint();
  setInterval(paint, 60000);
})();
</script>