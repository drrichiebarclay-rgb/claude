{%- comment -%}
  MUTO — compact mobile header (site-wide, header group). Phones and tablets (below 990px): a shorter
  header bar so it takes less of the screen: 8px margin and padding instead of 24px and 16px, a smaller
  logo, caption and icons. Pages that slide under the see-through header move up by the new height
  (44px instead of 76px). Inline, so it applies on first paint. Delete the section to undo.
{%- endcomment -%}
<style>
@media screen and (max-width:989.98px){
  header.header{margin:8px 10px 0!important;padding-top:8px!important;padding-bottom:8px!important}
  .header.page-width{padding-left:12px!important;padding-right:12px!important}
  .header__heading-logo-wrapper{gap:6px!important}
  .header__heading-logo{width:36px!important;height:auto!important}
  .header-logo-caption{font-size:6.5px!important;line-height:6px!important;letter-spacing:.4px!important}
  .header__icon,.header__icon .icon,.header__icon .svg-wrapper{width:18px!important;height:18px!important}
  .header__icon--cart{margin-left:10px!important}
  main:has([allow-transparent-header]){margin-top:-44px!important}
  .template-muto-nad .header-wrapper,.template-muto-bottle .header-wrapper,
  .template-muto-socks .header-wrapper,.template-muto-creatine .header-wrapper{padding-top:6px!important;padding-bottom:6px!important}
}
</style>

{% schema %}
{
  "name": "MUTO — Compact header",
  "tag": "div",
  "class": "muto-header-compact",
  "settings": [
    { "type": "paragraph", "content": "Site-wide: makes the header bar shorter on phones and tablets. Delete this section to go back to the original size." }
  ],
  "presets": [{ "name": "MUTO — Compact header" }]
}
{% endschema %}
