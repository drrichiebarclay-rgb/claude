{%- liquid
  # The Quarterly plan, read off the product: the first variant that sells on a 3-month selling plan.
  # Nothing typed, so the same code works on the main product and on -2 (different variant ids).
  assign bf_q_variant = ''
  assign bf_q_plan = ''
  if product != blank
    for pv in product.variants
      if bf_q_variant != blank
        break
      endif
      for alloc in pv.selling_plan_allocations
        assign bf_n = alloc.selling_plan.name | downcase
        if bf_n contains '3-month' or bf_n contains '3 month' or bf_n contains 'quarter'
          if pv.available
            assign bf_q_variant = pv.id
            assign bf_q_plan = alloc.selling_plan.id
            break
          endif
        endif
      endfor
    endfor
  endif
-%}
<a class="mc-bfx" id="mc-bfx" href="#MainContent" role="button"
  data-variant="{{ bf_q_variant }}" data-plan="{{ bf_q_plan }}"
  aria-label="Black Friday: 3 months for £99, save 53%, plus a welcome kit worth £87. Ends 30 November. Claim: adds the 3-month plan and goes to checkout.">
  <span class="mc-bfx__dot" aria-hidden="true"></span>
  <span class="mc-bfx__d"><b>Black Friday:</b> 3 months for £99 (save 53%) + welcome kit worth £87</span>
  <span class="mc-bfx__d mc-bfx__sep" aria-hidden="true">·</span>
  <span class="mc-bfx__d">Ends 30 Nov</span>
  <span class="mc-bfx__m"><b>3 months for £99</b> · Save 53%</span>
  <span class="mc-bfx__sep mc-bfx__sep--cta" aria-hidden="true">·</span>
  <span class="mc-bfx__cta"><span class="mc-bfx__spin" aria-hidden="true"></span>Claim&nbsp;&rarr;</span>
</a>
{{ 'muto-bf-layout.css' | asset_url | stylesheet_tag }}
{{ 'muto-bf-type.css' | asset_url | stylesheet_tag }}
<script src="{{ 'muto-bf-layout.js' | asset_url }}" defer="defer"></script>
<style>
/* Buy box copy: left-aligned at every width; a short descriptor and a Black Friday line under the name
   (they replace the collaboration line and the Black Friday box); no "Choose your plan" heading */
html body .mc .mc__buy-copy > .mc__rating{justify-content:flex-start!important}
html body .mc .mc__buy-copy > .mc__rating,html body .mc .mc__buy-copy > .mc__eyebrow,
html body .mc .mc__buy-copy > .mc__buy-title,html body .mc .mc__buy-copy > .mc-subhead{text-align:left!important}
html body .mc .mc-collab,html body .mc .mc-bf,html body .mc .mc__trust{display:none!important}
html body .mc .mc__buy-copy > .mc-bfline{order:0}
html body .mc .mc-bfline{display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px 6px;width:fit-content;max-width:100%;margin:12px 0 4px;padding:8px 12px;
  border-radius:8px;background:#c9ffb7;color:#242223;font-size:14px;font-weight:500;line-height:1.3}
html body .mc .mc-bfline b{font-weight:600}
@media (max-width:749px){html body .mc .mc-bfline{margin-top:10px;padding:7px 10px;font-size:13px}}
/* 3-month plan: £99, £210 struck through */
html body .mc .mc__plans > label.mc__plan:nth-of-type(2) .mc__plan-prices::before{content:"£99"}
html body .mc .mc__plans > label.mc__plan:nth-of-type(2) .mc__plan-prices::after{content:"£210"}
</style>
<script>
/* Descriptor, Black Friday line, and plan names ("3-Month Supply", "1-Month Supply") */
(function () {
  var sub = document.querySelector('.mc .mc-subhead');
  if (sub) {
    sub.textContent = 'Five supplements in one daily jar, built for your 40s and 50s.';
    if (!document.querySelector('.mc .mc-bfline')) {
      var p = document.createElement('p');
      p.className = 'mc-bfline';
      p.innerHTML = '<b>Black Friday:</b> 3 months for £99 <span aria-hidden="true">·</span> Ends 30 Nov';
      sub.insertAdjacentElement('afterend', p);
    }
  }
  [].forEach.call(document.querySelectorAll('.mc .mc__plans > label.mc__plan'), function (c) {
    var n = c.querySelector('.mc__plan-name');
    if (!n) return;
    var t = n.textContent;
    var r = /quarter|3.?month/i.test(t) ? '3-Month Supply' : /month/i.test(t) ? '1-Month Supply' : '';
    if (r) { n.textContent = r; c.setAttribute('data-name', r); }
  });
})();
</script>
<script>
/* One-time purchase: plain text line, "One-Time Purchase - £70 (no gifts)", the price kept from the product */
(function () {
  var b = document.querySelector('.mc .mc__onetime');
  if (!b) return;
  var t = b.querySelector('span') || b;
  var m = (t.textContent || '').match(/£\s?[\d.,]+/);
  t.textContent = 'One-Time Purchase - ' + (m ? m[0].replace(/\s/g, '') : '£70') + ' (no gifts)';
})();
</script>
