{%- comment -%}
  MUTO Home — the science.

  Artboard: two mirrored bands. NAD+ puts its three-line 64px heading and 566×454
  dark panel on the left with the tab pill and copy on the right; Creatine flips
  the whole thing. One section with a "Flip" setting, placed twice.

  BLOCKS. Each "Panel" block is a tab with its own title, copy and action. The
  artboard draws five — What it does, How it works, Formula, Who it's for,
  Protocol — with only the first written; the rest ship as empty panels waiting
  for their copy, which is why they are blocks rather than fixed markup.

  With no JS every panel renders in document order rather than four of the five
  being silently unreachable.

  MOBILE: always heading → panel → tabs → copy. A mirrored layout at 390px is
  just two columns of one.
{%- endcomment -%}

{{ 'muto-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'muto-home.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign mh_spt = section.settings.space_top | default: 100 | times: 0.01
  assign mh_spb = section.settings.space_bottom | default: 100 | times: 0.01
  assign heading_id = 'mh-science-' | append: section.id
  assign panels = section.blocks | where: 'type', 'panel'
-%}

<style>
  /* The theme's list reset (ul{margin:0}) outranks the panel's own "> * + *" gap,
     so a list sat flush under the paragraph above it. */
  #shopify-section-{{ section.id }} .mh__science-text > * + *{margin-top:16px}
  #shopify-section-{{ section.id }} .mh__science-text li + li{margin-top:14px}
</style>

<div class="mh" data-mh style="--mh-spt:{{ mh_spt }};--mh-spb:{{ mh_spb }}">
  <div class="mh__wrap">
    <section
      class="mh__science{% if section.settings.flip %} mh__science--flip{% endif %}"
      aria-labelledby="{{ heading_id }}"
      data-mh-tabs
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="mh__h2 mh__science-head" id="{{ heading_id }}">
          {{- section.settings.heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="mh__lede mh__science-lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      <div class="mh__science-grid">
        <div class="mh__science-panel">
          {% render 'muto-image',
            image: section.settings.image,
            fallback: section.settings.image_fallback,
            alt: section.settings.image_alt,
            placeholder: false,
            ratio: '566/454',
            sizes: '(min-width: 990px) 566px, 92vw',
            widths: '430,566,860,1132' %}
        </div>

        <div class="mh__science-copy">
          {%- if panels.size > 1 -%}
            <div class="mh__tabs mh__science-tabs" role="tablist" aria-label="{{ section.settings.tablist_label | default: 'Choose a topic' | escape }}">
              {%- for panel in panels -%}
                <button
                  class="mh__tab"
                  type="button"
                  role="tab"
                  id="{{ section.id }}-tab-{{ panel.id }}"
                  aria-controls="{{ section.id }}-panel-{{ panel.id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-mh-tab
                  {{ panel.shopify_attributes }}
                >{{ panel.settings.label }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- for panel in panels -%}
            <div
              class="mh__panel"
              id="{{ section.id }}-panel-{{ panel.id }}"
              role="tabpanel"
              tabindex="0"
              aria-labelledby="{{ section.id }}-tab-{{ panel.id }}"
            >
              {%- if panel.settings.title != blank -%}
                <h3 class="mh__h3 mh__science-title">{{ panel.settings.title | escape | newline_to_br }}</h3>
              {%- endif -%}
              {%- if panel.settings.text != blank -%}
                <div class="mh__body mh__science-text">{{ panel.settings.text }}</div>
              {%- endif -%}
              {%- if panel.settings.cta_label != blank -%}
                <a class="mh__btn mh__btn--cyan" href="{{ panel.settings.cta_link | default: routes.all_products_collection_url }}">
                  {{- panel.settings.cta_label -}}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "MUTO Home — Science",
  "tag": "section",
  "class": "mh-section",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "flip", "label": "Mirror the layout", "default": false, "info": "Heading and panel on the right, tabs and copy on the left. The artboard flips the Creatine band." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The science:\nNAD+ Cellular\nComplex" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "What's happening beneath the surface, and why it shows up in the numbers you already track." },
    { "type": "text", "id": "tablist_label", "label": "Tab group label", "default": "Choose a topic", "info": "Read by screen readers, not shown." },
    { "type": "header", "content": "Panel image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_fallback", "label": "Fallback image URL" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Required once an image is set. The artboard leaves this frame empty." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel (tab)",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "What it does" },
        { "type": "textarea", "id": "title", "label": "Title", "default": "What it does" },
        { "type": "richtext", "id": "text", "label": "Copy", "info": "Paragraphs and bullet lists. Two of these panels are a lead paragraph, a list and a closing line." },
        { "type": "text", "id": "cta_label", "label": "Button" },
        { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the all-products collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUTO Home — Science",
      "blocks": [
        {
          "type": "panel",
          "settings": { "label": "What it does", "title": "What it does", "text": "<p>MUTO NAD+ Cellular Complex supports the cellular system underneath your energy and recovery: the one your wearable reports on every morning but can't see. It's designed for energy that holds through the day, recovery between sessions, and the repair work your cells run overnight. Two capsules, 19 ingredients, one daily protocol.</p>", "cta_label": "Start your 90 days" }
        },
        {
          "type": "panel",
          "settings": { "label": "How it works", "title": "How it works" }
        },
        {
          "type": "panel",
          "settings": { "label": "Formula", "title": "Formula" }
        },
        {
          "type": "panel",
          "settings": { "label": "Who it's for", "title": "Who it's for" }
        },
        {
          "type": "panel",
          "settings": { "label": "Protocol", "title": "Protocol" }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}

