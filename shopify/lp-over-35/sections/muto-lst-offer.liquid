{%- comment -%}
  MUTO listicle — offer (muto-lst-offer). The PDP buy box, simplified: kit photo beside a box with the two
  plans, the free welcome kit for the chosen plan, the guarantee and Add to cart. Use it on a product
  template (templates/product.lp-over-35.json), so prices, plans and the add to cart are this product's own.

  Plans are found by SKU (default NAD-3M-Month1 and NAD-1M-Month1) and each variant's subscription plan, so
  the price, the struck-out price and "Save x%" come off the product, never typed. Add to cart posts the
  variant and selling plan to /cart/add, opens the side cart and tells the theme the cart changed, which
  is what adds the free welcome gifts (custom.js). With no script it's a plain form post to the cart.
  The kit rows are blocks: name, value, picture and which plan they come with.
{%- endcomment -%}
{{ 'muto-lst.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign v3 = blank
  assign v1 = blank
  if product != blank
    assign v3 = product.variants | where: 'sku', s.sku_3m | first
    assign v1 = product.variants | where: 'sku', s.sku_1m | first
  endif
  assign a3 = blank
  assign a1 = blank
  if v3 != blank
    assign a3 = v3.selling_plan_allocations | first
  endif
  if v1 != blank
    assign a1 = v1.selling_plan_allocations | first
  endif

  assign kit3 = 0
  assign kit1 = 0
  for block in section.blocks
    assign p = block.settings.plans
    if p == 'both' or p == '3'
      assign kit3 = kit3 | plus: block.settings.value
    endif
    if p == 'both' or p == '1'
      assign kit1 = kit1 | plus: block.settings.value
    endif
  endfor

  if s.image != blank
    assign o_src = s.image | image_url: width: 1400
  else
    assign o_src = s.image_url
  endif
  assign fid = 'mlst-' | append: section.id
-%}
<div class="mlst">
  <section class="mlst-offer" id="{{ fid }}" aria-labelledby="{{ fid }}-h">
    <div class="mlst-offer__wrap">
      {%- if s.eyebrow != blank -%}<p class="mlst__lab mlst__lab--dot">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="mlst-offer__h" id="{{ fid }}-h">{{ s.heading }}</h2>
      <div class="mlst-offer__grid">
        {%- if o_src != blank -%}
          <div class="mlst-offer__media"><img src="{{ o_src }}" alt="{{ s.image_alt | escape }}" width="1400" height="1050" loading="lazy"></div>
        {%- endif -%}

        {%- if a3 == blank and a1 == blank -%}
          {%- if request.design_mode -%}
            <p class="mlst-box">MUTO listicle — offer: no plans found. Use this on the NAD+ Cellular Complex product template, with variants whose SKUs are "{{ s.sku_3m }}" and "{{ s.sku_1m }}".</p>
          {%- endif -%}
        {%- else -%}
          {%- liquid
            if a3 != blank
              assign first_v = v3
              assign first_a = a3
            else
              assign first_v = v1
              assign first_a = a1
            endif
          -%}
          <form class="mlst-box" action="{{ routes.cart_add_url }}" method="post" data-mlst-form>
            <input type="hidden" name="id" value="{{ first_v.id }}">
            <input type="hidden" name="selling_plan" value="{{ first_a.selling_plan.id }}">
            <input type="hidden" name="quantity" value="1">
            <p class="mlst-box__title">{{ s.title | default: product.title }}</p>
            {%- if s.rating != blank -%}
              <p class="mlst-box__rate"><span class="mlst-stars" aria-hidden="true">★★★★★</span>{{ s.rating }}</p>
            {%- endif -%}

            <fieldset class="mlst-plans">
              <legend class="visually-hidden">Choose your plan</legend>
              {%- for k in (1..2) -%}
                {%- liquid
                  if k == 1
                    assign pv = v3
                    assign pa = a3
                    assign pkey = '3'
                    assign pname = s.name_3m
                    assign psub = s.sub_3m
                    assign ptag = s.tag_3m
                    assign months = 3
                    assign kit_total = kit3
                  else
                    assign pv = v1
                    assign pa = a1
                    assign pkey = '1'
                    assign pname = s.name_1m
                    assign psub = s.sub_1m
                    assign ptag = ''
                    assign months = 1
                    assign kit_total = kit1
                  endif
                -%}
                {%- if pa != blank -%}
                  {%- liquid
                    assign now = pa.price
                    assign was = pa.compare_at_price
                    if was == blank or was <= now
                      assign was = pv.compare_at_price
                    endif
                    assign save = 0
                    if was != blank and was > now
                      assign save = was | minus: now | times: 100 | divided_by: was
                    endif
                    assign per = now | divided_by: months
                    assign now_s = now | money_without_trailing_zeros | strip_html
                  -%}
                  <label class="mlst-plan{% if forloop.first %} is-on{% endif %}" data-key="{{ pkey }}" data-variant="{{ pv.id }}" data-plan="{{ pa.selling_plan.id }}" data-price="{{ now_s | escape }}" data-kit="£{{ kit_total }}">
                    <input type="radio" name="mlst-plan-{{ section.id }}" value="{{ pkey }}"{% if forloop.first %} checked{% endif %}>
                    <span class="mlst-plan__dot" aria-hidden="true"></span>
                    <span>
                      <span class="mlst-plan__name">{{ pname }}</span>
                      <span class="mlst-plan__sub">{% if months > 1 %}{{ per | money_without_trailing_zeros }} a month · {% endif %}{{ psub }}</span>
                    </span>
                    <span class="mlst-plan__price">
                      <span class="mlst-plan__now">{{ now_s }}</span>
                      {%- if save > 0 -%}<span class="mlst-plan__was">{{ was | money_without_trailing_zeros }}</span>{%- endif -%}
                    </span>
                    {%- if ptag != blank or save > 0 -%}
                      <span class="mlst-plan__tag">{% if ptag != blank %}{{ ptag }}{% if save > 0 %} · {% endif %}{% endif %}{% if save > 0 %}Save {{ save }}%{% endif %}</span>
                    {%- endif -%}
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </fieldset>

            {%- if section.blocks.size > 0 -%}
              <div class="mlst-kit">
                <p class="mlst-kit__h"><span class="mlst__lab">{{ s.kit_label }}</span><span class="mlst__lab" data-mlst-kit-total>Worth £{% if a3 != blank %}{{ kit3 }}{% else %}{{ kit1 }}{% endif %}</span></p>
                <ul class="mlst-kit__list">
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign g = block.settings
                      if g.image != blank
                        assign g_src = g.image | image_url: width: 120
                      else
                        assign g_src = g.image_url
                      endif
                      assign g_hide = false
                      if a3 != blank and g.plans == '1'
                        assign g_hide = true
                      elsif a3 == blank and g.plans == '3'
                        assign g_hide = true
                      endif
                    -%}
                    <li data-plans="{{ g.plans }}"{% if g_hide %} hidden{% endif %} {{ block.shopify_attributes }}>
                      {%- if g_src != blank -%}<img src="{{ g_src }}" alt="" width="40" height="48" loading="lazy">{%- else -%}<span></span>{%- endif -%}
                      <span>{{ g.name }}</span>
                      <span class="mlst-kit__v">{% if g.value > 0 %}<s>£{{ g.value }}</s>{% endif %}<b>{{ g.note | default: 'Free' }}</b></span>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <button type="submit" class="mlst-cta" data-mlst-cta>
              <span class="mlst-cta__spin" aria-hidden="true"></span>
              <span>{{ s.cta | default: 'Add to cart' }} · <span data-mlst-price>{{ first_a.price | money_without_trailing_zeros }}</span></span>
            </button>
            <p class="mlst-err" role="alert" hidden data-mlst-err>Something went wrong adding that. Please try again.</p>

            {%- if s.guarantee != blank -%}
              <div class="mlst-guar"><span class="mlst-guar__badge" aria-hidden="true">90</span><p>{{ s.guarantee }}</p></div>
            {%- endif -%}
            {%- assign ticks = s.ticks | newline_to_br | split: '<br />' -%}
            {%- if s.ticks != blank -%}
              <ul class="mlst-ticks">
                {%- for t in ticks -%}{%- assign t = t | strip -%}{%- if t != blank -%}
                  <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg><span>{{ t }}</span></li>
                {%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
          </form>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
<script>
(function () {
  var root = document.getElementById({{ fid | json }});
  var form = root && root.querySelector('[data-mlst-form]');
  if (!form || form.getAttribute('data-ready')) return;
  form.setAttribute('data-ready', '1');
  var plans = [].slice.call(form.querySelectorAll('.mlst-plan'));
  var cta = form.querySelector('[data-mlst-cta]'), err = form.querySelector('[data-mlst-err]');
  var cart = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';

  function pick(label) {
    plans.forEach(function (p) { p.classList.toggle('is-on', p === label); });
    form.elements.id.value = label.getAttribute('data-variant');
    form.elements.selling_plan.value = label.getAttribute('data-plan');
    var price = form.querySelector('[data-mlst-price]'); if (price) price.textContent = label.getAttribute('data-price');
    var key = label.getAttribute('data-key');
    [].forEach.call(form.querySelectorAll('.mlst-kit__list li'), function (li) {
      var p = li.getAttribute('data-plans'); li.hidden = !(p === 'both' || p === key);
    });
    var tot = form.querySelector('[data-mlst-kit-total]'); if (tot) tot.textContent = 'Worth ' + label.getAttribute('data-kit');
  }
  plans.forEach(function (p) { p.querySelector('input').addEventListener('change', function () { pick(p); }); });

  /* Open the side cart the way the theme's own Add to cart does (assets/product-form.js), then announce the
     cart update: custom.js listens for it and adds the free welcome gifts for the plan. */
  function announce(res) {
    function fire() { try { if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') publish(PUB_SUB_EVENTS.cartUpdate, { source: 'muto-lst-offer', productVariantId: form.elements.id.value, cartData: res }); } catch (e) {} }
    var ready = false;
    try { ready = typeof subscribers !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined' && (subscribers[PUB_SUB_EVENTS.cartUpdate] || []).length > 0; } catch (e) {}
    if (ready || document.readyState === 'complete') fire(); else window.addEventListener('load', function () { setTimeout(fire, 0); }, { once: true });
  }
  function done() { cta.removeAttribute('aria-busy'); cta.disabled = false; }
  function fallback() { form.setAttribute('data-native', '1'); form.submit(); }

  form.addEventListener('submit', function (e) {
    if (form.getAttribute('data-native') || !window.fetch) return;
    e.preventDefault();
    if (cta.getAttribute('aria-busy')) return;
    cta.setAttribute('aria-busy', 'true'); cta.disabled = true; err.hidden = true;
    var item = { id: parseInt(form.elements.id.value, 10), quantity: 1 };
    if (form.elements.selling_plan.value) item.selling_plan = parseInt(form.elements.selling_plan.value, 10);
    fetch(cart + 'cart/add.js', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [item], sections: 'cart-drawer,cart-icon-bubble', sections_url: window.location.pathname })
    }).then(function (r) { return r.ok ? r.json() : null; }).then(function (res) {
      if (!res) { done(); err.hidden = false; return; }
      var d = document.querySelector('cart-drawer');
      if (d && typeof d.renderContents === 'function' && res.sections && res.sections['cart-drawer']) {
        d.classList.remove('is-empty');
        var items = d.querySelector('cart-drawer-items'); if (items) items.classList.remove('is-empty');
        d.renderContents(res);
        d.classList.remove('is-empty');
        announce(res);
        done();
      } else {
        window.location.href = cart + 'cart';
      }
    }).catch(function () { done(); fallback(); });
  });
})();
</script>

{% schema %}
{
  "name": "MUTO listicle — offer",
  "tag": "section",
  "class": "muto-lst-offer",
  "settings": [
    { "type": "paragraph", "content": "The PDP buy box, simplified. Use on the NAD+ Cellular Complex product template: plans, prices and Add to cart come from the product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New customer offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it for 90 days, risk-free" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL", "info": "Used when no image is picked" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "title", "label": "Product name", "info": "Blank: the product's title" },
    { "type": "text", "id": "rating", "label": "Rating line", "default": "4.8/5 from customer reviews" },
    { "type": "header", "content": "Plans" },
    { "type": "text", "id": "sku_3m", "label": "3-month variant SKU", "default": "NAD-3M-Month1" },
    { "type": "text", "id": "name_3m", "label": "3-month name", "default": "3 months" },
    { "type": "text", "id": "sub_3m", "label": "3-month line", "default": "Delivered every 3 months" },
    { "type": "text", "id": "tag_3m", "label": "3-month tag", "default": "Best value" },
    { "type": "text", "id": "sku_1m", "label": "Monthly variant SKU", "default": "NAD-1M-Month1" },
    { "type": "text", "id": "name_1m", "label": "Monthly name", "default": "1 month" },
    { "type": "text", "id": "sub_1m", "label": "Monthly line", "default": "Delivered every month" },
    { "type": "header", "content": "Below the plans" },
    { "type": "text", "id": "kit_label", "label": "Kit heading", "default": "Free welcome kit" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Add to cart" },
    { "type": "text", "id": "guarantee", "label": "Guarantee", "default": "Feel the difference in 90 days, or get every payment back." },
    { "type": "textarea", "id": "ticks", "label": "Ticks", "info": "One per line", "default": "Skip, pause or cancel online anytime\nFree delivery" }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Kit item",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "number", "id": "value", "label": "Worth (£)", "default": 10 },
        { "type": "text", "id": "note", "label": "Instead of 'Free'", "info": "e.g. Free entry" },
        { "type": "select", "id": "plans", "label": "Comes with", "default": "both", "options": [
          { "value": "both", "label": "Both plans" },
          { "value": "3", "label": "3 months only" },
          { "value": "1", "label": "Monthly only" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL", "info": "Used when no image is picked" }
      ]
    }
  ],
  "presets": [{ "name": "MUTO listicle — offer" }]
}
{% endschema %}
