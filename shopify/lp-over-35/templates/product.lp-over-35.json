    "art1": {
      "type": "muto-lst-article",
      "blocks": {
        "r1": {
          "type": "reason",
          "settings": {
            "number": "1",
            "title": "What you needed at 20 isn’t what you need after 35",
            "image_url": "https://cdn.shopify.com/s/files/1/0976/2724/2843/files/about-pillar-ageing-core.jpg",
            "image_alt": "An athlete's midsection in low gym light",
            "body": "<p>Your body starts to change in your mid-30s. Afternoons feel harder than they used to, and you get less back from the same effort.</p><p>NAD+ Cellular Complex is made for adults over 35. That’s when your body starts to change, and when most of our customers start taking it. You don’t need to be sporty or own a smartwatch.</p>",
            "pull": "Your body changes in mid-life. NAD+ Cellular Complex is the daily foundation built for it."
          }
        },
        "r2": {
          "type": "reason",
          "settings": {
            "number": "2",
            "title": "Every dose on the label, and the science behind it",
            "image_url": "https://cdn.shopify.com/s/files/1/0976/2724/2843/files/about-made-declared.jpg",
            "image_alt": "NAD+ Cellular Complex label showing every dose",
            "body": "<p>19 ingredients in two capsules, with every dose printed on the label. No proprietary blends, no fillers, no stimulants.</p><ul><li><strong>Made in the UK</strong> in GMP- and ISO-certified facilities, and every batch tested by an independent lab.</li><li><strong>A scientific advisory board</strong> that includes England Rugby’s Lead Performance Nutritionist, longevity doctors and a leading metabolism researcher. Six doctors and scientists review the formula.</li><li><strong>Rated 4.8</strong> from 103 customer reviews.</li></ul>",
            "pull": ""
          }
        },
        "r3": {
          "type": "reason",
          "settings": {
            "number": "3",
            "title": "Energy, recovery and longevity, in one",
            "image_url": "https://cdn.shopify.com/s/files/1/0976/2724/2843/files/home-benefits-nad.jpg",
            "image_alt": "The MUTO NAD+ Cellular Complex jar of capsules beside its carton",
            "body": "<p>One comprehensive multi-nutrient with NAD+ support for over 35s, taken with breakfast.</p><ul><li><strong>Energy:</strong> afternoons that hold.*</li><li><strong>Recovery:</strong> bounce back from a busy week.</li><li><strong>Longevity:</strong> support for your cells as you age.</li></ul>",
            "pull": ""
          }
        }
      },
