<style>
  #shopify-section-{{ section.id }} .custom-faqs-wrapper {
    padding-top: {{section.settings.padding_top}}px;
    padding-bottom: {{section.settings.padding_bottom}}px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .custom-faqs-wrapper[id] {
    scroll-margin-top: 72px;
  }
  #shopify-section-{{ section.id }} .accordion__content p + p,
  #shopify-section-{{ section.id }} .accordion__content p + ol,
  #shopify-section-{{ section.id }} .accordion__content ol + p {
    margin-top: 12px;
  }
  #shopify-section-{{ section.id }} .accordion__content ol {
    margin: 12px 0 0;
    padding-left: 20px;
  }
  #shopify-section-{{ section.id }} .accordion__content ol li + li {
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .accordion__content a {
    color: currentColor;
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .custom-faqs-html {
    margin-top: 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }} .custom-faqs-html table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .custom-faqs-html th,
  #shopify-section-{{ section.id }} .custom-faqs-html td {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid rgba(var(--dark-rgb), 0.15);
  }
  #shopify-section-{{ section.id }} .custom-faqs-html th {
    font-weight: 600;
    border-bottom-color: rgba(var(--dark-rgb), 0.4);
  }
  #shopify-section-{{ section.id }} .custom-faqs-html td:nth-child(3),
  #shopify-section-{{ section.id }} .custom-faqs-html td:nth-child(4) {
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .custom-faqs-html p {
    margin-top: 12px;
    font-size: 13px;
  }
</style>

<div
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handle }}"{% endif %}
  class="custom-faqs-wrapper page-width {{ section.settings.custom_class }}"
  style="background-color: {{ section.settings.bg_color }};"
>
    {% if section.settings.heading != blank %}
      <div class="custom-faqs-heading">
        <h2>{{- section.settings.heading -}}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
        <div class="custom-faqs-inner">
            {% for block in section.blocks %}
                <details id="Details-{{ block.id }}-{{ section.id }}" {{ block.shopify_attributes }}>
                    <summary id="Summary-{{ block.id }}-{{ section.id }}">
                        <h3 class="accordion__title">
                            {{- block.settings.heading -}}
                        </h3>
                        <button
                          class="accordion__button"
                          aria-label="Read full details"
                        >
                            {{- 'custom-icon-arrow-down.svg' | inline_asset_content -}}
                        </button>
                    </summary>
                    <div class="accordion__content" role="region" aria-labelledby="Summary-{{ block.id }}-{{ section.id }}">
                        {{- block.settings.content -}}
                        {%- if block.settings.content_html != blank -%}
                          <div class="custom-faqs-html">{{- block.settings.content_html -}}</div>
                        {%- endif -%}
                    </div>
                </details>
            {% endfor %}
        </div>
    {% endif %}

    {% if section.settings.bottom_text != blank %}
      <div class="custom-faqs-bottom">
        {{- section.settings.bottom_text -}}
      </div>
    {% endif %}
</div>

{% schema %}
{
  "name": "Custom FAQs",
  "class": "custom-faqs",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAFAFA"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other pages link straight to this category, e.g. 'guarantee' for /pages/faqs#guarantee"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading Text"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom Text"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Faq",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "html",
          "id": "content_html",
          "label": "Extra HTML (optional)",
          "info": "Shown below the content, e.g. a table"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQs"
    }
  ]
}
{% endschema %}
