{%- comment -%}
  MUTO — Our standards.
  A headline and one paragraph, then the standards as a list on the left. The
  selected one fills in teal; its promise and "how to check" sit beside one
  photograph on the right, pinned while the list scrolls past. Clicking another item swaps them in place.

  BLOCKS, one per standard, so a standard can be added, reworded or dropped
  without a code change.

  With no JS every panel renders, so nothing is unreachable. MOBILE: the list
  becomes a row of chips you swipe, with the selected standard underneath.
{%- endcomment -%}
{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = section.id
  assign items = section.blocks | where: 'type', 'standard'
-%}
<style>
  /* Theme h1–h3 rules set their own font; headings here use the site's display face and weight */
  #shopify-section-{{ sid }} h1,#shopify-section-{{ sid }} h2,#shopify-section-{{ sid }} h3{font-family:var(--mc-font);font-weight:500;-webkit-font-smoothing:antialiased}
  #shopify-section-{{ sid }} .ms{padding-top:{{ section.settings.space_top }}px;padding-bottom:{{ section.settings.space_bottom }}px}
  #shopify-section-{{ sid }} .ms__head{max-width:1080px}
  #shopify-section-{{ sid }} .ms__lede{margin-top:20px;max-width:760px;font-size:20px;line-height:1.4;color:var(--mc-ink)}
  #shopify-section-{{ sid }} .ms__grid{display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:48px;margin-top:88px;align-items:start}
  #shopify-section-{{ sid }} .ms__list{list-style:none;margin:0;padding:0}
  #shopify-section-{{ sid }} .ms__list li + li{border-top:1px solid var(--mc-hair)}
  #shopify-section-{{ sid }} .ms__tab{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:14px;width:100%;min-height:96px;padding:24px 22px;border-radius:8px;cursor:pointer;font-family:var(--mc-font);font-size:20px;line-height:1.2;color:var(--mc-ink);transition:background var(--mc-dur) var(--mc-ease),color var(--mc-dur) var(--mc-ease)}
  #shopify-section-{{ sid }} .ms__tab:hover{background:var(--mc-sage)}
  #shopify-section-{{ sid }} .ms__tab:focus-visible{outline:2px solid var(--mc-ink);outline-offset:2px}
  #shopify-section-{{ sid }} .ms__tab[aria-selected="true"]{background:var(--mc-ink);color:#fff}
  #shopify-section-{{ sid }} .ms__num{font-family:var(--mc-mono);font-size:13px;letter-spacing:.04em;opacity:.6;min-width:22px}
  #shopify-section-{{ sid }} .ms__stage{position:sticky;top:{{ section.settings.sticky_top }}px}
  #shopify-section-{{ sid }} .ms__panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:start}
  #shopify-section-{{ sid }} .ms__panel[hidden]{display:none}
  #shopify-section-{{ sid }} .ms__card{display:flex;flex-direction:column;gap:20px;padding-top:8px}
  #shopify-section-{{ sid }} .ms__card-h{font-weight:500;font-size:clamp(28px,2.6vw,40px);line-height:1.05;letter-spacing:-.01em;text-transform:uppercase}
  #shopify-section-{{ sid }} .ms__card-t{font-size:18px;line-height:1.45}
  #shopify-section-{{ sid }} .ms__check{margin-top:8px;padding-top:16px;border-top:1px solid var(--mc-hair);font-size:15px;line-height:1.4}
  #shopify-section-{{ sid }} .ms__check b{display:block;margin-bottom:6px;font-family:var(--mc-mono);font-weight:400;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
  #shopify-section-{{ sid }} .ms__check a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  #shopify-section-{{ sid }} .ms__img{position:relative;aspect-ratio:4/5;border-radius:8px;overflow:hidden;background:var(--mc-mint)}
  #shopify-section-{{ sid }} .ms__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @media (max-width:989px){
    #shopify-section-{{ sid }} .ms__grid{grid-template-columns:1fr;gap:24px;margin-top:48px}
    #shopify-section-{{ sid }} .ms__list{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding:0 var(--mc-gutter,20px);margin:0 calc(-1 * var(--mc-gutter,20px));padding:0 var(--mc-gutter,20px) 4px;scrollbar-width:none}
    #shopify-section-{{ sid }} .ms__list::-webkit-scrollbar{display:none}
    #shopify-section-{{ sid }} .ms__list li{flex:0 0 auto;scroll-snap-align:start}
    #shopify-section-{{ sid }} .ms__list li + li{border-top:0}
    #shopify-section-{{ sid }} .ms__tab{min-height:48px;padding:12px 16px;font-size:16px;white-space:nowrap;border:1px solid var(--mc-hair);border-radius:24px}
    #shopify-section-{{ sid }} .ms__tab[aria-selected="true"]{border-color:var(--mc-ink)}
    #shopify-section-{{ sid }} .ms__stage{position:static}
    #shopify-section-{{ sid }} .ms__panel{grid-template-columns:1fr;gap:24px}
    #shopify-section-{{ sid }} .ms__card{padding-top:0}
    #shopify-section-{{ sid }} .ms__card-h{font-size:24px}
    #shopify-section-{{ sid }} .ms__img{aspect-ratio:4/3}
    #shopify-section-{{ sid }} .ms__lede{font-size:17px}
  }
  @media (prefers-reduced-motion:reduce){#shopify-section-{{ sid }} .ms__tab{transition:none}}
</style>

<div class="mc ms" data-ms>
  <div class="mc__wrap">
    <header class="ms__head">
      <h1 class="mc__h2">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- if section.settings.lede != blank -%}<p class="ms__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </header>

    {%- if items.size > 0 -%}
      <div class="ms__grid">
        <ul class="ms__list" role="tablist" aria-label="{{ section.settings.list_label | escape }}">
          {%- for block in items -%}
            <li role="presentation">
              <button type="button" class="ms__tab" role="tab" id="ms-tab-{{ block.id }}" aria-controls="ms-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
                <span class="ms__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ block.settings.title }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <div class="ms__stage">
          {%- for block in items -%}
            <div class="ms__panel" role="tabpanel" id="ms-panel-{{ block.id }}" aria-labelledby="ms-tab-{{ block.id }}" data-ms-panel {{ block.shopify_attributes }}>
              <div class="ms__card">
                <h2 class="ms__card-h">{{ block.settings.title }}</h2>
                <div class="ms__card-t">{{ block.settings.text }}</div>
                {%- if block.settings.check != blank -%}
                  <div class="ms__check"><b>How to check</b>{{ block.settings.check }}</div>
                {%- endif -%}
              </div>
              {%- for n in (1..1) -%}
                {%- liquid
                  assign img_key = 'image_' | append: n
                  assign fb_key = 'image_' | append: n | append: '_fallback'
                  assign img = block.settings[img_key]
                  assign fb = block.settings[fb_key]
                -%}
                {%- if img != blank or fb != blank -%}
                  <div class="ms__img">
                    {%- if img != blank -%}
                      {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: '' }}
                    {%- else -%}
                      <img src="{{ fb }}" alt="" loading="lazy" width="900" height="1200">
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ sid }} [data-ms]');
    if (!root) return;
    var tabs = [].slice.call(root.querySelectorAll('.ms__tab'));
    var panels = [].slice.call(root.querySelectorAll('[data-ms-panel]'));
    var list = root.querySelector('.ms__list');
    function show(i, focus, scroll) {
      tabs.forEach(function (t, n) {
        var on = n === i;
        t.setAttribute('aria-selected', on);
        t.tabIndex = on ? 0 : -1;
        panels[n].hidden = !on;
      });
      if (focus) tabs[i].focus();
      /* Only on a tap or key press, and only the chip row: never the page */
      if (scroll && list.scrollWidth > list.clientWidth) {
        var t = tabs[i], pad = 20;
        var left = t.offsetLeft - list.offsetLeft - pad;
        if (t.offsetLeft + t.offsetWidth > list.scrollLeft + list.clientWidth || t.offsetLeft < list.scrollLeft + pad) list.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
      }
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { show(i, false, true); });
      t.addEventListener('keydown', function (e) {
        var k = e.key, n = null;
        if (k === 'ArrowDown' || k === 'ArrowRight') n = (i + 1) % tabs.length;
        if (k === 'ArrowUp' || k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        if (n !== null) { e.preventDefault(); show(n, true, true); }
      });
    });
    show(0);
    /* Theme editor: selecting a block shows its standard */
    document.addEventListener('shopify:block:select', function (e) {
      var i = panels.indexOf(e.target);
      if (i > -1) show(i);
    });
  })();
</script>

{% schema %}
{
  "name": "MUTO — Our standards",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Our standards" },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "text", "id": "list_label", "label": "List label (screen readers)", "default": "Our standards" },
    { "type": "range", "id": "sticky_top", "label": "Pinned photo: distance from top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Every dose on the label" },
        { "type": "richtext", "id": "text", "label": "What it means" },
        { "type": "richtext", "id": "check", "label": "How to check" },
        { "type": "image_picker", "id": "image_1", "label": "Photo" },
        { "type": "text", "id": "image_1_fallback", "label": "Photo 1 URL (if no photo picked)" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "MUTO — Our standards" }],
  "enabled_on": { "templates": ["page", "index"] }
}
{% endschema %}
