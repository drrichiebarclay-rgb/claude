{%- comment -%}
  MUTO Creatine — same molecule, higher standard.

  Artboard band 7430–8620 of CREATINE.pdf. A two-line 64px heading at x24, then
  a seven-row comparison: claims at x24 in 25px, and four columns centred on
  602.5 / 845.5 / 1088.5 / 1331.5 on a 100 row pitch. MUTO's column sits on a
  169×715 translucent panel starting under its own heading.

  A real <table> with a caption, scoped headers and a text alternative in every
  cell: a row of ticks read out as "tick tick cross" says nothing about which
  column is which.

  BLOCKS, one per claim, so a line can be added, edited, reordered or dropped.
  The comparison is four columns by design — the artboard's — so the column
  names are settings rather than blocks. "Group label" blocks split a long
  table into named runs of rows.

  DENSITY: "Spacious" is the artboard. "Compact" is for longer tables: shorter
  rows, smaller type and marks, and a hairline between rows so each claim can be
  read across to its marks. Its styles are scoped to this section.

  MOBILE: the same table, with the claims column pinned and the four verdict
  columns scrolling under it. It was a second card list per claim; that put the
  whole comparison on the page twice, and a claim you have scrolled away from is
  exactly the thing you need to still see.
{%- endcomment -%}

{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
<script src="{{ 'muto-crea.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign spt = section.settings.space_top | default: 100 | times: 0.01
  assign spb = section.settings.space_bottom | default: 100 | times: 0.01
  assign heading_id = 'mc-cmp-' | append: section.id
  assign c1 = section.settings.col_1 | default: 'MUTO'
  assign c2 = section.settings.col_2 | default: 'Budget tubs'
  assign c3 = section.settings.col_3 | default: 'Gym brands'
  assign c4 = section.settings.col_4 | default: 'Preworkouts & blends'
  assign compact = false
  if section.settings.density == 'compact'
    assign compact = true
  endif
-%}

{%- if compact -%}
  <style>
    #shopify-section-{{ section.id }} .mc__cmp-group th{text-align:left;font-family:var(--mc-mono);font-weight:500;font-size:11px;line-height:1.2;letter-spacing:.08em;text-transform:uppercase;color:var(--mc-muted)}
    #shopify-section-{{ section.id }} .mc__cmp-table .mc__cmp-claim{font-size:17px;line-height:1.3}
    #shopify-section-{{ section.id }} .mc__cmp-mark{width:28px;height:28px}
    #shopify-section-{{ section.id }} .mc__cmp-mark svg{width:14px;height:14px}
    @media screen and (min-width:990px){
      #shopify-section-{{ section.id }} .mc .mc__h2{font-size:clamp(34px,3.2vw,48px)}
      #shopify-section-{{ section.id }} .mc__cmp-table .mc__cmp-col{font-size:14px;letter-spacing:.02em;padding-bottom:14px}
      #shopify-section-{{ section.id }} .mc__cmp-col--muto{font-size:20px}
      #shopify-section-{{ section.id }} .mc__cmp-row{height:48px}
      #shopify-section-{{ section.id }} .mc__cmp-table{width:auto}
      #shopify-section-{{ section.id }} .mc__cmp-table col:nth-child(5){width:var(--mc-cmp-pitch,160px)}
      #shopify-section-{{ section.id }} .mc__cmp-row > *{border-top:1px solid rgba(22,47,49,.09)}
      #shopify-section-{{ section.id }} .mc__cmp-group th{padding:18px 0 6px}
      #shopify-section-{{ section.id }} tbody .mc__cmp-group:first-child th{padding-top:10px}
      #shopify-section-{{ section.id }} .mc__cmp-panel{border-radius:22px}
    }
    @media screen and (max-width:989px){
      #shopify-section-{{ section.id }} .mc__cmp-table .mc__cmp-claim{font-size:13.5px}
      #shopify-section-{{ section.id }} .mc__cmp-table tbody td{padding:7px 5px}
      #shopify-section-{{ section.id }} .mc__cmp-mark{width:26px;height:26px}
      #shopify-section-{{ section.id }} .mc__cmp-mark svg{width:13px;height:13px}
      #shopify-section-{{ section.id }} .mc__cmp-table .mc__cmp-group th{position:static;padding:14px 0 6px;background:var(--mc-ground);border-right:0;font-size:10px}
      #shopify-section-{{ section.id }} .mc__cmp-group-label{position:sticky;left:16px;display:inline-block}
    }
  </style>
{%- endif -%}

{%- comment -%}
    The artboards do not share a column rhythm: the creatine table runs a
    457 claim column on a 243 pitch, the NAD one a 581.6 claim column on a
    210.5 pitch with a narrower highlight. They are settings rather than two
    stylesheets, and the last column takes whatever is left so the table
    always finishes on the right margin.
  {%- endcomment -%}
<div class="mc mc--compare mc--fit-{{ section.settings.fit | default: 'crea' }}{% if compact %} mc--cmp-compact{% endif %}" style="--mc-spt:{{ spt }};--mc-spb:{{ spb }};--mc-cmp-first:{{ section.settings.claim_width | default: 457 }}px;--mc-cmp-pitch:{{ section.settings.col_pitch | default: 243 }}px;--mc-cmp-pw:{{ section.settings.panel_width | default: 169 }}px;--mc-cmp-gap:{{ section.settings.head_gap | default: 85 }}px">
  <div class="mc__wrap">
    <section class="mc__cmp" aria-labelledby="{{ heading_id }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="mc__h2 mc__steps-head" id="{{ heading_id }}">
          {{- section.settings.heading | escape | newline_to_br -}}
        </h2>
      {%- endif -%}

      <div class="mc__cmp-wrap" data-mc-compare>
        <span class="mc__cmp-panel" data-mc-panel aria-hidden="true"></span>
        <table class="mc__cmp-table">
          <caption class="mc__vh">{{ section.settings.table_caption | default: 'How MUTO creatine compares with other creatine on sale' }}</caption>
          <colgroup><col><col><col><col><col></colgroup>
          <thead>
            <tr>
              <th scope="col"><span class="mc__vh">{{ section.settings.claim_label | default: 'What we compare' }}</span></th>
              {%- comment -%}
                At phone width the first column's name is set as the wordmark
                instead of in 10.5px mono. The name stays in the markup, hidden
                from the eye but not from a screen reader: every mark in this
                column carries a "Yes — MUTO" alternative that is only useful
                while this header still says MUTO. The mark itself is a masked
                span, which is how the wordmark is drawn everywhere else in the
                theme, and takes the cell's own ink colour.
              {%- endcomment -%}
              <th scope="col" class="mc__cmp-col mc__cmp-col--muto{% if section.settings.col_1_logo %} mc__cmp-col--logo{% endif %}" data-mc-muto-col>
                {%- if section.settings.col_1_logo -%}
                  <span class="mc__cmp-logo" aria-hidden="true">
                    {%- comment -%} Drawn inline rather than as a CSS mask, so it shows wherever the table does. {%- endcomment -%}
                    <svg class="mc__cmp-logo-svg" viewBox="0 0 227 62.215" width="50" height="14" focusable="false" style="display:block;width:50px;height:auto;color:var(--mc-ink)"><path d="M 0.589 1.491 L 14.654 1.491 C 14.902 1.491 15.13 1.647 15.212 1.885 L 29.35 43.58 C 29.526 44.109 30.28 44.109 30.456 43.58 L 44.821 1.885 C 44.903 1.647 45.12 1.491 45.379 1.491 L 59.196 1.491 C 59.516 1.491 59.785 1.751 59.785 2.082 L 59.785 60.139 C 59.785 60.461 59.527 60.73 59.196 60.73 L 48.562 60.73 C 48.242 60.73 47.973 60.471 47.973 60.139 L 47.973 24.656 C 47.973 23.992 47.053 23.837 46.836 24.469 L 34.507 60.326 C 34.424 60.564 34.207 60.72 33.949 60.72 L 25.34 60.72 C 25.092 60.72 24.865 60.564 24.782 60.326 L 12.701 24.832 C 12.484 24.2 11.564 24.355 11.564 25.019 L 11.564 60.129 C 11.564 60.45 11.306 60.72 10.975 60.72 L 0.589 60.72 C 0.269 60.72 0 60.461 0 60.129 L 0 2.082 C 0 1.761 0.258 1.491 0.589 1.491 Z" fill="currentColor"/><path d="M 67.847 36.415 L 67.847 2.082 C 67.847 1.761 68.105 1.491 68.436 1.491 L 80.134 1.491 C 80.455 1.491 80.723 1.751 80.723 2.082 L 80.723 36.995 C 80.723 41.693 81.581 45.197 83.286 47.489 C 84.992 49.78 87.782 50.931 91.637 50.931 C 95.492 50.931 98.396 49.78 100.028 47.489 C 101.661 45.197 102.467 41.693 102.467 36.995 L 102.467 2.082 C 102.467 1.761 102.726 1.491 103.056 1.491 L 114.755 1.491 C 115.075 1.491 115.344 1.751 115.344 2.082 L 115.344 36.581 C 115.344 45.26 113.298 51.709 109.195 55.909 C 105.092 60.108 99.191 62.213 91.482 62.213 C 83.772 62.213 77.902 60.129 73.892 55.95 C 69.872 51.771 67.867 45.26 67.867 36.415 L 67.847 36.415 Z" fill="currentColor"/><path d="M 137.636 12.856 L 121.049 12.856 C 120.729 12.856 120.46 12.597 120.46 12.265 L 120.46 2.082 C 120.46 1.761 120.718 1.491 121.049 1.491 L 168.34 1.491 C 168.66 1.491 168.929 1.751 168.929 2.082 L 168.929 12.275 C 168.929 12.597 168.67 12.866 168.34 12.866 L 151.68 12.866 C 151.36 12.866 151.091 13.126 151.091 13.457 L 151.091 60.15 C 151.091 60.471 150.833 60.741 150.502 60.741 L 138.804 60.741 C 138.483 60.741 138.215 60.481 138.215 60.15 L 138.215 13.447 C 138.215 13.126 137.956 12.856 137.626 12.856 L 137.636 12.856 Z" fill="currentColor"/><path d="M 170.966 31.273 C 170.966 24.637 172.124 18.986 174.428 14.309 C 176.733 9.633 180.009 6.087 184.246 3.65 C 188.483 1.213 193.444 0 199.148 0 C 204.853 0 209.793 1.203 213.968 3.608 C 218.143 6.014 221.368 9.508 223.621 14.102 C 225.874 18.696 227 24.274 227 30.859 C 227 37.443 225.863 43.146 223.579 47.822 C 221.295 52.499 218.071 56.066 213.885 58.523 C 209.7 60.981 204.708 62.215 198.9 62.215 C 193.092 62.215 188.256 61.012 184.081 58.606 C 179.895 56.201 176.671 52.706 174.387 48.113 C 172.103 43.519 170.966 37.91 170.966 31.273 Z M 184.329 31.107 C 184.329 37.298 185.548 42.151 187.998 45.666 C 190.436 49.181 194.105 50.933 198.993 50.933 C 203.882 50.933 207.478 49.181 209.948 45.666 C 212.418 42.151 213.648 37.298 213.648 31.107 C 213.648 24.917 212.418 20.064 209.948 16.549 C 207.478 13.034 203.83 11.282 198.993 11.282 C 194.157 11.282 190.436 13.034 187.998 16.549 C 185.559 20.064 184.329 24.917 184.329 31.107 Z" fill="currentColor"/></svg>
                  </span>
                {%- endif -%}
                <span class="mc__cmp-col-text">{{ c1 }}</span>
              </th>
              <th scope="col" class="mc__cmp-col">{{ c2 }}</th>
              <th scope="col" class="mc__cmp-col">{{ c3 }}</th>
              <th scope="col" class="mc__cmp-col">{{ c4 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'group' -%}
                <tr class="mc__cmp-group" {{ block.shopify_attributes }}>
                  <th scope="colgroup" colspan="5"><span class="mc__cmp-group-label">{{ block.settings.label }}</span></th>
                </tr>
              {%- else -%}
                <tr class="mc__cmp-row" {{ block.shopify_attributes }}>
                  <th scope="row" class="mc__cmp-claim">{{ block.settings.claim }}</th>
                  <td>{% render 'muto-crea-mark', state: block.settings.m1, column: c1 %}</td>
                  <td>{% render 'muto-crea-mark', state: block.settings.m2, column: c2 %}</td>
                  <td>{% render 'muto-crea-mark', state: block.settings.m3, column: c3 %}</td>
                  <td>{% render 'muto-crea-mark', state: block.settings.m4, column: c4 %}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

    </section>
  </div>
</div>

{% schema %}
{
  "name": "MUTO Creatine — Compare",
  "tag": "section",
  "class": "mc-section",
  "max_blocks": 16,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Same molecule.\nHigher standard." },
    { "type": "text", "id": "table_caption", "label": "Table caption", "default": "How MUTO creatine compares with other creatine on sale", "info": "Read by screen readers, not shown." },
    { "type": "text", "id": "claim_label", "label": "Claim column label", "default": "What we compare", "info": "Read by screen readers, not shown." },
    { "type": "select", "id": "density", "label": "Density", "default": "spacious", "options": [{ "value": "spacious", "label": "Spacious (artboard)" }, { "value": "compact", "label": "Compact" }], "info": "Compact suits longer tables: shorter rows, smaller type, a hairline between rows." },
    { "type": "header", "content": "Columns" },
    { "type": "range", "id": "head_gap", "label": "Space under the heading", "min": 40, "max": 140, "step": 1, "unit": "px", "default": 85, "info": "Desktop only." },
    { "type": "range", "id": "claim_width", "label": "Claim column", "min": 382, "max": 882, "step": 5, "unit": "px", "default": 457, "info": "Desktop only. The four comparison columns share what is left." },
    { "type": "range", "id": "col_pitch", "label": "Column pitch", "min": 160, "max": 260, "step": 1, "unit": "px", "default": 243 },
    { "type": "range", "id": "panel_width", "label": "Highlight width", "min": 120, "max": 220, "step": 1, "unit": "px", "default": 169 },
    { "type": "text", "id": "col_1", "label": "Column 1", "default": "MUTO" },
    { "type": "checkbox", "id": "col_1_logo", "label": "Set column 1 as the MUTO wordmark on mobile", "default": true, "info": "Phone width only — desktop keeps the typed name. Turn this off if column 1 is not MUTO." },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Budget tubs" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Gym brands" },
    { "type": "text", "id": "col_4", "label": "Column 4", "default": "Preworkouts & blends" },
    { "type": "select", "id": "fit", "label": "Which wash", "default": "crea", "options": [{ "value": "crea", "label": "Creatine page" }, { "value": "nad", "label": "NAD+ page" }], "info": "The mint wash is least-squares fitted to one artboard's own pixels, and the two product pages wash this band differently." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Claim",
      "settings": [
        { "type": "text", "id": "claim", "label": "Claim", "default": "Pure creatine monohydrate, nothing else" },
        { "type": "select", "id": "m1", "label": "Column 1", "default": "yes", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "dash", "label": "Not stated" }] },
        { "type": "select", "id": "m2", "label": "Column 2", "default": "dash", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "dash", "label": "Not stated" }] },
        { "type": "select", "id": "m3", "label": "Column 3", "default": "dash", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "dash", "label": "Not stated" }] },
        { "type": "select", "id": "m4", "label": "Column 4", "default": "dash", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "dash", "label": "Not stated" }] }
      ]
    },
    {
      "type": "group",
      "name": "Group label",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "What else is inside", "info": "A small heading above the claims that follow it." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUTO Creatine — Compare",
      "blocks": [
        { "type": "row", "settings": { "claim": "Pure creatine monohydrate, nothing else", "m1": "yes", "m2": "yes", "m3": "yes", "m4": "no" } },
        { "type": "row", "settings": { "claim": "Micronised to mix cleanly", "m1": "yes", "m2": "dash", "m3": "yes", "m4": "dash" } },
        { "type": "row", "settings": { "claim": "Every batch independently tested", "m1": "yes", "m2": "no", "m3": "dash", "m4": "dash" } },
        { "type": "row", "settings": { "claim": "No fillers, flavours or sweeteners", "m1": "yes", "m2": "dash", "m3": "dash", "m4": "no" } },
        { "type": "row", "settings": { "claim": "No stimulants", "m1": "yes", "m2": "yes", "m3": "yes", "m4": "no" } },
        { "type": "row", "settings": { "claim": "Made in the UK", "m1": "yes", "m2": "dash", "m3": "dash", "m4": "dash" } },
        { "type": "row", "settings": { "claim": "Lowest price per gram", "m1": "no", "m2": "yes", "m3": "dash", "m4": "no" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "page", "index"]
  }
}
{% endschema %}
