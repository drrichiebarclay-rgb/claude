{%- comment -%}
  MUTO — Site styles (muto-site-styles). Site-wide only, on every page: the MUTO type (Neue Haas Grotesk
  Display, Sometype Mono), heading weights, the plain header and the shorter mobile header, footer heading
  weights, the cart styles, and structured data for the home and science pages. Also the range product
  pages' buy box CSS and the science page's comparison (both chosen by template).
  No Black Friday or product page CSS here: the Black Friday pages get theirs from "MUTO — BF page styles"
  on their own templates. Keep this section first in the header group.
{%- endcomment -%}
<style>
/* Site-wide: headings at the brand's 500 weight (the theme default was heavier), and the reviews widget to match */
:root{--font-heading-weight:500}
.custom-reviews-heading h1,.custom-reviews-heading h2,.custom-reviews-heading h3{font-weight:500!important;letter-spacing:-.014em}
#ReviewsWidget,#ReviewsWidget *{--heading-text-font-weight:500!important;--pagination-tab-text-font-weight:500!important;--pagination-tab-active-text-font-weight:500!important;--sentiment-heading-text-font-weight:500!important;--sentiment-pagination-tab-text-font-weight:500!important;--sentiment-pagination-tab-active-text-font-weight:500!important}
#ReviewsWidget button,#ReviewsWidget [class*="Heading"],#ReviewsWidget strong,#ReviewsWidget b{font-weight:500!important}
/* Site-wide, phones and tablets: a shorter header bar (8px margin and padding instead of 24px and 16px,
   smaller logo, caption and icons); pages under the see-through header move up 44px instead of 76px */
@media screen and (max-width:989.98px){
  header.header{margin:8px 10px 0!important;padding-top:8px!important;padding-bottom:8px!important}
  .header.page-width{padding-left:12px!important;padding-right:12px!important}
  .header__heading-logo-wrapper{gap:6px!important}
  .header__heading-logo{width:36px!important;height:auto!important}
  .header-logo-caption{font-size:6.5px!important;line-height:6px!important;letter-spacing:.4px!important}
  .header__icon,.header__icon .icon,.header__icon .svg-wrapper{width:18px!important;height:18px!important}
  .header__icon--cart{margin-left:10px!important}
  main:has([allow-transparent-header]){margin-top:-44px!important}
  .template-muto-nad .header-wrapper,.template-muto-bottle .header-wrapper,
  .template-muto-socks .header-wrapper,.template-muto-creatine .header-wrapper{padding-top:6px!important;padding-bottom:6px!important}
}
</style>
{%- if template.suffix == 'muto-creatine' or template.suffix == 'muto-socks' or template.suffix == 'muto-bottle' -%}
  {{ 'muto-range-buy.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if template.suffix == 'science-simple' -%}
  {%- comment -%} Science page: styled like the Black Friday product page. Its comparison goes into the
  template's "compare" slot, and its sections use the product page's scale {%- endcomment -%}
  <style>
    /* Same scale as the Black Friday product page's sections */
    html:root body #MainContent > .shopify-section{zoom:.86}
    @media (min-width:990px){html:root body #MainContent > .shopify-section{zoom:.93}}
    @media (max-width:749px){html:root body #MainContent > .shopify-section{zoom:.84}}
  </style>
  {%- render 'muto-bf-compare' -%}
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var t = document.getElementById('mc-cmp-tpl'), s = document.querySelector('#MainContent [id$="__compare"]');
    if (!t || !s || s.querySelector('.mc-cmp')) return;
    s.innerHTML = ''; s.appendChild(t.content.cloneNode(true));
    var r = s.querySelector('.mc-cmp'); if (r) r.id = 'muto-vs-the-usual';
  });
  </script>
{%- endif -%}
<style>
  /* MUTO type on every page: Neue Haas Grotesk Display for text, Sometype Mono for labels */
  @font-face{font-family:"Neue Haas Grotesk Display Pro";src:url("https://cdn.shopify.com/s/files/1/0976/2724/2843/files/NeueHaasDisplay-Roman.woff2?v=1788216240") format("woff2");font-weight:400 450;font-style:normal;font-display:swap}
  @font-face{font-family:"Neue Haas Grotesk Display Pro";src:url("https://cdn.shopify.com/s/files/1/0976/2724/2843/files/NeueHaasDisplay-Mediu.woff2?v=1788216243") format("woff2");font-weight:500 550;font-style:normal;font-display:swap}
  @font-face{font-family:"Neue Haas Grotesk Display Pro";src:url("https://cdn.shopify.com/s/files/1/0976/2724/2843/files/NeueHaasDisplay-Bold.woff2?v=1788216239") format("woff2");font-weight:600 700;font-style:normal;font-display:swap}
  @font-face{font-family:"Sometype Mono";src:url("https://cdn.shopify.com/s/files/1/0976/2724/2843/files/gempages_SometypeMono-VariableFont_wght.ttf?v=1788157466") format("truetype-variations");font-weight:400 700;font-style:normal;font-display:swap}
  :root{--mc-font:"Neue Haas Grotesk Display Pro",-apple-system,BlinkMacSystemFont,"Segoe UI","Helvetica Neue",Arial,sans-serif;--mc-mono:"Sometype Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace}
  /* A superscript (the + in NAD+) never makes its line taller, so buttons and tabs stay one height */
  html body sup{line-height:0;vertical-align:.6em;font-size:.6em}
  /* Sometype Mono is always set in capitals */
  html body .mrg__acts b,html body .mbp__doses,html body .mbp__list span,html body .msc__mono,html body .mht__d,html body .mex__day,
  html body .mil__dose,html body .mil-d__dose,html body .mlv__who,html body .mc-cmp .c.z b,html body .mst__eye,html body .msc__eye,html body .msc__num,
  html body .mbp__num,html body .mbp__eye,html body .mht__eye,html body .mex__eye,html body .mrg__eye,html body .mrg__chip,html body .mht__chip,html body .mbp__chip,
  html body .mtop__eye,html body .mtop__q,html body .mtop__rate,html body .mlv__rate,html body .msn__nav b,
  html body .mtr__t td,html body .mtr__row small,html body .mtr__doc,html body .mtr__batch,html body .mtr__tab b,html body .mtr__cert-meta,html body .mtr__cert-row > span:last-child,
  html body .mil__filter .n,html body .mil__dose,html body .mil__tag,html body .mil__cat-label,html body .mil__eyebrow{text-transform:uppercase!important;letter-spacing:.06em}
  html body .mtr__t td:first-child{text-transform:none!important;letter-spacing:0}
  /* One button style: turquoise, 8px corners, as the add to cart */
  html body .mil__cat-btn,html body .mtr .mtr__cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:56px!important;padding:0 32px!important;border-radius:8px!important;background:#5efaff!important;color:#242223!important;font-family:var(--mc-font)!important;font-size:16px!important;font-weight:500!important;text-decoration:none!important}
  html body .mil__cat-btn:hover{background:#3ef0f6!important;opacity:1!important}
  /* Header: plain everywhere. No navy band and no glass pills; black logo, nav and icons. On the home page
     it sits over the opening photo, so it stays white there. */
  html body header.header,html body .header__heading-link,html body .header__wrapper{background:transparent!important;box-shadow:none!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}
  html body:not(.template-index) .header-wrapper{background-color:#fff!important}
  html body:not(.template-index):has([allow-transparent-header]) .header-wrapper{background-color:transparent!important}
  html body:not(.template-index) .header__heading-logo{filter:invert(100%)!important}
  html body:not(.template-index) .header-logo-caption{color:#242223!important}
  html body:not(.template-index) .header__icon,html body:not(.template-index) .header__icon .svg-wrapper{color:#242223!important}
  html body:not(.template-index) .header__inline-menu .list-menu--inline > li > a.header__menu-item,
  html body:not(.template-index) .header__inline-menu .list-menu--inline > li > details > summary.header__menu-item,
  html body:not(.template-index) .header__inline-menu .list-menu--inline > li > a .header__active-menu-item{color:#242223!important}
  html body.template-index .header-wrapper{background-color:transparent!important}
  /* The site menu sits above everything on the page, on a solid panel */
  html body .section-header{z-index:30!important}
  /* Menu drawer: a plain white list like the header. Text at 18px, hairline rules, no boxes or grey fills;
     Log in full width at the foot with the social icons in a row under it */
  html body .menu-drawer,html body .menu-drawer__submenu{--color-foreground:36,34,35;--color-background:255,255,255;background:#fff!important;color:#242223!important;font-family:var(--mc-font)!important}
  html body .menu-drawer__navigation-container,html body .menu-drawer__inner-submenu{padding:0!important}
  html body .menu-drawer__navigation{padding:8px 0 0!important;margin:0!important}
  html body .menu-drawer__menu{padding:0!important;margin:0!important}
  html body .menu-drawer__menu > li{margin:0!important;padding:0!important;height:auto!important;min-height:0!important;border:0!important;background:none!important}
  html body .menu-drawer__menu-item{display:flex!important;align-items:center;min-height:0!important;height:auto!important;margin:0 20px!important;padding:16px 0!important;
    font-family:var(--mc-font)!important;font-size:18px!important;line-height:1.2!important;font-weight:500!important;letter-spacing:-.01em;color:#242223!important;
    background:none!important;border:0!important;border-bottom:1px solid rgba(36,34,35,.1)!important;border-radius:0!important;box-shadow:none!important;text-decoration:none!important}
  html body .menu-drawer summary.menu-drawer__menu-item{padding-right:32px!important}
  html body .menu-drawer__menu-item > .svg-wrapper{right:0!important;width:14px!important;color:#242223;opacity:.6}
  html body .menu-drawer__menu-item:hover,html body .menu-drawer__menu-item:focus,html body .menu-drawer__menu-item--active,
  html body .menu-drawer__close-button:hover,html body .menu-drawer__close-button:focus{background:none!important;color:#242223!important;opacity:.65}
  html body .menu-drawer__close-button{display:flex!important;align-items:center;margin:8px 0 4px!important;padding:12px 20px!important;background:none!important;border:0!important;
    font-family:var(--mc-mono)!important;font-size:11px!important;text-transform:uppercase;letter-spacing:.08em;color:#242223!important}
  html body .menu-drawer__close-button .svg-wrapper{width:12px!important;margin-right:10px!important}
  html body .menu-drawer__utility-links{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:14px!important;background:#fff!important;padding:20px 20px calc(20px + env(safe-area-inset-bottom))!important;margin:0!important;border:0!important}
  html body .menu-drawer__utility-links .button{order:0;display:flex!important;align-items:center;justify-content:center;width:100%!important;min-width:0!important;height:48px!important;min-height:0!important;margin:0!important;padding:0 20px!important;
    border:0!important;border-radius:8px!important;background:#242223!important;color:#fff!important;font-family:var(--mc-font)!important;font-size:15px!important;font-weight:500!important;letter-spacing:0!important;box-shadow:none!important}
  html body .menu-drawer__utility-links .button::before,html body .menu-drawer__utility-links .button::after{display:none!important}
  html body .menu-drawer__utility-links .button:hover{background:#000!important}
  html body .menu-drawer .list-social{order:1;display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;justify-content:center!important;gap:0!important;margin:0!important;padding:0!important;width:auto!important}
  html body .menu-drawer .list-social__item{margin:0!important;padding:0!important;border:0!important;background:none!important;width:auto!important;height:auto!important}
  html body .menu-drawer .list-social__link{display:flex!important;padding:6px!important;border:0!important;outline:0;background:none!important;box-shadow:none!important;color:#242223!important;opacity:.7}
  html body .menu-drawer .list-social__link:hover{opacity:1}
  html body .menu-drawer .list-social__link .svg-wrapper,html body .menu-drawer .list-social__link svg{width:30px!important;height:30px!important;border:0!important;outline:0!important;box-shadow:none!important;background:none!important}
  /* The theme's social icons draw a square frame as their last path: hidden here */
  html body .menu-drawer .list-social__link svg path:last-child:not(:first-child){display:none!important}
  /* "On this page" links: hidden where they sit in the page; they appear pinned to the top once you scroll past */
  html:root body .msn{height:0!important;overflow:visible}
  html:root body .msn__nav:not(.is-fixed){visibility:hidden;opacity:0;pointer-events:none}
  html:root body .msn__nav.is-fixed{animation:msnIn .25s ease both}
  @keyframes msnIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){html:root body .msn__nav.is-fixed{animation:none}}
  /* Footer headings at the site's heading weight */
  footer h1,footer h2,footer h3,footer .h1,footer .h2,footer .h3,footer .h4,footer .footer-block__heading,footer .newsletter__heading,
  .footer h1,.footer h2,.footer h3,.footer .h1,.footer .h2,.footer .footer-block__heading,[id*="__footer"] h2,[id*="__footer"] .h1,[id*="__footer"] .h2{font-weight:500!important}
</style>
