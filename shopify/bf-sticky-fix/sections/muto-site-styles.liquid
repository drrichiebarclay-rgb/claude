{% schema %}
{
  "name": "MUTO — Site styles",
  "tag": "div",
  "class": "muto-site-styles",
  "settings": [
    { "type": "paragraph", "content": "Site-wide MUTO type, header and cart styles. Keep this first in the header. It has no page-specific or Black Friday CSS." }
  ],
  "presets": [{ "name": "MUTO — Site styles" }]
}
{% endschema %}
