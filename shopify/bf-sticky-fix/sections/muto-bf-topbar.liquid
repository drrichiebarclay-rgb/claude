{%- comment -%}
  MUTO — Black Friday top bar (muto-bf-topbar). The black bar fixed to the top of the screen with
  "Claim →", as a section you can add to any template (page, home, collection, product, article).
  "Claim" adds the chosen product on the chosen plan to the cart, then opens the side cart (or goes to checkout).

  It sells the product picked in "Product" (blank: the page's own product on product pages). The plan is
  the first available variant with a Skio selling plan whose name contains "Plan name contains"
  (default 3-month); with no match it uses the first available variant, one-time.

  Every bar gets its own id (mc-bfx-<section id>) and a self-contained script, so it doesn't depend on the
  page's template suffix or on the Black Friday product page's plan cards.
  On the Black Friday product template (muto-nad-bf) the head section (muto-bf-head) already draws this bar,
  so this section stays hidden there to avoid two bars.
  Uses assets/muto-bf-bar.css (fixed bar, page pushed down 44px / 40px on phones).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = product
  endif
  assign bar_id = 'mc-bfx-' | append: section.id
  assign on_bf_pdp = false
  if template.suffix contains 'muto-nad-bf' and product != blank
    assign on_bf_pdp = true
  endif

  assign q_variant = ''
  assign q_plan = ''
  if p != blank
    assign want = s.plan_match | downcase | strip
    if want != blank
      for pv in p.variants
        if q_variant != blank
          break
        endif
        unless pv.available
          continue
        endunless
        for alloc in pv.selling_plan_allocations
          assign n = alloc.selling_plan.name | downcase
          if n contains want
            assign q_variant = pv.id
            assign q_plan = alloc.selling_plan.id
            break
          endif
        endfor
      endfor
    endif
    if q_variant == blank and p.first_available_variant != blank and p.requires_selling_plan == false
      assign q_variant = p.first_available_variant.id
    endif
  endif
-%}
{%- if on_bf_pdp -%}
  {%- if request.design_mode -%}
    <p style="margin:0;padding:12px 16px;font:14px/1.4 sans-serif;background:#fff6d6;color:#242223">MUTO — BF top bar is hidden here: this Black Friday product page already draws its top bar (MUTO — Black Friday head).</p>
  {%- endif -%}
{%- elsif q_variant == blank -%}
  {%- if request.design_mode -%}
    <p style="margin:0;padding:12px 16px;font:14px/1.4 sans-serif;background:#fff6d6;color:#242223">MUTO — BF top bar: pick a product that's available to buy (and, for a plan, one whose plan name contains "{{ s.plan_match }}").</p>
  {%- endif -%}
{%- else -%}
  {{ 'muto-bf-bar.css' | asset_url | stylesheet_tag }}
  <a class="mc-bfx" id="{{ bar_id }}" href="{{ p.url }}" role="button"
    data-variant="{{ q_variant }}" data-plan="{{ q_plan }}" data-go="{{ s.after_claim }}"
    aria-label="{{ s.aria | default: s.text_desktop | strip_html | escape }}">
    <span class="mc-bfx__dot" aria-hidden="true"></span>
    <span class="mc-bfx__d">{{ s.text_desktop }}</span>
    {%- if s.text_desktop_2 != blank -%}
      <span class="mc-bfx__d mc-bfx__sep" aria-hidden="true">·</span>
      <span class="mc-bfx__d">{{ s.text_desktop_2 }}</span>
    {%- endif -%}
    <span class="mc-bfx__m">{{ s.text_mobile }}</span>
    <span class="mc-bfx__sep mc-bfx__sep--cta" aria-hidden="true">·</span>
    <span class="mc-bfx__cta"><span class="mc-bfx__spin" aria-hidden="true"></span>{{ s.cta | default: 'Claim' }}&nbsp;&rarr;</span>
  </a>
  <script>
  (function () {
    /* This section's own bar only */
    var bar = document.getElementById({{ bar_id | json }});
    if (!bar || bar.dataset.ready) return;
    bar.dataset.ready = '1';
    /* Only one top bar on screen: if another Black Friday bar is already on the page, this one steps aside */
    var others = [].slice.call(document.querySelectorAll('.mc-bfx')).filter(function (el) { return el !== bar; });
    if (others.length) { bar.remove(); return; }
    var busy = false;
    /* Open the theme's side cart (Dawn cart drawer) with fresh contents, as its own Add to cart does.
       Resolves false when the page has no drawer, so the caller can fall back to the cart page. */
    function openSideCart(root) {
      var d = document.querySelector('cart-drawer');
      if (!d || typeof d.renderContents !== 'function') return Promise.resolve(false);
      return fetch(root + '?sections=cart-drawer,cart-icon-bubble', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) { if (!s || !s['cart-drawer']) return false; d.renderContents({ sections: s }); return true; })
        .catch(function () { return false; });
    }
    function idle() {
      busy = false;
      bar.classList.remove('is-busy');
      bar.removeAttribute('aria-busy');
    }
    function done(ok) {
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      if (!ok) { idle(); window.location.href = bar.getAttribute('href'); return; }
      if (bar.getAttribute('data-go') === 'checkout') { window.location.href = root + 'checkout'; return; }
      openSideCart(root).then(function (opened) {
        if (opened) idle();
        else window.location.href = root + 'cart';
      });
    }
    bar.addEventListener('click', function (e) {
      e.preventDefault();
      if (busy) return;
      if (!window.fetch) { window.location.href = bar.getAttribute('href'); return; }
      busy = true;
      bar.classList.add('is-busy');
      bar.setAttribute('aria-busy', 'true');
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      var vid = bar.getAttribute('data-variant'), plan = bar.getAttribute('data-plan');
      var planId = plan ? parseInt(plan, 10) : null;
      /* Already in the cart on this plan (a second tap, or back from checkout): don't add a second one */
      fetch(root + 'cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : { items: [] }; })
        .catch(function () { return { items: [] }; })
        .then(function (cart) {
          var has = (cart.items || []).some(function (it) {
            var sp = it.selling_plan_allocation && it.selling_plan_allocation.selling_plan;
            return String(it.variant_id) === String(vid) && (sp ? sp.id : null) === planId;
          });
          if (has) return done(true);
          var item = { id: parseInt(vid, 10), quantity: 1 };
          if (planId) item.selling_plan = planId;
          return fetch(root + 'cart/add.js', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [item] })
          }).then(function (r) { done(r.ok); });
        })
        .catch(function () { done(false); });
    });
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "MUTO — BF top bar",
  "tag": "div",
  "class": "muto-bf-topbar",
  "settings": [
    { "type": "paragraph", "content": "The black bar fixed to the top of the screen. Claim adds the product below on its plan to the cart, then opens the side cart. Hidden on the Black Friday product template (muto-nad-bf), which draws its own." },
    { "type": "product", "id": "product", "label": "Product", "info": "Blank: the page's own product (product pages only)" },
    { "type": "text", "id": "plan_match", "label": "Plan name contains", "default": "3-month", "info": "The Skio plan Claim adds, matched on its name. No match: the first available variant, one-time." },
    { "type": "select", "id": "after_claim", "label": "After Claim", "default": "cart", "options": [
      { "value": "cart", "label": "Open the side cart" },
      { "value": "checkout", "label": "Go straight to checkout" }
    ] },
    { "type": "header", "content": "Text" },
    { "type": "inline_richtext", "id": "text_desktop", "label": "Desktop text", "default": "<b>Black Friday:</b> 3 months for £99 (save 53%) + welcome kit worth £87" },
    { "type": "text", "id": "text_desktop_2", "label": "Desktop text, after the dot", "default": "While stock lasts" },
    { "type": "inline_richtext", "id": "text_mobile", "label": "Phone and tablet text", "default": "<b>3 months for £99</b> · Save 53%" },
    { "type": "text", "id": "cta", "label": "Link text", "default": "Claim" },
    { "type": "text", "id": "aria", "label": "Screen reader text", "default": "Black Friday: 3 months for £99, save 53%, plus a welcome kit worth £87, while stock lasts. Claim: adds the 3-month plan and opens the cart." }
  ],
  "presets": [{ "name": "MUTO — BF top bar" }]
}
{% endschema %}
