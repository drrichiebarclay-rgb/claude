{%- comment -%}
  MUTO — Sticky add to cart (muto-sbar). Add it to any template: home, product, page, collection or article.
  The bar sells the product picked in "Product". If that's left blank it sells the page's own product
  (product templates), and with no product at all it falls back to the site-wide NAD+ bar
  (snippets/muto-sci-sticky.liquid).

  Options in the picker:
  - Products sold on Skio plans: one option per selling plan (e.g. 1-month and 3-month), each using the
    first available variant that has that plan, at the plan's own price. Optionally a one-time option.
  - Products without plans: one option per available variant.
  "Pre-select the option containing" picks the default (e.g. "3-month").

  Every bar gets its own id (mc-sbar-<section id>) and its script only touches its own bar, so it works
  next to the site-wide bar (which steps aside when this one is on the page) and next to the Black Friday
  plan bar. On the Black Friday product template (muto-nad-bf) that plan bar (muto-bf-offer) already
  sells the page's product, so this section stays hidden there unless it's set to a different product.
  Shows once the page has scrolled past "Show after scrolling".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = product
  endif
  assign bar_id = 'mc-sbar-' | append: section.id
  assign on_bf_pdp = false
  if template.suffix contains 'muto-nad-bf' and product != blank
    if s.product == blank or s.product.id == product.id
      assign on_bf_pdp = true
    endif
  endif
  assign pick = s.preselect | downcase | strip
-%}
{%- if on_bf_pdp -%}
  {%- if request.design_mode -%}
    <p style="margin:0;padding:12px 16px;font:14px/1.4 sans-serif;background:#fff6d6;color:#242223">MUTO — Sticky add to cart is hidden here: this Black Friday product page already has its plan bar (MUTO — Black Friday offer). Pick a different product in this section to show a second bar.</p>
  {%- endif -%}
{%- elsif p == blank -%}
  {%- render 'muto-sci-sticky' -%}
{%- else -%}
  {%- liquid
    assign opts = ''
    assign count = 0
    assign chosen = 0
    assign first_name = ''
    assign first_sub = ''
    assign seen_plans = ''

    if p.selling_plan_groups.size > 0
      # One option per selling plan, in the order the product's plan groups list them
      for g in p.selling_plan_groups
        for sp in g.selling_plans
          assign key = '|' | append: sp.id | append: '|'
          if seen_plans contains key
            continue
          endif
          for v in p.variants
            unless v.available
              continue
            endunless
            assign al = v.selling_plan_allocations | where: 'selling_plan_id', sp.id | first
            if al == blank
              continue
            endif
            assign seen_plans = seen_plans | append: key
            assign vname = sp.name | downcase | capitalize
            if s.plan_label_1 != blank and s.plan_match_1 != blank
              assign m1 = s.plan_match_1 | downcase
              assign spn = sp.name | downcase
              if spn contains m1
                assign vname = s.plan_label_1
              endif
            endif
            if s.plan_label_2 != blank and s.plan_match_2 != blank
              assign m2 = s.plan_match_2 | downcase
              assign spn = sp.name | downcase
              if spn contains m2
                assign vname = s.plan_label_2
              endif
            endif
            assign price_s = al.price | money | strip_html
            assign save = ''
            if al.compare_at_price > al.price
              assign save = al.compare_at_price | minus: al.price | times: 100 | divided_by: al.compare_at_price
              assign save = 'Save ' | append: save | append: '%'
            endif
            assign sub = price_s
            if save != blank
              assign sub = price_s | append: ' · ' | append: save
            endif
            assign count = count | plus: 1
            assign hay = vname | append: ' ' | append: sp.name | downcase
            if chosen == 0 and pick != blank and hay contains pick
              assign chosen = count
            endif
            assign vname_e = vname | escape
            capture o
              echo '<option value="' | append: v.id | append: '" data-plan="' | append: sp.id | append: '" data-name="' | append: vname_e | append: '" data-sub="' | append: sub | append: '">' | append: vname_e | append: ' – ' | append: sub | append: '</option>'
            endcapture
            assign opts = opts | append: o
            break
          endfor
        endfor
      endfor
      if s.one_time and p.requires_selling_plan == false
        # One-time: the variant named "one time" if there is one, else the first available variant
        assign ov = nil
        for v in p.variants
          assign vt = v.title | downcase
          if v.available and vt contains 'one time'
            assign ov = v
            break
          endif
        endfor
        if ov == blank
          assign ov = p.first_available_variant
        endif
        if ov != blank
          assign count = count | plus: 1
          assign price_s = ov.price | money | strip_html
          assign vname_e = s.one_time_label | default: 'One-time purchase' | escape
          capture o
            echo '<option value="' | append: ov.id | append: '" data-plan="" data-name="' | append: vname_e | append: '" data-sub="' | append: price_s | append: '">' | append: vname_e | append: ' – ' | append: price_s | append: '</option>'
          endcapture
          assign opts = opts | append: o
        endif
      endif
    else
      # No plans: one option per available variant
      for v in p.variants
        unless v.available
          continue
        endunless
        assign vname = v.title
        if vname == 'Default Title'
          assign vname = p.title
        endif
        assign price_s = v.price | money | strip_html
        assign count = count | plus: 1
        assign hay = vname | downcase
        if chosen == 0 and pick != blank and hay contains pick
          assign chosen = count
        endif
        assign vname_e = vname | escape
        capture o
          echo '<option value="' | append: v.id | append: '" data-plan="" data-name="' | append: vname_e | append: '" data-sub="' | append: price_s | append: '">' | append: vname_e | append: ' – ' | append: price_s | append: '</option>'
        endcapture
        assign opts = opts | append: o
      endfor
    endif
    if chosen == 0
      assign chosen = 1
    endif
  -%}
  {%- if count > 0 -%}
    {{ 'muto-bf-sticky.css' | asset_url | stylesheet_tag }}
    <style>
      #{{ bar_id }} .mc-sbar__btn-sep{display:none!important}
      html:root body #{{ bar_id }}.mc-sbar .mc-sbar__btn{background:#5efaff!important;color:#242223!important}
      html:root body #{{ bar_id }}.mc-sbar .mc-sbar__btn:hover{background:#3ef0f6!important;filter:none}
      #{{ bar_id }} .mc-sbar__btn[aria-busy="true"]{opacity:.7;cursor:progress}
      #{{ bar_id }} .mc-sbar__pick--one{pointer-events:none}
      #{{ bar_id }} .mc-sbar__pick--one::after{display:none}
    </style>
    <div class="mc-sbar mc-sbar--section" id="{{ bar_id }}" data-mc-sbar-section role="region" aria-label="{{ 'Add ' | append: p.title | append: ' to cart' | escape }}" aria-hidden="true"
      data-after="{{ s.show_after }}" data-go="{{ s.after_add }}" data-fallback="{{ p.url }}">
      <div class="mc-sbar__in">
        <div class="mc-sbar__prod">
          {%- if p.featured_image -%}<img class="mc-sbar__img" src="{{ p.featured_image | image_url: width: 112 }}" width="56" height="56" alt="" loading="lazy">{%- endif -%}
          <div style="min-width:0">
            <p class="mc-sbar__name">{{ s.label | default: p.title }}</p>
            {%- if s.sub != blank -%}<p class="mc-sbar__offer"><i aria-hidden="true"></i>{{ s.sub }}</p>{%- endif -%}
          </div>
        </div>
        <label class="mc-sbar__pick{% if count == 1 %} mc-sbar__pick--one{% endif %}">
          <span class="mc-sbar__pick-name" data-sbar-name></span>
          <span class="mc-sbar__pick-sub" data-sbar-sub></span>
          <select class="mc-sbar__select" data-sbar-select data-chosen="{{ chosen | minus: 1 }}" aria-label="Option"{% if count == 1 %} tabindex="-1"{% endif %}>{{ opts }}</select>
        </label>
        <button type="button" class="mc-sbar__btn" data-sbar-add>
          <span class="mc-sbar__btn-full">{{ s.button | default: 'Add to cart' }}</span><span class="mc-sbar__btn-short">Add</span>
        </button>
      </div>
    </div>
    <script>
    (function () {
      /* This section's own bar only: other sticky bars on the page keep their own scripts */
      var bar = document.getElementById({{ bar_id | json }});
      if (!bar || bar.dataset.ready) return;
      bar.dataset.ready = '1';
      var sel = bar.querySelector('[data-sbar-select]'), btn = bar.querySelector('[data-sbar-add]');
      var nm = bar.querySelector('[data-sbar-name]'), sub = bar.querySelector('[data-sbar-sub]');
      function paint() {
        var o = sel.options[sel.selectedIndex];
        if (!o) return;
        nm.textContent = o.getAttribute('data-name');
        var parts = (o.getAttribute('data-sub') || '').split(' · ');
        sub.innerHTML = '';
        var b = document.createElement('b'); b.textContent = parts[0]; sub.appendChild(b);
        if (parts[1]) sub.appendChild(document.createTextNode(' · ' + parts[1]));
      }
      sel.selectedIndex = parseInt(sel.getAttribute('data-chosen'), 10) || 0;
      paint();
      sel.addEventListener('change', paint);
      btn.addEventListener('click', function () {
        if (btn.getAttribute('aria-busy') === 'true') return;
        var o = sel.options[sel.selectedIndex];
        var item = { id: parseInt(o.value, 10), quantity: 1 };
        if (o.getAttribute('data-plan')) item.selling_plan = parseInt(o.getAttribute('data-plan'), 10);
        btn.setAttribute('aria-busy', 'true');
        var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
        var go = bar.getAttribute('data-go') === 'checkout' ? 'checkout' : 'cart';
        fetch(root + 'cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [item] }) })
          .then(function (r) { window.location.href = r.ok ? root + go : bar.getAttribute('data-fallback'); })
          .catch(function () { window.location.href = bar.getAttribute('data-fallback'); });
      });
      var after = parseInt(bar.getAttribute('data-after'), 10);
      if (isNaN(after)) after = 500;
      function onScroll() {
        var on = (window.pageYOffset || document.documentElement.scrollTop) > after;
        bar.classList.toggle('is-visible', on);
        bar.setAttribute('aria-hidden', on ? 'false' : 'true');
        if ('inert' in bar) bar.inert = !on;
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
    </script>
  {%- elsif request.design_mode -%}
    <p style="margin:0;padding:12px 16px;font:14px/1.4 sans-serif;background:#fff6d6;color:#242223">MUTO — Sticky add to cart: {{ p.title }} has nothing available to buy, so the bar is hidden.</p>
  {%- endif -%}
{%- endif -%}
{%- if s.schema_on and p != blank -%}
  {% render 'muto-home-product-schema', product: p %}
{%- endif -%}

{% schema %}
{
  "name": "MUTO — Sticky add to cart",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "The product this bar sells. Blank: the page's own product on product pages, or the NAD+ bar on other pages." },
    { "type": "text", "id": "label", "label": "Name on the bar", "info": "Blank uses the product's title" },
    { "type": "text", "id": "sub", "label": "Line under the name", "info": "E.g. Black Friday · 3 months for £99" },
    { "type": "text", "id": "button", "label": "Button", "default": "Add to cart" },
    { "type": "select", "id": "after_add", "label": "After adding", "default": "cart", "options": [
      { "value": "cart", "label": "Open the cart" },
      { "value": "checkout", "label": "Go straight to checkout" }
    ] },
    { "type": "range", "id": "show_after", "label": "Show after scrolling", "min": 0, "max": 1500, "step": 50, "unit": "px", "default": 500 },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "preselect", "label": "Pre-select the option containing", "default": "3-month", "info": "Matched against the plan or variant name, e.g. 3-month" },
    { "type": "checkbox", "id": "one_time", "label": "Add a one-time purchase option", "default": false, "info": "Only for products that also sell on Skio plans" },
    { "type": "text", "id": "one_time_label", "label": "One-time option name", "default": "One-time purchase" },
    { "type": "text", "id": "plan_match_1", "label": "Rename plan 1: plan name contains", "default": "3-month" },
    { "type": "text", "id": "plan_label_1", "label": "Rename plan 1: show as", "default": "3-Month Supply" },
    { "type": "text", "id": "plan_match_2", "label": "Rename plan 2: plan name contains", "default": "1-month" },
    { "type": "text", "id": "plan_label_2", "label": "Rename plan 2: show as", "default": "1-Month Supply" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "schema_on", "label": "Emit product structured data", "default": true }
  ],
  "presets": [{ "name": "MUTO — Sticky add to cart" }],
  "enabled_on": { "templates": ["index", "product", "page", "collection", "article", "blog", "list-collections"] }
}
{% endschema %}
