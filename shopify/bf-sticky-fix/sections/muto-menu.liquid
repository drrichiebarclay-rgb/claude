{%- comment -%}
  MUTO — Menu (muto-menu). In the header group. Replaces the contents of the theme's menu drawer (Dawn's
  #menu-drawer, opened by the header's menu icon) with the MUTO menu:
  - a short brand line,
  - Shop: the products in the menu's "Shop" link, each with its photo,
  - the other links grouped under their parent (Science, Support) or "Explore" (single links),
  - an offer card (Black Friday by default; switch it off after),
  - account and social links.
  The drawer opening, closing and focus handling stay the theme's own. Nothing here touches the page itself.
  Remove this section and the theme's plain drawer comes back.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign m = s.menu
  if m == blank
    assign m = linklists['main-menu-new-drawer']
  endif
  assign shop_link = nil
  assign shop_title = ''
  for l in m.links
    assign t = l.title | downcase
    if t contains 'shop' and l.links.size > 0
      assign shop_link = l
      assign shop_title = l.title
      break
    endif
  endfor
  assign promo_url = s.promo_url
  if promo_url == blank
    assign promo_url = all_products['muto-nad-cellular-complex'].url | default: routes.all_products_collection_url
  endif
  assign promo_img = s.promo_image
  if promo_img == blank
    assign promo_img = all_products['muto-nad-cellular-complex'].featured_image
  endif
-%}
<style>
  /* The drawer panel: MUTO near-black with a faint turquoise light from the top corner */
  html body #menu-drawer.mmd{--color-foreground:255,255,255;--color-background:24,23,24;background:#181718!important;
    background-image:radial-gradient(120% 60% at 100% 0%,rgba(94,250,255,.10),rgba(94,250,255,0) 60%),radial-gradient(90% 50% at 0% 100%,rgba(94,250,255,.05),rgba(94,250,255,0) 70%)!important;
    color:#fff!important;font-family:var(--mc-font)!important;border:0!important;filter:none!important}
  #menu-drawer.mmd .menu-drawer__inner-container{height:100%;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
  .mmd__in{display:flex;flex-direction:column;min-height:100%;padding:28px 24px calc(24px + env(safe-area-inset-bottom));box-sizing:border-box}
  .mmd a{color:inherit;text-decoration:none}
  .mmd__eye{margin:0 0 6px;font-family:var(--mc-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  .mmd__hello{margin:0 0 28px;font-size:26px;line-height:1.1;font-weight:500;letter-spacing:-.02em;color:#fff}
  .mmd__label{display:flex;justify-content:space-between;align-items:baseline;margin:0;padding:0 0 12px;border-bottom:1px solid rgba(255,255,255,.14);
    font-family:var(--mc-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  .mmd__label a{color:rgba(255,255,255,.5)}
  /* Shop: one row per product, photo + name */
  .mmd__prods{list-style:none;margin:0 0 30px;padding:0}
  .mmd__prod{display:flex;align-items:center;gap:14px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.08)}
  .mmd__img{flex:0 0 56px;width:56px;height:56px;border-radius:10px;background:#f2f2f0;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .mmd__img img{width:100%;height:100%;object-fit:cover;display:block}
  .mmd__name{flex:1;min-width:0;font-size:19px;line-height:1.2;font-weight:500;letter-spacing:-.01em}
  .mmd__go{flex:0 0 auto;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;transition:background .2s,border-color .2s,color .2s}
  .mmd__go svg{width:12px;height:12px}
  .mmd__prod:hover .mmd__go,.mmd__prod:focus-visible .mmd__go{background:#5efaff;border-color:#5efaff;color:#181718}
  /* Other links: grouped, two columns */
  .mmd__groups{display:grid;grid-template-columns:1fr 1fr;gap:26px 20px;margin:0 0 30px}
  /* An odd last group takes the full width, its links in two columns */
  .mmd__group:last-child:nth-child(odd){grid-column:1/-1}
  .mmd__group:last-child:nth-child(odd) ul{columns:2;column-gap:20px}
  .mmd__group li{break-inside:avoid}
  .mmd__group .mmd__label{border-bottom:0;padding:0 0 10px}
  .mmd__group ul{list-style:none;margin:0;padding:0}
  .mmd__group li a{display:block;padding:6px 0;font-size:15.5px;line-height:1.3;color:rgba(255,255,255,.88)}
  .mmd__group li a:hover{color:#5efaff}
  /* Offer card */
  .mmd__promo{position:relative;display:block;margin:0 0 32px;border-radius:14px;overflow:hidden;background:#0d0d0d;border:1px solid rgba(94,250,255,.28);min-height:150px}
  .mmd__promo-img{position:absolute;inset:0 0 0 45%;}
  .mmd__promo-img img{width:100%;height:100%;object-fit:cover;opacity:.9}
  .mmd__promo::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0d0d0d 42%,rgba(13,13,13,.55) 70%,rgba(13,13,13,0))}
  .mmd__promo-in{position:relative;z-index:1;display:block;padding:20px 20px 18px;max-width:72%}
  .mmd__promo-in > span{display:block}
  .mmd__promo-in > .mmd__promo-eye{display:flex}
  .mmd__promo-in > .mmd__promo-cta{display:inline-flex}
  .mmd__promo-eye{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-family:var(--mc-mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#5efaff}
  .mmd__dot{width:7px;height:7px;border-radius:50%;background:#5efaff;box-shadow:0 0 0 0 rgba(94,250,255,.6);animation:mmdPulse 2s infinite}
  @keyframes mmdPulse{70%{box-shadow:0 0 0 8px rgba(94,250,255,0)}100%{box-shadow:0 0 0 0 rgba(94,250,255,0)}}
  @media (prefers-reduced-motion:reduce){.mmd__dot{animation:none}}
  .mmd__promo-h{margin:0;font-size:24px;line-height:1.08;font-weight:500;letter-spacing:-.02em;color:#fff}
  .mmd__promo-sub{margin:6px 0 14px;font-size:13.5px;line-height:1.35;color:rgba(255,255,255,.72)}
  .mmd__promo-cta{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:8px;background:#5efaff;color:#181718;font-size:14px;font-weight:500}
  .mmd__promo-cta svg{width:12px;height:12px}
  /* Foot: account and social */
  .mmd__foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:16px;border-top:1px solid rgba(255,255,255,.14)}
  .mmd__acct{display:inline-flex;align-items:center;height:40px;padding:0 18px;border-radius:8px;border:1px solid rgba(255,255,255,.28);font-size:14px;font-weight:500;color:#fff}
  .mmd__acct:hover{border-color:#fff}
  .mmd__social{display:flex;gap:2px;margin:0;padding:0;list-style:none}
  .mmd__social a{display:flex;padding:4px;color:rgba(255,255,255,.7)}
  .mmd__social a:hover{color:#fff}
  .mmd__social svg{width:28px;height:28px}
  .mmd__social svg path:last-child:not(:first-child){display:none}
  @media (min-width:750px){.mmd__in{padding:36px 32px 28px}.mmd__hello{font-size:28px}}
</style>
<template id="mmd-tpl">
  <div class="mmd__in">
    {%- if s.eyebrow != blank -%}<p class="mmd__eye">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<p class="mmd__hello">{{ s.heading }}</p>{%- endif -%}

    {%- if shop_link -%}
      <p class="mmd__label"><span>{{ shop_link.title }}</span>{%- if s.shop_all_url != blank -%}<a href="{{ s.shop_all_url }}">Shop all</a>{%- endif -%}</p>
      <ul class="mmd__prods" role="list">
        {%- for c in shop_link.links -%}
          {%- liquid
            assign img = nil
            if c.type == 'product_link' and c.object
              assign img = c.object.featured_image
            endif
          -%}
          <li>
            <a class="mmd__prod" href="{{ c.url }}"{% if c.current %} aria-current="page"{% endif %}>
              <span class="mmd__img">{%- if img -%}{{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 56, height: 56 }}{%- endif -%}</span>
              <span class="mmd__name">{{ c.title | escape }}</span>
              <span class="mmd__go" aria-hidden="true"><svg viewBox="0 0 14 14" fill="none"><path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.4"/></svg></span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.promo_on -%}
      <a class="mmd__promo" href="{{ promo_url }}">
        {%- if promo_img -%}<span class="mmd__promo-img">{{ promo_img | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
        <span class="mmd__promo-in">
          {%- if s.promo_eyebrow != blank -%}<span class="mmd__promo-eye"><span class="mmd__dot" aria-hidden="true"></span>{{ s.promo_eyebrow }}</span>{%- endif -%}
          <span class="mmd__promo-h" style="display:block">{{ s.promo_heading }}</span>
          {%- if s.promo_sub != blank -%}<span class="mmd__promo-sub" style="display:block">{{ s.promo_sub }}</span>{%- endif -%}
          <span class="mmd__promo-cta">{{ s.promo_cta | default: 'Claim offer' }}<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h11M7.5 2.5 12 7l-4.5 4.5" stroke="currentColor" stroke-width="1.6"/></svg></span>
        </span>
      </a>
    {%- endif -%}

    {%- liquid
      assign singles = ''
      for l in m.links
        if l.title == shop_title
          continue
        endif
        if l.links.size == 0
          assign singles = singles | append: 'x'
        endif
      endfor
    -%}
    <div class="mmd__groups">
      {%- if singles != blank -%}
        <div class="mmd__group">
          <p class="mmd__label">{{ s.explore_label | default: 'Explore' }}</p>
          <ul role="list">
            {%- for l in m.links -%}
              {%- if l.title == shop_title or l.links.size > 0 -%}{%- continue -%}{%- endif -%}
              <li><a href="{{ l.url }}"{% if l.current %} aria-current="page"{% endif %}>{{ l.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- for l in m.links -%}
        {%- if l.title == shop_title or l.links.size == 0 -%}{%- continue -%}{%- endif -%}
        <div class="mmd__group">
          <p class="mmd__label">{{ l.title | escape }}</p>
          <ul role="list">
            {%- for c in l.links -%}
              <li><a href="{{ c.url }}"{% if c.current %} aria-current="page"{% endif %}>{{ c.title | strip | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="mmd__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a class="mmd__acct" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ s.login_url | default: routes.account_login_url }}{%- endif -%}" rel="nofollow">
          {%- if customer -%}My account{%- else -%}Log in{%- endif -%}
        </a>
      {%- else -%}<span></span>{%- endif -%}
      <ul class="mmd__social" role="list">
        {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{{- 'icon-instagram.svg' | inline_asset_content -}}</a></li>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{{- 'icon-tiktok.svg' | inline_asset_content -}}</a></li>{%- endif -%}
        {%- if settings.social_linkedin_link != blank -%}<li><a href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn">{{- 'icon-linkedin.svg' | inline_asset_content -}}</a></li>{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{{- 'icon-facebook.svg' | inline_asset_content -}}</a></li>{%- endif -%}
      </ul>
    </div>
  </div>
</template>
<script>
  /* Put the MUTO menu into the theme's drawer. The drawer's own script keeps opening, closing and focus. */
  (function () {
    function swap() {
      var d = document.getElementById('menu-drawer'), t = document.getElementById('mmd-tpl');
      if (!d || !t || d.classList.contains('mmd')) return;
      var box = d.querySelector('.menu-drawer__inner-container');
      if (!box) return;
      box.innerHTML = '';
      box.appendChild(t.content.cloneNode(true));
      d.classList.add('mmd');
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', swap); else swap();
    document.addEventListener('shopify:section:load', function () { var d = document.getElementById('menu-drawer'); if (d) d.classList.remove('mmd'); swap(); });
  })();
</script>

{% schema %}
{
  "name": "MUTO — Menu",
  "tag": "div",
  "class": "muto-menu",
  "settings": [
    { "type": "paragraph", "content": "The menu drawer (menu icon in the header). Shop products come from the menu's Shop link; other links are grouped under their parent." },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Blank: Main Menu New Drawer" },
    { "type": "text", "id": "eyebrow", "label": "Small line at the top", "default": "Cellular longevity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Above the standard, beneath the surface." },
    { "type": "url", "id": "shop_all_url", "label": "Shop all link (optional)" },
    { "type": "text", "id": "explore_label", "label": "Label for single links", "default": "Explore" },
    { "type": "url", "id": "login_url", "label": "Log in link", "info": "Blank: the store's log in page" },
    { "type": "header", "content": "Offer card" },
    { "type": "checkbox", "id": "promo_on", "label": "Show the offer card", "default": true },
    { "type": "text", "id": "promo_eyebrow", "label": "Small line", "default": "Black Friday · Live now" },
    { "type": "text", "id": "promo_heading", "label": "Heading", "default": "3 months for £99" },
    { "type": "text", "id": "promo_sub", "label": "Line under", "default": "Save 53% + a welcome kit worth £87" },
    { "type": "text", "id": "promo_cta", "label": "Button", "default": "Claim offer" },
    { "type": "url", "id": "promo_url", "label": "Link", "info": "Blank: NAD+ Cellular Complex" },
    { "type": "image_picker", "id": "promo_image", "label": "Image", "info": "Blank: the NAD+ product photo" }
  ],
  "presets": [{ "name": "MUTO — Menu" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
