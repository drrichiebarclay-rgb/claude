{%- comment -%}
  Site-wide sticky add to cart (rendered by muto-bf-head on every page that isn't a product page, the cart,
  password or gift card page, and by muto-sbar when no product is in scope). Steps aside if the page has its
  own sticky bar (a muto-sbar section, the home page's sticky cart, a landing page's offer bar, or any
  section whose id ends in "__sticky"). The same bar as the Black
  Friday product page (assets/muto-bf-sticky.css), but self-contained: there are no plan cards on this page,
  so the picker holds the two plans itself and the button adds the chosen one (variant + Skio selling plan,
  read from the product) to the cart, then opens the side cart.
  It has no id (class mc-sbar--site), so a page-level sticky section's script never picks up this bar, and
  its script finds its own bar, so if it is rendered twice (head + a sticky section with no product) only one stays.
{%- endcomment -%}
{%- liquid
  assign p = all_products['muto-nad-cellular-complex']
  assign q_v = ''
  assign q_p = ''
  assign m_v = ''
  assign m_p = ''
  if p != blank
    for pv in p.variants
      for alloc in pv.selling_plan_allocations
        assign n = alloc.selling_plan.name | downcase
        if q_v == blank and pv.available
          if n contains '3-month' or n contains '3 month' or n contains 'quarter'
            assign q_v = pv.id
            assign q_p = alloc.selling_plan.id
          endif
        endif
        if m_v == blank and pv.available
          if n contains '1-month' or n contains '1 month' or n contains 'monthly'
            assign m_v = pv.id
            assign m_p = alloc.selling_plan.id
          endif
        endif
      endfor
    endfor
  endif
-%}
{%- if q_v != blank -%}
  {{ 'muto-bf-sticky.css' | asset_url | stylesheet_tag }}
  {%- render 'muto-sbar-style' -%}
  <div class="mc-sbar mc-sbar--site" role="region" aria-label="Choose a plan and add to cart" aria-hidden="true">
    <div class="mc-sbar__in">
      <div class="mc-sbar__prod">
        {%- if p.featured_image -%}<img class="mc-sbar__img" src="{{ p.featured_image | image_url: width: 112 }}" width="56" height="56" alt="" loading="lazy">{%- endif -%}
        <div style="min-width:0">
          <p class="mc-sbar__name">{{ p.title }}</p>
          <p class="mc-sbar__offer"><i aria-hidden="true"></i>Black Friday · 3 months for £99</p>
        </div>
      </div>
      <label class="mc-sbar__pick">
        <span class="mc-sbar__pick-name" data-sbar-name>3-Month Supply (Save 53%)</span>
        <span class="mc-sbar__pick-sub" data-sbar-sub><b>£1.10 a day</b> · £99</span>
        <select class="mc-sbar__select" data-sbar-select aria-label="Plan">
          <option value="q" data-id="{{ q_v }}" data-plan="{{ q_p }}" data-name="3-Month Supply (Save 53%)" data-sub="£1.10 a day · £99">3-Month Supply (Save 53%) – £1.10 a day · £99</option>
          {%- if m_v != blank -%}<option value="m" data-id="{{ m_v }}" data-plan="{{ m_p }}" data-name="1-Month Supply (Save 28%)" data-sub="£1.79 a day · £49.99">1-Month Supply (Save 28%) – £1.79 a day · £49.99</option>{%- endif -%}
        </select>
      </label>
      <button type="button" class="mc-sbar__btn" data-sbar-add>
        <span class="mc-sbar__btn-full">Add to cart</span><span class="mc-sbar__btn-short">Add</span>
        <span class="mc-sbar__btn-price" data-sbar-price>£99</span>
      </button>
    </div>
  </div>
  <script>
  (function () {
    /* Its own bar: the element just before this script */
    var me = document.currentScript, bar = me && me.previousElementSibling;
    if (!bar || !bar.classList.contains('mc-sbar--site') || bar.dataset.ready) return;
    bar.dataset.ready = '1';
    /* Rendered twice: keep the first copy only */
    if (document.querySelector('.mc-sbar--site') !== bar) { bar.remove(); return; }
    /* A page with its own sticky bar keeps that one: this bar is removed before it is ever shown */
    var gone = false;
    function stepAside() {
      if (gone) return true;
      var others = [].slice.call(document.querySelectorAll('#MainContent [id$="__sticky"], [data-mh-sticky], .mlp-bar, .mc-sbar:not(.mc-sbar--site)')).filter(function (el) { return el !== bar && !el.contains(bar); });
      if (others.length) { gone = true; window.removeEventListener('scroll', onScroll); bar.remove(); }
      return gone;
    }
    document.addEventListener('DOMContentLoaded', stepAside);
    var sel = bar.querySelector('[data-sbar-select]'), btn = bar.querySelector('[data-sbar-add]');
    var nm = bar.querySelector('[data-sbar-name]'), sub = bar.querySelector('[data-sbar-sub]'), pr = bar.querySelector('[data-sbar-price]');
    sel.addEventListener('change', function () {
      var o = sel.options[sel.selectedIndex], parts = o.getAttribute('data-sub').split(' · ');
      nm.textContent = o.getAttribute('data-name');
      sub.innerHTML = '<b>' + parts[0] + '</b> · ' + parts[1];
      /* The price on the button, as on the product page's bar */
      if (pr) pr.textContent = parts[1] || '';
    });
    /* Open the theme's side cart (Dawn cart drawer) with fresh contents, as its own Add to cart does.
       Resolves false when the page has no drawer, so the caller can fall back to the cart page. */
    function openSideCart(root) {
      var d = document.querySelector('cart-drawer');
      if (!d || typeof d.renderContents !== 'function') return Promise.resolve(false);
      return fetch(root + '?sections=cart-drawer,cart-icon-bubble', { credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) { if (!s || !s['cart-drawer']) return false; d.renderContents({ sections: s }); return true; })
        .catch(function () { return false; });
    }
    btn.addEventListener('click', function () {
      var o = sel.options[sel.selectedIndex];
      var item = { id: parseInt(o.getAttribute('data-id'), 10), quantity: 1 };
      if (o.getAttribute('data-plan')) item.selling_plan = parseInt(o.getAttribute('data-plan'), 10);
      btn.setAttribute('aria-busy', 'true');
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      fetch(root + 'cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [item] }) })
        .then(function (r) {
          if (!r.ok) { window.location.href = '{{ p.url }}'; return; }
          /* Open the side cart; no side cart on the page, the cart page */
          openSideCart(root).then(function (opened) {
            if (opened) btn.removeAttribute('aria-busy');
            else window.location.href = root + 'cart';
          });
        })
        .catch(function () { window.location.href = '{{ p.url }}'; });
    });
    /* Shows once the intro has scrolled away (and only if no other sticky bar is on the page) */
    function onScroll() {
      if (stepAside()) return;
      var on = (window.pageYOffset || document.documentElement.scrollTop) > 500;
      bar.classList.toggle('is-visible', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      if ('inert' in bar) bar.inert = !on;
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
  </script>
{%- endif -%}
