{%- comment -%}
  MUTO — Benefit cards.
  A heading and a line on the left, a button on the right (by default it opens
  the "MUTO — Test results" panel at its Formula tab), then a row of tall photo
  cards, one per benefit. Each card's name and line sit on a frosted panel at
  the foot of the photo, every panel as tall as the tallest so they line up. The row scrolls sideways with arrows on desktop and a
  swipe on phones.

  BLOCKS: one "Card" per benefit, each with a photo (or a photo URL), a name
  and a line.
{%- endcomment -%}
{{ 'muto-crea.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sid = section.id
  assign s = section.settings
-%}
<style>
  #shopify-section-{{ sid }} h2,#shopify-section-{{ sid }} h3{font-family:var(--mc-font);font-weight:500;-webkit-font-smoothing:antialiased;margin:0}
  #shopify-section-{{ sid }} .mbc{padding-top:{{ s.space_top }}px;padding-bottom:{{ s.space_bottom }}px;background:var(--mc-ground)}
  #shopify-section-{{ sid }} .mbc__head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px 48px;align-items:end}
  #shopify-section-{{ sid }} .mbc__h{color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mbc__lede{grid-column:1;margin:16px 0 0;max-width:760px;font-size:20px;line-height:1.45;color:var(--mc-ink-alt)}
  #shopify-section-{{ sid }} .mbc__side{grid-column:2;grid-row:1 / span 2;display:flex;gap:10px;align-items:center}
  #shopify-section-{{ sid }} .mbc__btn{display:inline-flex;align-items:center;gap:10px;height:56px;padding:0 26px;border:1px solid var(--mc-ink);border-radius:28px;background:none;font:inherit;font-family:var(--mc-font);font-size:16px;font-weight:500;color:var(--mc-ink);text-decoration:none;cursor:pointer;white-space:nowrap}
  #shopify-section-{{ sid }} .mbc__btn:hover{background:var(--mc-ink);color:#fff}
  #shopify-section-{{ sid }} .mbc__arrow{display:grid;place-items:center;width:56px;height:56px;border:1px solid var(--mc-hair);border-radius:50%;background:#fff;color:var(--mc-ink);cursor:pointer}
  #shopify-section-{{ sid }} .mbc__arrow:hover{border-color:var(--mc-ink)}
  #shopify-section-{{ sid }} .mbc__arrow[disabled]{opacity:.35;cursor:default}
  #shopify-section-{{ sid }} .mbc__btn:focus-visible,#shopify-section-{{ sid }} .mbc__arrow:focus-visible{outline:2px solid var(--mc-ink);outline-offset:2px}
  #shopify-section-{{ sid }} .mbc__row{display:flex;gap:20px;margin-top:44px;padding:0 var(--mc-gutter,20px) 8px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 var(--mc-gutter,20px);scrollbar-width:none;overscroll-behavior-x:contain}
  #shopify-section-{{ sid }} .mbc__row::-webkit-scrollbar{display:none}
  @media (min-width:1440px){#shopify-section-{{ sid }} .mbc__row{padding-left:calc((100vw - var(--mc-max,1400px)) / 2 + var(--mc-gutter,20px));scroll-padding-left:calc((100vw - var(--mc-max,1400px)) / 2 + var(--mc-gutter,20px))}}
  #shopify-section-{{ sid }} .mbc__card{position:relative;flex:0 0 clamp(280px,30vw,440px);aspect-ratio:4/5.4;border-radius:12px;overflow:hidden;background:var(--mc-ink);scroll-snap-align:start;color:#fff;margin:0}
  #shopify-section-{{ sid }} .mbc__card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  /* The panel is the photo itself, blurred and darkened, so it takes the photo's colour */
  #shopify-section-{{ sid }} .mbc__panel{position:absolute;left:0;right:0;bottom:0;padding:24px 26px 26px;background:linear-gradient(to bottom,rgba(22,47,49,.35),rgba(22,47,49,.7));-webkit-backdrop-filter:blur(18px) saturate(1.1);backdrop-filter:blur(18px) saturate(1.1)}
  #shopify-section-{{ sid }} .mbc__n{display:block;margin-bottom:10px;font-family:var(--mc-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.7)}
  #shopify-section-{{ sid }} .mbc__t{font-size:clamp(28px,2.6vw,40px);line-height:1;letter-spacing:-.012em;text-transform:uppercase;color:#fff}
  #shopify-section-{{ sid }} .mbc__x{margin:10px 0 0;font-size:16px;line-height:1.45;color:rgba(255,255,255,.88)}
  #shopify-section-{{ sid }} .mbc__foot{margin:20px 0 0;font-size:13px;line-height:1.5;color:var(--mc-muted)}
  @media (max-width:749px){
    #shopify-section-{{ sid }} .mbc{padding-top:{{ s.space_top | times: 0.6 | round }}px;padding-bottom:{{ s.space_bottom | times: 0.6 | round }}px}
    #shopify-section-{{ sid }} .mbc__head{grid-template-columns:1fr}
    #shopify-section-{{ sid }} .mbc__side{grid-column:1;grid-row:auto}
    #shopify-section-{{ sid }} .mbc__arrow{display:none}
    #shopify-section-{{ sid }} .mbc__lede{font-size:16px}
    #shopify-section-{{ sid }} .mbc__btn{height:48px;padding:0 20px;font-size:15px}
    #shopify-section-{{ sid }} .mbc__row{gap:12px;margin-top:28px}
    #shopify-section-{{ sid }} .mbc__card{flex-basis:78%}
    #shopify-section-{{ sid }} .mbc__panel{padding:18px 18px 20px}
    #shopify-section-{{ sid }} .mbc__x{font-size:15px}
  }
</style>

<div class="mc mbc" data-mbc>
  <div class="mc__wrap">
    <div class="mbc__head">
      <h2 class="mc__h2 mbc__h">{{ s.heading | escape | newline_to_br }}</h2>
      {%- if s.lede != blank -%}<p class="mbc__lede">{{ s.lede }}</p>{%- endif -%}
      <div class="mbc__side">
        {%- if s.button_label != blank -%}
          {%- if s.button_link != blank -%}
            <a class="mbc__btn" href="{{ s.button_link }}"><span aria-hidden="true">+</span>{{ s.button_label }}</a>
          {%- else -%}
            <button type="button" class="mbc__btn" data-mtr-open="{{ s.button_tab }}"><span aria-hidden="true">+</span>{{ s.button_label }}</button>
          {%- endif -%}
        {%- endif -%}
        <button type="button" class="mbc__arrow" data-mbc-prev aria-label="Previous"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M11 3 5 9l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="mbc__arrow" data-mbc-next aria-label="Next"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="m7 3 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
  </div>
  <ul class="mbc__row" role="list" data-mbc-row>
    {%- for block in section.blocks -%}
      <li class="mbc__card" {{ block.shopify_attributes }}>
        {%- assign pos = '' -%}{%- if block.settings.position != blank -%}{%- assign pos = 'object-position:' | append: block.settings.position -%}{%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '440,660,900', sizes: '(min-width: 750px) 30vw, 78vw', alt: '', style: pos }}
        {%- elsif block.settings.image_fallback != blank -%}
          <img src="{{ block.settings.image_fallback }}" alt="" loading="lazy" width="900" height="1215"{% if block.settings.position != blank %} style="object-position:{{ block.settings.position }}"{% endif %}>
        {%- endif -%}
        <div class="mbc__panel">
          <span class="mbc__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="mbc__t">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="mbc__x">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
  {%- if s.foot != blank -%}<div class="mc__wrap"><p class="mbc__foot">{{ s.foot }}</p></div>{%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ sid }} [data-mbc]');
    if (!root) return;
    var row = root.querySelector('[data-mbc-row]'), prev = root.querySelector('[data-mbc-prev]'), next = root.querySelector('[data-mbc-next]');
    function step() { var c = row.querySelector('.mbc__card'); return c ? c.getBoundingClientRect().width + 20 : 300; }
    function sync() {
      prev.disabled = row.scrollLeft < 4;
      next.disabled = row.scrollLeft + row.clientWidth > row.scrollWidth - 4;
    }
    prev.addEventListener('click', function () { row.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { row.scrollBy({ left: step(), behavior: 'smooth' }); });
    row.addEventListener('scroll', sync, { passive: true });
    /* Every panel as tall as the tallest, so their tops line up across the row */
    var panels = [].slice.call(row.querySelectorAll('.mbc__panel'));
    function even() {
      panels.forEach(function (p) { p.style.minHeight = ''; });
      var h = Math.ceil(Math.max.apply(null, panels.map(function (p) { return p.getBoundingClientRect().height; })));
      if (h > 0) panels.forEach(function (p) { p.style.minHeight = h + 'px'; });
    }
    window.addEventListener('resize', function () { sync(); even(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(even);
    sync(); even();
  })();
</script>

{% schema %}
{
  "name": "MUTO — Benefit cards",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Line under the heading" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "View ingredients" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Blank: opens the test results panel on this page at the tab below." },
    { "type": "select", "id": "button_tab", "label": "Test results tab to open", "default": "3", "options": [
      { "value": "1", "label": "Overview" }, { "value": "2", "label": "Full results" }, { "value": "3", "label": "Formula" }, { "value": "4", "label": "Why it matters" }
    ] },
    { "type": "textarea", "id": "foot", "label": "Small print under the cards" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_fallback", "label": "Photo URL (if no photo picked)" },
      { "type": "text", "id": "position", "label": "Photo focus", "info": "e.g. 50% 30%" },
      { "type": "text", "id": "title", "label": "Name" },
      { "type": "textarea", "id": "text", "label": "Line" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "MUTO — Benefit cards" }],
  "enabled_on": { "templates": ["product", "page", "index"] }
}
{% endschema %}
