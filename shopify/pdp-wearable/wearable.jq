(getpath(["sections", "head_styles", "settings", "custom_liquid"]) | split("{%- comment -%} The buy box's own snippets (styles + scripts), loaded before the buy box so the first thing drawn is the finished design; each piece is placed the moment its spot exists (muto-bf-early). {%- endcomment -%}\n{%- render 'muto-bf-early' -%}\n{%- render 'muto-bf-ag1-plans' -%}\n{%- render 'muto-bf-video-reviews' -%}\n{%- render 'muto-bf-review-box' -%}\n{%- render 'muto-bf-buybox-copy' -%}\n{%- render 'muto-bf-mars' -%") | join("<script>document.body.classList.add('template-muto-nad-bf-premium');</script>\n{%- comment -%} The buy box's own snippets (styles + scripts), loaded before the buy box so the first thing drawn is the finished design; each piece is placed the moment its spot exists (muto-bf-early). {%- endcomment -%}\n{%- render 'muto-bf-early' -%}\n{%- render 'muto-bf-ag1-plans' -%}\n{%- render 'muto-bf-video-reviews' -%}\n{%- capture mw_rv -%}{%- render 'muto-bf-review-box' -%}{%- endcapture -%}{{ mw_rv | replace: '>Thinking about the next 20 years</button>', '>Playing the long game</button>' | replace: '>Flat by 3pm</button>', '>Energy flat despite good sleep</button>' | replace: '>Slower to bounce back</button>', '>Recovery score stuck</button>' }}\n{%- capture mw_bbc -%}{%- render 'muto-bf-buybox-copy' -%}{%- endcapture -%}{{ mw_bbc | replace: 'Designed for over 35s', 'For over-30s who track their recovery' | replace: 'is two capsules a day with 19 nutrients at full dose, created by scientists to support your energy, recovery and healthy ageing.', 'is the layer under sleep, training and food: 300mg NR, which your body turns into NAD<sup>+</sup>, the molecule your mitochondria use to make energy, plus 18 nutrients at full dose. Two capsules a day.' | replace: '<b>Got a wearable device? Track the shift on your metrics over weeks and months.</b>', '<b>Take a 7-day baseline on your wearable, then read your 30-day averages of HRV, sleep and recovery.</b>' | replace: 'No wearable? Tracking isn’t for everyone. A weekly check-in with yourself works too. Set a reminder, notice the difference, and if you don’t by day 90, you get every payment back.', 'Single nights are noise, months are signal. If you don’t see a difference by day 90, you get every subscription payment back.' }}\n{%- capture mw_mars -%}{%- render 'muto-bf-mars' -%}{%- endcapture -%}{{ mw_mars | replace: 'More energy, fewer afternoon crashes</li>', 'The biology behind your energy</li>' | replace: 'Recover in time to go again</li>', 'Ready for the next session</li>' | replace: 'Built for the years ahead</li>', 'Built to be tracked on your wearable</li>' }")) as $v | setpath(["sections", "head_styles", "settings", "custom_liquid"]; $v) | (getpath(["sections", "ag1_plans", "settings", "custom_liquid"]) | split("render 'muto-bf-jobs' -%") | join("capture mw_jobs -%}{%- render 'muto-bf-jobs' -%}{%- endcapture -%}{{ mw_jobs | replace: 'Not everybody is a 25-year-old PT.', 'The basics are done.' | replace: 'Your life won’t fit a perfect routine.<br class=\"mc-jobs__br\"> Your body still needs one.', 'Good sleep. Smart training.<br class=\"mc-jobs__br\"> Same flat line.' | replace: 'You can’t always sleep, train and eat perfectly. MUTO gives your body a daily foundation anyway, so you can keep showing up for work, training and the people who rely on you, now and for years to come.', 'You’ve done the work: the bedtime, the training plan, the protein, less wine. Your HRV, sleep and recovery scores still sit where they sat months ago. MUTO is the layer underneath the basics, built to be checked on the device you already wear.' | replace: '<h3>Afternoons that hold</h3>', '<h3>The cell-level layer</h3>' | replace: 'Flat by 3pm? Vitamins B6, B12 and folate help reduce tiredness and fatigue.', '300mg NR, which your body turns into NAD<sup>+</sup>. Vitamins B6, B12 and folate contribute to the reduction of tiredness and fatigue.' | replace: 'For the sessions you care about. Vitamin D supports normal muscle function.', 'For the sessions you care about. Vitamin D contributes to normal muscle function.' | replace: '<h3>Made for a full life</h3>', '<h3>One clean variable</h3>' | replace: 'Travel, deadlines, small kids. Two capsules with breakfast. Nothing to mix, nothing to carry.', 'Change one thing, so if your numbers move, you know why. Two capsules with breakfast.' }")) as $v | setpath(["sections", "ag1_plans", "settings", "custom_liquid"]; $v) | setpath(["sections", "bf_style", "settings", "design"]; "premium") | setpath(["sections", "buy", "blocks", "job1", "settings", "title"]; "The biology behind your energy") | setpath(["sections", "buy", "blocks", "job2", "settings", "title"]; "Ready for the next session") | setpath(["sections", "buy", "blocks", "job4", "settings", "label"]; "Tracking") | setpath(["sections", "buy", "blocks", "job4", "settings", "title"]; "Built to be checked on your wearable") | setpath(["sections", "buy", "blocks", "fold1", "settings", "title"]; "Is it for you?") | setpath(["sections", "buy", "blocks", "fold1", "settings", "text"]; "<p><strong>For people who already do the basics well</strong>: you sleep, train and eat with intent, you track it, and your HRV, sleep or recovery scores have sat on the same flat line for months anyway.</p><p>Most of our customers are in their 30s, 40s and 50s. Works with Garmin, WHOOP, Oura, Apple Watch, Polar and others, or a weekly 1–10 check-in if you don’t wear one. Adults only; not during pregnancy or breastfeeding.</p>") | setpath(["sections", "buy", "blocks", "fold_benefits", "settings", "text"]; "<p>You already sleep, train and eat with intent. This is the layer underneath: what your cells do with all of it.</p><ul><li><strong>Energy at the cell level.</strong> 300mg NR, which your body turns into NAD+, the molecule your mitochondria use to make energy, with CoQ10 and PQQ alongside. B vitamins, including 100mcg of active B12, contribute to the reduction of tiredness and fatigue.</li><li><strong>Ready for the next session.</strong> 50mcg of vitamin D3 contributes to normal muscle function.</li><li><strong>Built to be checked.</strong> Take a 7-day baseline of HRV, resting heart rate, sleep and recovery, then compare 30-day averages at day 30, 60 and 90.</li><li><strong>One clean variable.</strong> 19 ingredients at full dose in two capsules, every one on the label, so if your numbers move, you know what changed.</li></ul><p><strong>Your data. Your verdict. 90 days to decide.</strong></p>") | setpath(["sections", "buy", "settings", "heading"]; "Doing the basics right? Your numbers still won’t move.") | setpath(["sections", "survey", "block_order"]; ["r4", "r2", "r3", "r1"]) | setpath(["sections", "survey", "settings", "heading"]; "What 87 customers reported.") | setpath(["sections", "survey", "settings", "lede"]; "We asked 87 men and women aged 30 to 50 who take MUTO what had changed, on their own wearables and in how they feel. Tap a result to see it.") | setpath(["sections", "reviews_ticker", "block_order"]; ["q11", "q9", "q8", "q10", "q2", "q18", "q13", "q4", "q1", "q3", "q5", "q6", "q7", "q12", "q14", "q15", "q16", "q17", "q19", "q20"]) | setpath(["sections", "nav", "blocks", "n1", "settings", "label"]; "Why it stalls") | setpath(["sections", "nav", "blocks", "n2", "settings", "label"]; "The biology") | setpath(["sections", "nav", "blocks", "n9", "settings", "label"]; "The 90-day test") | setpath(["sections", "problem", "blocks", "p1", "settings", "text"]; "<strong class=\"prb-why\">Why the same effort costs more.</strong><span class=\"prb-how\">Your muscles’ capacity to make energy roughly halves between your late 30s and late 60s, however well you train.</span>") | setpath(["sections", "problem", "blocks", "p2", "settings", "tag"]; "Sleep") | setpath(["sections", "problem", "blocks", "p2", "settings", "text"]; "<strong class=\"prb-why\">Why your sleep score plateaus.</strong><span class=\"prb-how\">About 80% less deep sleep in your 40s than at 20, even with a perfect bedtime. Deep sleep is when your body recovers.</span>") | setpath(["sections", "problem", "blocks", "p3", "settings", "tag"]; "Strength") | setpath(["sections", "problem", "blocks", "p3", "settings", "text"]; "<strong class=\"prb-why\">Why you have to work harder to hold it.</strong><span class=\"prb-how\">The muscle adults lose each decade after 30, unless they keep using it.</span>") | setpath(["sections", "problem", "settings", "label"]; "Why your numbers stall") | setpath(["sections", "problem", "settings", "heading"]; "You’ve fixed the basics.\nYour biology still changed.") | setpath(["sections", "benefits", "blocks", "b1", "settings", "outcome"]; "Energy at the cell level") | setpath(["sections", "benefits", "blocks", "b1", "settings", "text"]; "NAD+ sits at the centre of how your mitochondria turn food into usable energy. MUTO gives you 300mg NR, the most allowed in Great Britain, which your body turns into NAD+, with CoQ10 and PQQ alongside. Vitamins B2, B3, B6, B12 and folate contribute to the reduction of tiredness and fatigue.") | setpath(["sections", "benefits", "blocks", "b2", "settings", "outcome"]; "Ready for the next session") | setpath(["sections", "benefits", "blocks", "b2", "settings", "text"]; "Your recovery or readiness score is a read-out of how well you’ve bounced back. Vitamin D contributes to normal muscle function, and most of us in the UK get too little sun from October to March. Many customers tell us they notice recovery within the first month.") | setpath(["sections", "benefits", "blocks", "b4", "settings", "title"]; "The long game") | setpath(["sections", "benefits", "blocks", "b4", "settings", "outcome"]; "The trend, not the night") | setpath(["sections", "benefits", "blocks", "b4", "settings", "text"]; "Zinc, copper and vitamin B2 contribute to the protection of cells from oxidative stress, alongside 300mg NR, TMG, trans-resveratrol and grape seed. This is the baseline you build over months and years, not overnight.") | setpath(["sections", "benefits", "settings", "eyebrow"]; "The biology") | setpath(["sections", "benefits", "settings", "heading"]; "What’s underneath\nyour numbers.") | setpath(["sections", "benefits", "settings", "lede"]; "Sleep, training and food are your inputs. Inside every cell, NAD+ and your mitochondria turn them into the energy you train and recover on, and NAD+ levels fall with age. Tap one to see what’s behind it, dose by dose.") | setpath(["sections", "timeline", "blocks", "m1", "settings", "title"]; "Take your baseline") | setpath(["sections", "timeline", "blocks", "m1", "settings", "text"]; "<p>Before your first capsule, note your 7-day averages: HRV, resting heart rate, sleep and your recovery or readiness score. Add a 1–10 for how your energy feels. Then take two capsules with breakfast: CoQ10 and vitamins D3 and K2 dissolve in fat, so food helps your body take them in.</p>") | setpath(["sections", "timeline", "blocks", "m1", "settings", "proof"]; "Same device, same time of day, for the whole 90 days.") | setpath(["sections", "timeline", "blocks", "m1b", "settings", "title"]; "Feel it before you see it") | setpath(["sections", "timeline", "blocks", "m1b", "settings", "text"]; "<p>Energy is usually what people notice first, before anything shows in their data. B vitamins contribute to the reduction of tiredness and fatigue. If nothing’s obvious yet, that’s normal, because every body runs on its own clock.</p>") | setpath(["sections", "timeline", "blocks", "m1b", "settings", "proof"]; "Too early to read a trend. Keep the rest of your routine steady.") | setpath(["sections", "timeline", "blocks", "m2", "settings", "title"]; "Your first read") | setpath(["sections", "timeline", "blocks", "m2", "settings", "text"]; "<p>Compare your 30-day averages with your baseline. Many customers tell us they bounce back from hard sessions sooner by now, and that the steadier days have stopped feeling like a lucky week.</p>") | setpath(["sections", "timeline", "blocks", "m2", "settings", "proof"]; "Read the 30-day line, never a single morning.") | setpath(["sections", "timeline", "blocks", "m3", "settings", "title"]; "Read around the noise") | setpath(["sections", "timeline", "blocks", "m3", "settings", "text"]; "<p>Training blocks, alcohol, travel and illness all move HRV and sleep. Mark them, read around them, and look at whether your baseline itself has shifted. Vitamin D contributes to normal muscle function.</p>") | setpath(["sections", "timeline", "blocks", "m3", "settings", "proof"]; "Check sleep, training load, alcohol and travel before you judge.") | setpath(["sections", "timeline", "blocks", "m4", "settings", "title"]; "Your data, your verdict") | setpath(["sections", "timeline", "blocks", "m4", "settings", "text"]; "<p>Put day 90 next to day 1. If your numbers and your days say keep going, keep going. If it isn’t for you, email us within 14 days and you get every subscription payment back, less delivery.</p>") | setpath(["sections", "timeline", "blocks", "m4", "settings", "proof"]; "Fewer than 1 in 1,000 people ask for a refund.") | setpath(["sections", "timeline", "settings", "eyebrow"]; "The 90-day test") | setpath(["sections", "timeline", "settings", "heading"]; "Run it like\nan experiment.") | setpath(["sections", "timeline", "settings", "lede"]; "One new variable, a clean baseline and enough time to read a trend. Keep the rest of your routine steady, so your data can tell you something.") | delpaths([["sections", "quotes", "blocks", "q3", "disabled"]]) | delpaths([["sections", "quotes", "blocks", "q4", "disabled"]]) | delpaths([["sections", "quotes", "blocks", "q6", "disabled"]]) | setpath(["sections", "quotes", "blocks", "q8", "disabled"]; true) | setpath(["sections", "quotes", "blocks", "q9", "disabled"]; true) | setpath(["sections", "faq", "blocks", "q5", "settings", "text"]; "<p>You don’t have to take our word for it. Before your first capsule, note your wearable’s 7-day averages for HRV, resting heart rate, sleep and recovery: that’s your baseline. Compare your 30-day averages at day 30, 60 and 90, and read the trend, not single nights. Training load, alcohol, travel and illness all move the numbers, so mark them as you go.</p>") | setpath(["sections", "faq", "blocks", "qb"]; {"type": "q", "settings": {"title": "I already sleep, train and eat well. What’s left?", "text": "<p>That’s exactly who MUTO is for. Good habits set your inputs. NAD+, which falls with age, is part of how your cells turn those inputs into energy, and 300mg of NR a day raised blood NAD+ by about half in a published study (Conze et al., Scientific Reports, 2019, a study of NR, not of MUTO).</p><p>We won’t promise what it does to your numbers. Take a baseline, keep the rest steady, and judge it on your own data over 90 days.</p>"}}) | setpath(["sections", "faq", "blocks", "qh"]; {"type": "q", "settings": {"title": "Will it improve my HRV?", "text": "<p>We won’t promise what any number will do. Take a 7-day baseline, read 30-day averages rather than single nights, and judge it yourself over 90 days. If you don’t see a difference, you’re covered.</p>"}}) | setpath(["sections", "faq", "blocks", "qd"]; {"type": "q", "settings": {"title": "Which devices work?", "text": "<p>Any device that records HRV, resting heart rate and sleep: Garmin, WHOOP, Oura, Apple Watch, Polar, Coros and others. Use the same one for the whole 90 days. No device? A weekly 1–10 check-in works too.</p>"}}) | setpath(["sections", "faq", "block_order"]; ["qb", "qh", "q5", "qd", "q4", "q16", "q2", "q6", "q14", "q10", "q9", "q15", "q11", "q13", "q12", "q3", "q1", "q7", "q8"])
