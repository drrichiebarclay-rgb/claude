        "simple": {
          "type": "text",
          "settings": {
            "kicker": "",
            "heading": "Two capsules. <em>Every morning.</em>",
            "body": "<p><strong>MUTO NAD+ Cellular Complex</strong> is two capsules with breakfast. That’s it.</p><ul><li>Nothing to mix, nothing to carry around</li><li>No caffeine and no stimulants, so nothing to crash from</li><li>One jar in place of a cupboard full of pots</li><li>A habit as easy as brushing your teeth</li></ul><p>It was made by a cell biologist for adults over 35. You don’t need to be sporty, and you don’t need a smartwatch.</p>",
            "key": ""
          }
        },
        "jar": {
          "type": "image",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0976/2724/2843/files/lp-over-35-hero.jpg?v=1794239299",
            "image_alt": "A woman at her kitchen table in morning light, taking a capsule beside a glass of water and a jar of MUTO NAD+ Cellular Complex",
            "image_position": "50% 100%",
            "caption": ""
