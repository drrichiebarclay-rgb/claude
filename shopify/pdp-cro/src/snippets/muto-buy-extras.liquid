{%- comment -%}
  MUTO — buy box extras (muto-buy-extras). Rendered once by the "MUTO BF style" section.
  Adds three things to the product page's buy box:
    1. (The "High demand … welcome kits left" pill was removed at Richie's request, 19 Nov.)
    2. "Black Friday is live" banner with a countdown that runs out at the end of each day: it counts to
       9pm UK time, the real cut-off for next-day delivery ("Order before 9pm and receive it next day"), and
       starts again for the next day's cut-off. The line under the offer says "Order by 9pm for next-day
       delivery", so the timer reads as the delivery cut-off, NOT as the end of the offer: a timer that says the offer ends tonight and then resets is false urgency (banned in the UK
       under the DMCC Act 2024). If the cut-off time changes, change CUTOFF_HOUR in the script.
    3. The value line ("Replaces 5 supplements in one", with the price per day for the first 3 months) above the
       plan cards, and the control line ("You're in charge…") under them and above the buy button. On
       phones both sit in the buy block: the value line at its top, the control line above the button.
       The list of what the jar replaces must match the FAQ answer "What does it replace…".
    4. The payment icons under the "Arrives by … Tracked 24h" line: every card and payment type the shop
       has switched on (Shopify's own list, shop.enabled_payment_types) except those in mpay_skip
       (Bancontact, Diners Club, Discover, JCB, UnionPay, MB WAY, Satispay), kept to one row, plus Klarna if it is not already in
       that list (asked for by Richie, 19 Nov; take the Klarna line out below if Klarna is not offered).
  They are placed by the script below because the buy box's parts are arranged by other files.
{%- endcomment -%}
{%- liquid
  assign bx_left = shop.metafields.muto.bf_orders_left.value
  assign bx_left_n = bx_left | plus: 0
-%}
<style>
  .mbx,.mbx p,.mbf,.mbf p{font-family:var(--mc-font,"Neue Haas Grotesk Display Pro"),sans-serif;-webkit-font-smoothing:antialiased}
  .mbx{order:-4;display:grid;gap:10px;justify-items:start;width:100%;box-sizing:border-box;margin:0 0 16px}
  .mbx__hot{display:inline-flex;align-items:center;gap:9px;margin:0;padding:6px 14px 6px 10px;border-radius:999px;background:#fbe9e7;color:#b3261e;font-size:14px;font-weight:500;line-height:1.3}
  .mbx__dot{position:relative;flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:#b3261e}
  .mbx__dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;background:rgba(179,38,30,.22);animation:mbx-pulse 1.8s ease-out infinite}
  @keyframes mbx-pulse{0%{transform:scale(.5);opacity:1}100%{transform:scale(1.5);opacity:0}}
  .mbx__bar{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;box-sizing:border-box;padding:14px 16px 14px 20px;border-radius:12px;background:#242223;color:#fff}
  .mbx__t{display:grid;gap:3px;min-width:0}
  .mbx__t b{font-size:19px;font-weight:500;line-height:1.15;letter-spacing:-.01em;text-transform:uppercase}
  .mbx__t span{font-size:13.5px;line-height:1.3;color:rgba(255,255,255,.78)}
  .mbx__t i{font-style:normal;color:#5efaff}
  .mbx__by{display:block;margin-top:2px;font-style:normal;font-size:.88em;color:rgba(255,255,255,.62)}
  .mbx__cd{flex:0 0 auto;display:flex;align-items:center;gap:6px}
  .mbx__cap{margin-right:4px;font-size:11.5px;line-height:1.25;text-align:right;color:rgba(255,255,255,.78)}
  .mbx__cd[hidden]{display:none}
  .mbx__u{display:grid;justify-items:center;gap:1px;min-width:44px;padding:7px 4px 6px;border-radius:8px;background:#fff;color:#242223}
  .mbx__u b{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:18px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
  .mbx__u span{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#5c5a5b}
  @media (max-width:749px){
    .mbx{margin:16px 0 4px}
    .mbx__bar{padding:12px 12px 12px 14px;gap:10px}
    .mbx__t b{font-size:15.5px}
    .mbx__t span{font-size:12px}
    .mbx__cd{gap:4px}
    .mbx__cap{font-size:10px;margin-right:2px}
    .mbx__u{min-width:36px;padding:6px 2px 5px}
    .mbx__u b{font-size:15px}
    .mbx__u span{font-size:8px}
  }
  @media (prefers-reduced-motion:reduce){.mbx__dot::after{animation:none}}
  /* The buy box orders its parts with CSS "order"; these keep the widget above the headline and the notes
     straight after the plan cards, whatever the theme's own rules give other children. */
  html:root body #MainContent#MainContent .mc .mc__buy-copy > .mbx{order:-4!important}
  html:root body #MainContent#MainContent .mc .mc__buy-copy > .mbf--plans{order:2!important}

  /* Payment icons under the "Arrives by" line */
  .mpay{display:flex;flex-wrap:nowrap;justify-content:center;gap:5px;width:100%;margin:14px 0 0;padding:0;list-style:none}
  .mpay li{flex:0 1 38px;min-width:0;margin:0;padding:0;line-height:0}
  .mpay li::before{content:none!important}
  .mpay__i{display:block;width:100%;height:auto}
  /* Subscription flexibility, beside the plan selector */
  .mbf{order:2;display:flex;align-items:flex-start;gap:10px;width:100%;box-sizing:border-box;margin:12px 0 0;padding:12px 14px;border-radius:10px;background:#f4f2ef;color:#242223;font-size:14px;line-height:1.45}
  .mbf svg{flex:0 0 auto;width:18px;height:18px;margin-top:1px}
  .mbf p{margin:0}
  .mbf b{font-weight:500}
  .mbf--o{margin:12px 0 0}
  .mbf--v{background:#fff;border:1px solid rgba(36,34,35,.14);margin:0 0 12px}
  .mbf--o:not(.mbf--v){margin:0 0 12px}
  @media (max-width:749px){
    .mbf{font-size:13.5px}
    /* Phones: the value line follows the Informed Sport box, so it gets the same gap above as below, and
       the plan cards sit closer underneath */
    html:root body #MainContent#MainContent .mc .mc__buy-copy > .mbf--plans.mbf--v{margin:12px 0 0!important}
    html:root body #MainContent#MainContent#MainContent#MainContent#MainContent [id$="__buy"] .mc .mc__buy-copy > .mbf--v + .mc__plans{margin-top:16px!important}
    html:root body #MainContent#MainContent .mc .mc__buy-copy > .mc-links .mis{margin-top:16px}
  }
  /* The copies made for the compact phone block are not used now that phones show the plan cards */
  .mbf--o{display:none}
</style>
<template data-mbx-tpl>
  <div class="mbx" data-mbx>
    <div class="mbx__bar">
      <p class="mbx__t"><b>Black Friday is live</b><span><i>53% off</i> your first 3 months<em class="mbx__by">Order by 9pm for next-day delivery</em></span></p>
      <div class="mbx__cd" data-mbx-cd role="timer" aria-label="Time left to order for next-day delivery" hidden>
        <span class="mbx__u"><b data-u="h">00</b><span>Hrs</span></span>
        <span class="mbx__u"><b data-u="m">00</b><span>Min</span></span>
        <span class="mbx__u"><b data-u="s">00</b><span>Sec</span></span>
      </div>
    </div>
  </div>
</template>
<template data-mbv-tpl>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M17 15l2 2 3-4"/></svg>
  <p><b>Replaces 5 supplements in one.</b> NR, CoQ10, resveratrol, vitamin D3 + K2 and a B complex, in two capsules. <b>£1.10 a day</b> for your first 3 months.</p>
</template>
<template data-mpay-tpl>
  <ul class="mpay" aria-label="Payment methods we accept">
    {%- assign mpay_has_klarna = false -%}
    {%- assign mpay_skip = 'bancontact,diners_club,discover,jcb,unionpay,mbway,satispay' | split: ',' -%}
    {%- for type in shop.enabled_payment_types -%}
      {%- if mpay_skip contains type -%}{%- continue -%}{%- endif -%}
      {%- if type == 'klarna' or type == 'klarna-pay-later' or type == 'klarna-slice-it' or type == 'klarna-pay-now' -%}{%- assign mpay_has_klarna = true -%}{%- endif -%}
      <li>{{ type | payment_type_svg_tag: class: 'mpay__i' }}</li>
    {%- endfor -%}
    {%- unless mpay_has_klarna -%}<li>{{ 'klarna' | payment_type_svg_tag: class: 'mpay__i' }}</li>{%- endunless -%}
  </ul>
</template>
<template data-mbf-tpl>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v5h-5"/></svg>
  <p><b>You’re in charge.</b> Skip, pause or cancel online with 2 clicks. No phone calls. We email you 5 days before every payment.</p>
</template>
<script>
  (function () {
    var tx = document.querySelector('template[data-mbx-tpl]'), tf = document.querySelector('template[data-mbf-tpl]');
    var tv = document.querySelector('template[data-mbv-tpl]');
    function note(cls, t) { var d = document.createElement('div'); d.className = 'mbf ' + cls; d.appendChild((t || tf).content.cloneNode(true)); return d; }
    var CUTOFF_HOUR = 21; /* 9pm UK time: the next-day delivery cut-off */
    function ukSeconds() {
      /* Seconds since midnight in the UK, whatever the visitor's own time zone */
      try {
        var p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()), o = {};
        p.forEach(function (x) { o[x.type] = parseInt(x.value, 10); });
        return o.hour * 3600 + o.minute * 60 + o.second;
      } catch (e) { var d = new Date(); return d.getUTCHours() * 3600 + d.getUTCMinutes() * 60 + d.getUTCSeconds(); }
    }
    function tick(cd) {
      var left = (CUTOFF_HOUR * 3600 - ukSeconds() + 86400) % 86400;
      var v = { h: Math.floor(left / 3600), m: Math.floor(left % 3600 / 60), s: left % 60 };
      Object.keys(v).forEach(function (k) { cd.querySelector('[data-u="' + k + '"]').textContent = (v[k] < 10 ? '0' : '') + v[k]; });
      cd.hidden = false;
      return true;
    }
    function place() {
      var copy = document.querySelector('#MainContent .mc__buy-copy');
      if (!copy) return false;
      if (tx && !copy.querySelector('[data-mbx]')) {
        var before = copy.querySelector(':scope > .mc-for') || copy.querySelector(':scope > .mc__h1');
        if (before) {
          copy.insertBefore(tx.content.cloneNode(true), before);
          var cd = copy.querySelector('[data-mbx-cd]');
          tick(cd); setInterval(function () { tick(cd); }, 1000);
        }
      }
      var tp = document.querySelector('template[data-mpay-tpl]'), del = copy.querySelector('.mpb-x .mpb-del');
      if (tp && del && !copy.querySelector('.mpay')) del.insertAdjacentElement('afterend', tp.content.firstElementChild.cloneNode(true));
      var plans = copy.querySelector(':scope > .mc__plans');
      if (tf && plans && !copy.querySelector('.mbf--plans')) { plans.insertAdjacentElement('afterend', note('mbf--plans')); if (tv) plans.insertAdjacentElement('beforebegin', note('mbf--plans mbf--v', tv)); }
      var o = copy.querySelector('.mm-o'), btn = o && o.querySelector('.mm-o__btn');
      if (tf && btn && !o.querySelector('.mbf--o')) { btn.insertAdjacentElement('beforebegin', note('mbf--o')); if (tv) o.insertBefore(note('mbf--o mbf--v', tv), o.firstChild); }
      return true;
    }
    function run() { var n = 0; (function again() { if (!place() && n++ < 20) setTimeout(again, 300); })(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>
