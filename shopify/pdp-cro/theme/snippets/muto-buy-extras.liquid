{%- comment -%}
  MUTO — buy box extras (muto-buy-extras). Rendered once by the "MUTO BF style" section, which passes `end`.
  Adds three things to the product page's buy box:
    1. "High demand" pill. If the shop metafield muto.bf_orders_left holds a number above 0 it reads
       "only N welcome kits left"; otherwise "few welcome kits left". This file only READS the metafield.
       The claim must be true: remove the pill (delete .mbx__hot below) when kits are not running low.
    2. "Black Friday is live" banner with a countdown to `end` (section setting "Black Friday ends",
       UK time, e.g. 2026-11-30T23:59:59). It counts down to that one moment and never resets. With no end
       set, or once it has passed, the banner shows without a countdown. The end must be the offer's real end.
    3. The value note ("Replaces 5 supplements", with the honest price per day now and after the
       introductory price) and the subscription flexibility note, beside the plan selector (under the plan
       cards on desktop, under the buy button on phones). The per-day figures are £99, £125 and £150 over
       90 days: change them here if the prices change.
  They are placed by the script below because the buy box's parts are arranged by other files.
{%- endcomment -%}
{%- liquid
  assign bx_left = shop.metafields.muto.bf_orders_left.value
  assign bx_left_n = bx_left | plus: 0
-%}
<style>
  .mbx,.mbx p,.mbf,.mbf p{font-family:var(--mc-font,"Neue Haas Grotesk Display Pro"),sans-serif;-webkit-font-smoothing:antialiased}
  .mbx{order:-4;display:grid;gap:10px;justify-items:start;width:100%;box-sizing:border-box;margin:0 0 16px}
  .mbx__hot{display:inline-flex;align-items:center;gap:9px;margin:0;padding:6px 14px 6px 10px;border-radius:999px;background:#fbe9e7;color:#b3261e;font-size:14px;font-weight:500;line-height:1.3}
  .mbx__dot{position:relative;flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:#b3261e}
  .mbx__dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;background:rgba(179,38,30,.22);animation:mbx-pulse 1.8s ease-out infinite}
  @keyframes mbx-pulse{0%{transform:scale(.5);opacity:1}100%{transform:scale(1.5);opacity:0}}
  .mbx__bar{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;box-sizing:border-box;padding:14px 16px 14px 20px;border-radius:12px;background:#242223;color:#fff}
  .mbx__t{display:grid;gap:3px;min-width:0}
  .mbx__t b{font-size:19px;font-weight:500;line-height:1.15;letter-spacing:-.01em;text-transform:uppercase}
  .mbx__t span{font-size:13.5px;line-height:1.3;color:rgba(255,255,255,.78)}
  .mbx__t i{font-style:normal;color:#5efaff}
  .mbx__cd{flex:0 0 auto;display:flex;gap:6px}
  .mbx__cd[hidden]{display:none}
  .mbx__u{display:grid;justify-items:center;gap:1px;min-width:44px;padding:7px 4px 6px;border-radius:8px;background:#fff;color:#242223}
  .mbx__u b{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:18px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
  .mbx__u span{font-family:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#5c5a5b}
  @media (max-width:749px){
    .mbx{margin:16px 0 4px}
    .mbx__bar{padding:12px 12px 12px 14px;gap:10px}
    .mbx__t b{font-size:15.5px}
    .mbx__t span{font-size:12px}
    .mbx__cd{gap:4px}
    .mbx__u{min-width:36px;padding:6px 2px 5px}
    .mbx__u b{font-size:15px}
    .mbx__u span{font-size:8px}
  }
  @media (prefers-reduced-motion:reduce){.mbx__dot::after{animation:none}}
  /* The buy box orders its parts with CSS "order"; these keep the widget above the headline and the notes
     straight after the plan cards, whatever the theme's own rules give other children. */
  html:root body #MainContent#MainContent .mc .mc__buy-copy > .mbx{order:-4!important}
  html:root body #MainContent#MainContent .mc .mc__buy-copy > .mbf--plans{order:2!important}

  /* Subscription flexibility, beside the plan selector */
  .mbf{order:2;display:flex;align-items:flex-start;gap:10px;width:100%;box-sizing:border-box;margin:12px 0 0;padding:12px 14px;border-radius:10px;background:#f4f2ef;color:#242223;font-size:14px;line-height:1.45}
  .mbf svg{flex:0 0 auto;width:18px;height:18px;margin-top:1px}
  .mbf p{margin:0}
  .mbf b{font-weight:500}
  .mbf--o{margin:12px 0 0}
  .mbf--v{background:#fff;border:1px solid rgba(36,34,35,.14)}
  .mbf--v + .mbf{margin-top:8px}
  @media (max-width:749px){.mbf--plans{display:none}.mbf{font-size:13.5px}}
  @media (min-width:750px){.mbf--o{display:none}}
</style>
<template data-mbx-tpl>
  <div class="mbx" data-mbx>
    <p class="mbx__hot"><span class="mbx__dot" aria-hidden="true"></span>High demand: {% if bx_left_n > 0 %}only {{ bx_left_n }}{% else %}few{% endif %} welcome kits left</p>
    <div class="mbx__bar">
      <p class="mbx__t"><b>Black Friday is live</b><span><i>53% off</i> your first 3 months</span></p>
      <div class="mbx__cd" data-mbx-cd data-end="{{ end | strip | escape }}" role="timer" aria-label="Time left on the Black Friday offer" hidden>
        <span class="mbx__u"><b data-u="d">00</b><span>Days</span></span>
        <span class="mbx__u"><b data-u="h">00</b><span>Hrs</span></span>
        <span class="mbx__u"><b data-u="m">00</b><span>Min</span></span>
        <span class="mbx__u"><b data-u="s">00</b><span>Sec</span></span>
      </div>
    </div>
  </div>
</template>
<template data-mbv-tpl>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M17 15l2 2 3-4"/></svg>
  <p><b>Replaces 5 supplements in one jar.</b> A separate NAD+ supplement, CoQ10, resveratrol, vitamin D3 with K2 and a B complex. <b>£1.10 a day</b> for your first 3 months, then £1.39 to £1.67 a day.</p>
</template>
<template data-mbf-tpl>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v5h-5"/></svg>
  <p><b>Skip, pause or cancel online with 2 clicks.</b> No phone calls. We email you 5 days before every payment.</p>
</template>
<script>
  (function () {
    var tx = document.querySelector('template[data-mbx-tpl]'), tf = document.querySelector('template[data-mbf-tpl]');
    var tv = document.querySelector('template[data-mbv-tpl]');
    function note(cls, t) { var d = document.createElement('div'); d.className = 'mbf ' + cls; d.appendChild((t || tf).content.cloneNode(true)); return d; }
    function tick(cd, end) {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left <= 0) { cd.hidden = true; return false; }
      var v = { d: Math.floor(left / 86400), h: Math.floor(left % 86400 / 3600), m: Math.floor(left % 3600 / 60), s: left % 60 };
      Object.keys(v).forEach(function (k) { cd.querySelector('[data-u="' + k + '"]').textContent = (v[k] < 10 ? '0' : '') + v[k]; });
      cd.hidden = false;
      return true;
    }
    function place() {
      var copy = document.querySelector('#MainContent .mc__buy-copy');
      if (!copy) return false;
      if (tx && !copy.querySelector('[data-mbx]')) {
        var before = copy.querySelector(':scope > .mc-for') || copy.querySelector(':scope > .mc__h1');
        if (before) {
          copy.insertBefore(tx.content.cloneNode(true), before);
          var cd = copy.querySelector('[data-mbx-cd]'), raw = cd.getAttribute('data-end');
          /* The end is typed in UK time; in late November the UK is on GMT, so it is read as UTC */
          var end = raw ? Date.parse(/[zZ]|[+-]\d\d:?\d\d$/.test(raw) ? raw : raw + 'Z') : NaN;
          if (!isNaN(end) && tick(cd, end)) { var t = setInterval(function () { if (!tick(cd, end)) clearInterval(t); }, 1000); }
        }
      }
      var plans = copy.querySelector(':scope > .mc__plans');
      if (tf && plans && !copy.querySelector('.mbf--plans')) { plans.insertAdjacentElement('afterend', note('mbf--plans')); if (tv) plans.insertAdjacentElement('afterend', note('mbf--plans mbf--v', tv)); }
      var o = copy.querySelector('.mm-o'), btn = o && o.querySelector('.mm-o__btn');
      if (tf && btn && !o.querySelector('.mbf--o')) { btn.insertAdjacentElement('afterend', note('mbf--o')); if (tv) btn.insertAdjacentElement('afterend', note('mbf--o mbf--v', tv)); }
      return true;
    }
    function run() { var n = 0; (function again() { if (!place() && n++ < 20) setTimeout(again, 300); })(); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>
