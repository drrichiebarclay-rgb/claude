{%- comment -%}
  MUTO — Real results, from real people.

  Six vertical video cards. The scientific board band next door makes the same
  argument from authority; this one makes it from evidence, so the card is the
  shape the footage actually arrives in — a phone held upright — rather than
  the board's square interview still.

  The video facade is the board's, hook for hook: `data-mh-video`,
  `data-mh-video-play` and a `<template data-mh-video-src>`, read by the player
  already in muto-home.js. That buys the same three-way order of precedence —
  an uploaded Shopify video, a YouTube or Vimeo URL, or a link out — and the
  same bargain on weight: nothing but the cover image loads until a card is
  clicked, so six testimonials cost six images. No new script is added for this
  band, and a fix to the player reaches both bands at once.

  A card with none of the three set still draws the play mark, decoratively:
  not a button, not focusable, nothing to click. That is the state a card sits
  in while its footage is still being filmed, and it is why this band can ship
  before the videos do.

  BLOCKS, one per person, so a result can be added, swapped or pulled without a
  code change.

  MOBILE: a snap rail. Six portrait cards stacked is six screens of scroll, and
  a row of upright videos is a form people already know how to swipe.
{%- endcomment -%}

{{ 'muto-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'muto-home.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign mh_spt = section.settings.space_top | default: 100 | times: 0.01
  assign mh_spb = section.settings.space_bottom | default: 100 | times: 0.01
  assign heading_id = 'mh-res-' | append: section.id
  assign ratio = section.settings.ratio | default: '9/16'
-%}

<div class="mh mh--alt{% if section.settings.field %} mh--field-board mh--fit-{{ section.settings.fit | default: 'nad' }}{% endif %}" data-mh style="--mh-spt:{{ mh_spt }};--mh-spb:{{ mh_spb }};--mh-res-gap:{{ section.settings.rail_gap | default: 48 }}px;--mh-res-ratio:{{ ratio }}">
  <div class="mh__wrap">
    <section class="mh__res" aria-labelledby="{{ heading_id }}">
      <div class="mh__res-top">
        {%- if section.settings.heading != blank -%}
          <h2 class="mh__h2" id="{{ heading_id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="mh__res-note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>

      <ul class="mh__res-rail mh__rail">
        {%- for block in section.blocks -%}
          {%- liquid
            assign still_alt = block.settings.image_alt | default: block.settings.name
            assign has_video = false
            if block.settings.video != blank or block.settings.video_url != blank
              assign has_video = true
            endif
            assign who = block.settings.name | default: 'this customer'
            assign play_label = 'Play the video from ' | append: who
          -%}
          <li class="mh__res-card" {{ block.shopify_attributes }}>
            <div class="mh__res-media mh__member-media" data-mh-video>
              {% render 'muto-image',
                image: block.settings.image,
                fallback: block.settings.image_fallback,
                alt: still_alt,
                ratio: ratio,
                sizes: '(min-width: 990px) 222px, 62vw',
                widths: '240,360,480,720',
                position: block.settings.image_position %}

              {%- if has_video -%}
                <button class="mh__member-trigger" type="button" data-mh-video-play aria-label="{{ play_label | escape }}">
                  {% render 'muto-home-play', uid: block.id %}
                </button>
                <template data-mh-video-src>
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: image_size: '720x', controls: true, autoplay: true, playsinline: true }}
                  {%- else -%}
                    {%- liquid
                      assign vid = block.settings.video_url
                      if vid.type == 'youtube'
                        assign embed = 'https://www.youtube.com/embed/' | append: vid.id | append: '?autoplay=1&rel=0&playsinline=1'
                      else
                        assign embed = 'https://player.vimeo.com/video/' | append: vid.id | append: '?autoplay=1'
                      endif
                    -%}
                    <iframe src="{{ embed }}" title="{{ play_label | escape }}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
                  {%- endif -%}
                </template>

              {%- elsif block.settings.video_link != blank -%}
                <a class="mh__member-trigger" href="{{ block.settings.video_link }}" aria-label="{{ 'Watch the video from ' | append: who | escape }}">
                  {% render 'muto-home-play', uid: block.id %}
                </a>

              {%- elsif block.settings.show_play -%}
                {% render 'muto-home-play', uid: block.id %}
              {%- endif -%}

              {%- comment -%}
                The result sits on the card, not under it: it is the one thing
                a reader scanning six of these is looking for, and under the
                card it competes with the name for the same glance.
              {%- endcomment -%}
              {%- if block.settings.result != blank -%}
                <p class="mh__res-stat">{{ block.settings.result }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.quote != blank -%}
              <blockquote class="mh__res-quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            <div class="mh__res-head">
              <h3 class="mh__res-name">{{ block.settings.name }}</h3>
              {%- if block.settings.tag != blank -%}
                <span class="mh__tag mh__spark">{{ block.settings.tag }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.detail != blank -%}
              <p class="mh__res-detail">{{ block.settings.detail }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.foot != blank -%}
        <p class="mh__res-foot">{{ section.settings.foot }}</p>
      {%- endif -%}
    </section>
  </div>
</div>

{% schema %}
{
  "name": "MUTO — Real results",
  "tag": "section",
  "class": "mh-section",
  "max_blocks": 12,
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Real results,\nfrom real people." },
    { "type": "text", "id": "note", "label": "Note", "info": "Sits opposite the heading on desktop." },
    { "type": "select", "id": "ratio", "label": "Card shape", "default": "9/16", "options": [{ "value": "9/16", "label": "Vertical (9:16, phone video)" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Portrait (3:4)" }], "info": "Set this to the shape the footage was filmed in. 9:16 is a phone held upright." },
    { "type": "checkbox", "id": "field", "label": "Mint gradient background", "default": false, "info": "Off by default: the ingredients band below this one is already washed, and two mint bands running together read as one." },
    { "type": "select", "id": "fit", "label": "Which wash", "default": "nad", "options": [{ "value": "home", "label": "Home page" }, { "value": "nad", "label": "NAD+ page" }], "info": "Only used when the wash above is on." },
    { "type": "range", "id": "rail_gap", "label": "Space under the heading", "min": 24, "max": 120, "step": 1, "unit": "px", "default": 48, "info": "Desktop only." },
    { "type": "textarea", "id": "foot", "label": "Footnote", "info": "Individual results. Worth saying so if the cards quote numbers." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 2, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result",
      "settings": [
        { "type": "header", "content": "Cover" },
        { "type": "image_picker", "id": "image", "label": "Cover image", "info": "A still from the video. Upright — it is cropped to the card shape." },
        { "type": "text", "id": "image_fallback", "label": "Fallback image URL" },
        { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Describe the still. Defaults to the name." },
        { "type": "text", "id": "image_position", "label": "Image focus", "info": "CSS object-position, e.g. \"50% 30%\" to keep a face in frame. Blank centres it." },
        { "type": "header", "content": "Video" },
        { "type": "video", "id": "video", "label": "Video", "info": "Uploaded to Content → Files. Plays inline over the cover." },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"],
          "info": "Used only when no video is uploaded above."
        },
        { "type": "url", "id": "video_link", "label": "Link out", "info": "A last resort: with no video set, the card links out instead." },
        { "type": "checkbox", "id": "show_play", "label": "Play mark without a video", "default": true, "info": "Keeps the mark on a card whose footage is still coming. Decorative only — there is nothing to click until a video is set." },
        { "type": "header", "content": "Details" },
        { "type": "text", "id": "result", "label": "Result", "info": "The headline number, on the card itself. E.g. \"HRV +14% in 90 days\". Keep it to a few words." },
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "One sentence in their words. Optional." },
        { "type": "text", "id": "name", "label": "Name", "default": "First name" },
        { "type": "text", "id": "tag", "label": "Tag", "info": "E.g. \"90 days\" or their sport." },
        { "type": "text", "id": "detail", "label": "Detail", "info": "A line under the name — age, sport, or how long they have been taking it." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUTO — Real results",
      "blocks": [
        { "type": "result", "settings": { "name": "First name" } },
        { "type": "result", "settings": { "name": "First name" } },
        { "type": "result", "settings": { "name": "First name" } },
        { "type": "result", "settings": { "name": "First name" } },
        { "type": "result", "settings": { "name": "First name" } },
        { "type": "result", "settings": { "name": "First name" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "page", "index"]
  }
}
{% endschema %}
