        "faq_q43": {
          "type": "faq",
          "settings": {
            "heading": "How do I take MUTO?",
            "content": "<p>Take two capsules once a day with your first meal. Food helps absorb the fat-soluble ingredients (CoQ10, vitamins D3 and K2), and pairing it with breakfast makes it easy to remember. Consistency matters more than exact timing.</p>"
          }
        },
        "faq_q44": {
          "type": "faq",
          "settings": {
            "heading": "Do I need to cycle MUTO?",
            "content": "<p>No. MUTO contains no stimulants, so there’s nothing to build tolerance to. It’s designed for daily use.</p>"
          }
        },
        "faq_q45": {
          "type": "faq",
          "settings": {
            "heading": "What if I miss a day?",
            "content": "<p>Just take your normal two capsules the next day. Don’t double up.</p>"
