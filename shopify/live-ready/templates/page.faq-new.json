    "faqs_safety": {
      "type": "custom-faqs",
      "blocks": {
        "faq_q36": {
          "type": "faq",
          "settings": {
            "heading": "Is MUTO safe?",
            "content": "<p>MUTO is made in the UK to GMP standards and every batch is third-party tested; certificates are available on request. Like any supplement, it isn’t right for everyone. Speak to your GP or pharmacist first if you’re on medication, have a medical condition, or are pregnant or breastfeeding.</p>"
          }
        },
        "faq_q37": {
          "type": "faq",
          "settings": {
            "heading": "Are there any side effects?",
            "content": "<p>Most people take MUTO without any problems. A few notice mild stomach discomfort in the first days, which taking it with food usually avoids. Stop taking it and contact us if anything feels wrong.</p>"
          }
        },
        "faq_q38": {
          "type": "faq",
          "settings": {
            "heading": "Can I take MUTO with medication?",
            "content": "<p>Check with your GP or pharmacist first if you take any prescription medicine. In particular, MUTO contains vitamin K2 (100µg), which can affect blood thinners such as warfarin. Resveratrol and grape seed extract may also interact with anticoagulant and antiplatelet medicines. We’re happy to send the full label to share with your doctor.</p>"
          }
        },
        "faq_q39": {
          "type": "faq",
          "settings": {
            "heading": "Can I take MUTO if I’m on HRT or hormonal contraception?",
            "content": "<p>Talk to your GP or pharmacist before starting. If you take any medication, including HRT or hormonal contraception, please check with your doctor first. We’re happy to send the full label to share with them.</p>"
          }
        },
        "faq_q40": {
          "type": "faq",
          "settings": {
            "heading": "Can I take MUTO if I’m pregnant or breastfeeding?",
            "content": "<p>No. MUTO isn’t for use during pregnancy or breastfeeding, or for anyone under 18. Nicotinamide riboside is authorised in Great Britain for adults only, excluding pregnant and breastfeeding women.</p>"
          }
        },
        "faq_q41": {
          "type": "faq",
          "settings": {
            "heading": "Is MUTO suitable for drug-tested athletes?",
            "content": "<p>MUTO isn’t yet certified by a banned-substance testing programme such as Informed Sport. If you’re tested under WADA or UKAD rules, speak to your sport’s medical team before taking any supplement.</p>"
          }
        },
        "faq_q42": {
          "type": "faq",
          "settings": {
            "heading": "Can I take MUTO with other supplements or coffee?",
            "content": "<p>Yes, in most cases, and coffee is fine. Watch for doubling up: a separate B complex, zinc, vitamin D, K2 or NAD+ product will overlap with what’s already in MUTO. Check your other labels against ours.</p>"
          }
        }
      },
