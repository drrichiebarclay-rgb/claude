    "faqs_guarantee": {
      "type": "custom-faqs",
      "blocks": {
        "faq_q17": {
          "type": "faq",
          "settings": {
            "heading": "What is the 90-day money-back guarantee?",
            "content": "<p>If you subscribe, take MUTO daily and don’t see a difference within 90 days, we’ll refund every subscription payment you’ve made in that time, less our delivery costs. We won’t ask you to take MUTO on trust, so we don’t ask you to risk your money on it either.</p>"
          }
        },
        "faq_q18": {
          "type": "faq",
          "settings": {
            "heading": "Who is covered?",
            "content": "<p>The guarantee covers first-time MUTO subscribers buying at muto.co, one claim per customer. One-time purchases aren’t covered, and neither are orders through Amazon or other retailers. Contact them directly.</p>"
          }
        },
        "faq_q19": {
          "type": "faq",
          "settings": {
            "heading": "How do I claim?",
            "content": "<p>Email <a href=\"mailto:hello@mutolongevity.com\">hello@mutolongevity.com</a> with your name, order number and a line on your experience, within 104 days of your first order. That’s your full 90 days, plus 14 days to decide. We’ll refund your original payment method within 7 working days of your request. Sharing your wearable data helps us learn but is optional.</p>"
          }
        },
        "faq_q20": {
          "type": "faq",
          "settings": {
            "heading": "Do I need to send my wearable data?",
            "content": "<p>No. Your verdict is yours. If you’d like help reading your data before deciding, send it over and we’ll go through it with you.</p>"
          }
        }
      },
