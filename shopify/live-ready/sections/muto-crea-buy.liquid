        { "type": "text", "id": "note", "label": "Note", "default": "Billed £19.99 every 4 weeks, 66p/day." },
        { "type": "richtext", "id": "detail", "label": "Details", "info": "This plan's own copy — what the cadence means, who it suits. Shown under the strip only while this plan is the one chosen, and swapped as the customer switches. Leave empty and nothing is drawn." }
      ]
    },
    {
      "type": "fold",
