        { "type": "text", "id": "text", "label": "What arrives", "default": "Refill pouch + bottle" },
        { "type": "text", "id": "value", "label": "Worth", "default": "\u00a315", "info": "Struck through, because the gift is free and this is what it would otherwise cost. Two values separated by a space are struck separately \u2014 \u201c\u00a330 \u00a310\u201d. Anything that isn\u2019t a run of currency figures is left alone." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_fallback", "label": "Fallback image URL" },
        { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Describe the gift. Defaults to what arrives." },
        { "type": "text", "id": "plans", "label": "Show on which plans", "info": "Empty shows it on every plan. Otherwise the plan's position in the strip — 1 for the first card, 2 for the second. Separate several with commas." }
