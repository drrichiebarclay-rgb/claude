{%- comment -%}
  MUTO — Science (simple). A calm, all-white science page in the same type system as the ingredients
  page (muto-ingredient-library): the site's uppercase section heading, mono eyebrows, hairline rules,
  21px item titles, doses in the teal mono. One section type, several layouts:
    intro      Centred eyebrow, heading, lede, buttons; then an "At 20 / After 35" table (blocks: item:
               title = row, a = at 20, b = after 35).
    shifts     Centred heading and lede, the NAD+ decline chart, then numbered columns (blocks: item).
    jobs       Centred heading and lede, then columns with a mono dose line (blocks: item: title, a = doses, text).
    numbers    Big figures on hairlines (blocks: item: figure, title, text) and small print.
    statement  Centred eyebrow, a large statement, a mono line under it.
    offer      An outlined box: eyebrow, heading, text, button.
  Every word is a setting or a block, so it can all be edited in Customize.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }}{--msc-ink:#242223;--msc-muted:#5c5a5b;--msc-rule:rgba(36,34,35,.14);--msc-accent:#2f8fa0;--msc-pill:#e3f4f6;--msc-pill-fg:#1f6f7c;--msc-mono:var(--mc-mono,"Sometype Mono"),ui-monospace,monospace}
  /* Brand faces throughout; the theme's own heading fonts and bold weights don't apply (as on the ingredients page) */
  #shopify-section-{{ sid }} .msc,#shopify-section-{{ sid }} .msc h1,#shopify-section-{{ sid }} .msc h2,#shopify-section-{{ sid }} .msc h3,#shopify-section-{{ sid }} .msc p{font-family:var(--mc-font,"Neue Haas Grotesk Display Pro"),sans-serif;-webkit-font-smoothing:antialiased}
  #shopify-section-{{ sid }} .msc b,#shopify-section-{{ sid }} .msc strong{font-weight:500}
  #shopify-section-{{ sid }} .msc{background:#fff;color:var(--msc-ink)}
  #shopify-section-{{ sid }} .msc__in{max-width:1320px;margin:0 auto;padding:{{ s.space_top }}px 20px {{ s.space_bottom }}px}
  #shopify-section-{{ sid }} .msc__head{display:grid;justify-items:center;text-align:center;gap:20px}
  #shopify-section-{{ sid }} .msc__eye{margin:0;font-family:var(--msc-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--msc-muted)}
  #shopify-section-{{ sid }} .msc .msc__h{margin:0;max-width:22ch;text-wrap:balance;font-family:var(--mc-font);color:var(--msc-ink);font-weight:500;font-size:clamp(34px,4.444vw,64px);line-height:.906;letter-spacing:-.014em;text-transform:uppercase}
  #shopify-section-{{ sid }} .msc__lede{margin:0;max-width:52ch;font-size:clamp(17px,1.4vw,20px);line-height:1.4;text-wrap:balance;color:var(--msc-ink)}
  #shopify-section-{{ sid }} .msc__btns{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px 24px;margin-top:8px}
  #shopify-section-{{ sid }} .msc__btn{display:inline-flex;align-items:center;min-height:56px;padding:0 28px;border-radius:28px;background:#5efaff;color:var(--msc-ink);font-size:17px;font-weight:500;text-decoration:none}
  #shopify-section-{{ sid }} .msc__btn:hover{background:#3ef0f6}
  #shopify-section-{{ sid }} .msc__link{font-size:17px;font-weight:500;color:var(--msc-ink);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
  #shopify-section-{{ sid }} .msc__small{margin:28px auto 0;max-width:72ch;text-align:center;font-size:14px;line-height:1.5;color:var(--msc-muted)}
  #shopify-section-{{ sid }} .msc__mono{font-family:var(--msc-mono);font-size:14px;font-weight:500;line-height:1.4;color:var(--msc-accent)}

  /* Intro: At 20 / After 35 */
  #shopify-section-{{ sid }} .msc__vs{max-width:980px;margin:56px auto 0;border-top:1px solid var(--msc-ink)}
  #shopify-section-{{ sid }} .msc__vs-row{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:24px;padding:20px 0;border-bottom:1px solid var(--msc-rule);align-items:baseline}
  #shopify-section-{{ sid }} .msc__vs-row--head{padding:16px 0}
  #shopify-section-{{ sid }} .msc__vs-row--head span{font-family:var(--msc-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--msc-muted)}
  #shopify-section-{{ sid }} .msc__vs-row--head span:last-child{color:var(--msc-pill-fg)}
  #shopify-section-{{ sid }} .msc__vs-t{font-size:19px;font-weight:500;line-height:1.25}
  #shopify-section-{{ sid }} .msc__vs-a{font-size:17px;line-height:1.4;color:var(--msc-muted)}
  #shopify-section-{{ sid }} .msc__vs-b{font-size:17px;line-height:1.4;font-weight:500}

  /* Shifts: chart, then numbered columns */
  #shopify-section-{{ sid }} .msc__chart{max-width:980px;margin:48px auto 0;color:var(--msc-ink)}
  #shopify-section-{{ sid }} .msc__chart svg{display:block;width:100%;height:auto}
  #shopify-section-{{ sid }} .msc__cols{display:grid;grid-template-columns:repeat(var(--n,3),minmax(0,1fr));gap:40px 28px;margin-top:56px;padding:0;list-style:none}
  #shopify-section-{{ sid }} .msc__col{margin:0;padding-top:20px;border-top:1px solid var(--msc-ink)}
  #shopify-section-{{ sid }} .msc__num{font-family:var(--msc-mono);font-size:13px;letter-spacing:.08em;color:var(--msc-muted)}
  #shopify-section-{{ sid }} .msc__t{margin:12px 0 0;font-size:21px;font-weight:500;line-height:1.2;letter-spacing:-.01em}
  #shopify-section-{{ sid }} .msc__col .msc__mono{margin:10px 0 0}
  #shopify-section-{{ sid }} .msc__x{margin:12px 0 0;font-size:16px;line-height:1.5;color:var(--msc-muted)}

  /* Numbers */
  #shopify-section-{{ sid }} .msc__nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:40px 28px;margin-top:56px}
  #shopify-section-{{ sid }} .msc__fig{display:block;padding-bottom:18px;border-bottom:1px solid var(--msc-ink);font-size:clamp(48px,5vw,80px);font-weight:500;line-height:.9;letter-spacing:-.03em}
  #shopify-section-{{ sid }} .msc__fig small{font-size:.5em;letter-spacing:-.01em}

  /* Statement */
  #shopify-section-{{ sid }} .msc__state{margin:0;max-width:30ch;text-align:center;font-weight:500;font-size:clamp(24px,2.6vw,40px);line-height:1.15;letter-spacing:-.015em;text-wrap:balance}
  #shopify-section-{{ sid }} .msc__head .msc__mono{color:var(--msc-pill-fg)}

  /* Offer */
  #shopify-section-{{ sid }} .msc__offer{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:48px;border:1px solid var(--msc-ink);border-radius:8px}
  #shopify-section-{{ sid }} .msc__offer .msc__h{max-width:none;font-size:clamp(30px,3.4vw,52px)}
  #shopify-section-{{ sid }} .msc__offer .msc__eye{color:var(--msc-pill-fg)}
  #shopify-section-{{ sid }} .msc__offer .msc__lede{margin-top:16px}

  @media (max-width:989px){
    #shopify-section-{{ sid }} .msc__cols{grid-template-columns:repeat(2,minmax(0,1fr))}
    #shopify-section-{{ sid }} .msc__nums{grid-template-columns:repeat(2,minmax(0,1fr))}
    #shopify-section-{{ sid }} .msc__offer{flex-direction:column;align-items:flex-start;gap:24px;padding:32px}
  }
  @media (max-width:749px){
    #shopify-section-{{ sid }} .msc__in{padding:{{ s.space_top | times: 0.66 | round }}px 16px {{ s.space_bottom | times: 0.66 | round }}px}
    #shopify-section-{{ sid }} .msc__vs{margin-top:40px}
    #shopify-section-{{ sid }} .msc__vs-row{grid-template-columns:1fr 1fr;gap:6px 16px;padding:16px 0}
    #shopify-section-{{ sid }} .msc__vs-t{grid-column:1/-1;font-size:17px}
    #shopify-section-{{ sid }} .msc__vs-row--head span:first-child{display:none}
    #shopify-section-{{ sid }} .msc__vs-a,#shopify-section-{{ sid }} .msc__vs-b{font-size:15px}
    #shopify-section-{{ sid }} .msc__chart{margin-top:32px}
    #shopify-section-{{ sid }} .msc__cols{grid-template-columns:1fr;gap:28px;margin-top:40px}
    #shopify-section-{{ sid }} .msc__t{font-size:18px}
    #shopify-section-{{ sid }} .msc__x{font-size:15px}
    #shopify-section-{{ sid }} .msc__nums{gap:32px 16px;margin-top:40px}
    #shopify-section-{{ sid }} .msc__fig{font-size:44px}
    #shopify-section-{{ sid }} .msc__offer{padding:24px}
    #shopify-section-{{ sid }} .msc__btn{min-height:52px;font-size:16px}
  }
</style>

<div class="msc"{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %}>
  <div class="msc__in">
    {%- capture head -%}
      {%- if s.eyebrow != blank -%}<p class="msc__eye">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}{%- if s.layout == 'intro' -%}<h1 class="msc__h">{{ s.heading }}</h1>{%- else -%}<h2 class="msc__h">{{ s.heading }}</h2>{%- endif -%}{%- endif -%}
      {%- if s.text != blank -%}<p class="msc__lede">{{ s.text }}</p>{%- endif -%}
    {%- endcapture -%}

    {%- case s.layout -%}
      {%- when 'intro' -%}
        <header class="msc__head">
          {{ head }}
          {%- if s.button_label != blank or s.link_label != blank -%}
            <div class="msc__btns">
              {%- if s.button_label != blank -%}<a class="msc__btn" href="{{ s.button_link }}">{{ s.button_label }}</a>{%- endif -%}
              {%- if s.link_label != blank -%}<a class="msc__link" href="{{ s.link }}">{{ s.link_label }}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </header>
        {%- if section.blocks.size > 0 -%}
          <div class="msc__vs" role="table" aria-label="{{ s.heading | escape }}">
            <div class="msc__vs-row msc__vs-row--head" role="row"><span role="columnheader"></span><span role="columnheader">{{ s.col_a }}</span><span role="columnheader">{{ s.col_b }}</span></div>
            {%- for b in section.blocks -%}
              <div class="msc__vs-row" role="row" {{ b.shopify_attributes }}>
                <span class="msc__vs-t" role="rowheader">{{ b.settings.title }}</span>
                <span class="msc__vs-a" role="cell">{{ b.settings.a }}</span>
                <span class="msc__vs-b" role="cell">{{ b.settings.b }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- when 'shifts' or 'jobs' -%}
        <header class="msc__head">{{ head }}</header>
        {%- if s.layout == 'shifts' -%}
          <div class="msc__chart" aria-hidden="true">
            <svg viewBox="0 0 980 300" fill="none">
              <text x="0" y="16" fill="#5c5a5b" font-family="Sometype Mono, monospace" font-size="13" letter-spacing="1.8">NAD+ IN YOUR CELLS</text>
              <path d="M0 270H980" stroke="#242223" stroke-opacity=".25"/>
              <path d="M12 64 C 200 66, 300 70, 380 88 S 700 200, 968 236" stroke="#242223" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M380 88V270" stroke="#242223" stroke-opacity=".5" stroke-dasharray="3 6"/>
              <circle cx="380" cy="88" r="8" fill="#5efaff" stroke="#242223" stroke-width="2"/>
              <text x="380" y="292" text-anchor="middle" fill="#242223" font-family="Sometype Mono, monospace" font-size="15">35</text>
              <text x="12" y="292" fill="#5c5a5b" font-family="Sometype Mono, monospace" font-size="13" letter-spacing="1.8">20</text>
              <text x="968" y="292" text-anchor="end" fill="#5c5a5b" font-family="Sometype Mono, monospace" font-size="13" letter-spacing="1.8">AGE →</text>
            </svg>
          </div>
        {%- endif -%}
        <ol class="msc__cols" style="--n:{{ section.blocks.size }}">
          {%- for b in section.blocks -%}
            <li class="msc__col" {{ b.shopify_attributes }}>
              <span class="msc__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="msc__t">{{ b.settings.title }}</h3>
              {%- if b.settings.a != blank -%}<p class="msc__mono">{{ b.settings.a }}</p>{%- endif -%}
              {%- if b.settings.text != blank -%}<p class="msc__x">{{ b.settings.text }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
        {%- if s.small != blank -%}<p class="msc__small">{{ s.small }}</p>{%- endif -%}

      {%- when 'numbers' -%}
        <header class="msc__head">{{ head }}</header>
        <div class="msc__nums">
          {%- for b in section.blocks -%}
            <p {{ b.shopify_attributes }} style="margin:0"><span class="msc__fig">{{ b.settings.figure }}{% if b.settings.unit != blank %}<small>{{ b.settings.unit }}</small>{% endif %}</span>
              <span class="msc__t" style="display:block;margin-top:16px">{{ b.settings.title }}</span>
              {%- if b.settings.text != blank -%}<span class="msc__x" style="display:block">{{ b.settings.text }}</span>{%- endif -%}</p>
          {%- endfor -%}
        </div>
        {%- if s.small != blank -%}<p class="msc__small">{{ s.small }}</p>{%- endif -%}

      {%- when 'statement' -%}
        <div class="msc__head">
          {%- if s.eyebrow != blank -%}<p class="msc__eye">{{ s.eyebrow }}</p>{%- endif -%}
          <p class="msc__state">{{ s.text }}</p>
          {%- if s.small != blank -%}<p class="msc__mono">{{ s.small }}</p>{%- endif -%}
          {%- if s.link_label != blank -%}<a class="msc__link" href="{{ s.link }}">{{ s.link_label }}</a>{%- endif -%}
        </div>

      {%- when 'offer' -%}
        <div class="msc__offer">
          <div>
            {%- if s.eyebrow != blank -%}<p class="msc__eye">{{ s.eyebrow }}</p>{%- endif -%}
            <h2 class="msc__h" style="margin-top:14px">{{ s.heading }}</h2>
            {%- if s.text != blank -%}<p class="msc__lede">{{ s.text }}</p>{%- endif -%}
          </div>
          {%- if s.button_label != blank -%}<a class="msc__btn" href="{{ s.button_link }}">{{ s.button_label }}</a>{%- endif -%}
        </div>
        {%- if s.small != blank -%}<p class="msc__small">{{ s.small }}</p>{%- endif -%}
    {%- endcase -%}
  </div>
</div>

{% schema %}
{
  "name": "MUTO — Science (simple)",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "intro", "options": [
      { "value": "intro", "label": "Intro with At 20 / After 35 table" },
      { "value": "shifts", "label": "Chart and numbered columns" },
      { "value": "jobs", "label": "Columns with doses" },
      { "value": "numbers", "label": "Big numbers" },
      { "value": "statement", "label": "Statement" },
      { "value": "offer", "label": "Offer box" }
    ] },
    { "type": "text", "id": "anchor", "label": "Anchor" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text (statement: the statement)" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Text link" },
    { "type": "url", "id": "link", "label": "Text link URL" },
    { "type": "text", "id": "col_a", "label": "Table: first column", "default": "At 20" },
    { "type": "text", "id": "col_b", "label": "Table: second column", "default": "After 35" },
    { "type": "textarea", "id": "small", "label": "Small print (statement: mono line)" },
    { "type": "range", "id": "space_top", "label": "Space above", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "title", "label": "Title (table: row name)" },
      { "type": "text", "id": "a", "label": "Table: first column / columns: mono line" },
      { "type": "text", "id": "b", "label": "Table: second column" },
      { "type": "text", "id": "figure", "label": "Big number" },
      { "type": "text", "id": "unit", "label": "Unit after the number" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "MUTO — Science (simple)" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
