            "title": "You make less NAD+",
            "a": "NAD+ · mitochondria",
            "b": "",
            "figure": "",
            "unit": "",
            "text": "Every cell makes its own energy in tiny power stations called mitochondria. NAD+ carries energy from your food to them. From your mid-30s your body makes less of it: fewer couriers, the same work.",
            "at20": "Plenty, made every day",
            "after35": "Gradually falling"
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "title": "You get less back",
            "a": "Anabolic resistance",
            "b": "",
            "figure": "",
            "unit": "",
            "text": "Your body responds less to the same food and the same training: same effort, smaller return. Scientists call it anabolic resistance.",
            "at20": "The full return",
            "after35": "A smaller return"
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "title": "Your cells’ maintenance slows",
            "a": "Sirtuins · NAD+",
            "b": "",
            "figure": "",
            "unit": "",
            "text": "The enzymes that clean up after energy production, called sirtuins, also run on NAD+. Less NAD+ means more competition for the same supply.",
            "at20": "Keep up easily",
            "after35": "Compete for less NAD+"
          }
        }
