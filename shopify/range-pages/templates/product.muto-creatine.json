    "benefits": {
      "type": "muto-crea-benefits",
      "blocks": {
        "pf": {
          "type": "panel",
          "settings": {
            "label": "Benefits you'll feel",
            "key": "feel",
            "heading": "Feel it before\nyou see it",
            "lede": "What customers notice as creatine stores build over several weeks. Open any of them for the mechanism.",
            "image": "shopify://shop_images/crea-benefits-feel-run.jpg",
            "image_fallback": "",
            "image_alt": "",
            "image_position": "",
            "cta_label": "Start your 90 days",
            "cta_link": ""
          }
        },
        "f1": {
          "type": "benefit",
          "settings": {
            "panel": "feel",
            "title": "Performance",
            "sub": "The last station, not just the first",
            "text": "<p>Creatine refills the phosphocreatine your muscles spend in the first seconds of a hard effort, so the fast reserve is there again for the next one. Across repeated sprints and stations that shows up as less drop-off from the first to the last.</p>"
          }
        },
        "f2": {
          "type": "benefit",
          "settings": {
            "panel": "feel",
            "title": "Strength",
            "sub": "Built session after session",
            "text": "<p>More work completed per session is more stimulus to adapt to. Taken daily alongside resistance training, creatine supports the strength you are already working for rather than replacing the work.</p>"
          }
        },
        "f3": {
          "type": "benefit",
          "settings": {
            "panel": "feel",
            "title": "Cognition",
            "sub": "Fast energy for a busy brain",
            "text": "<p>Your brain stores creatine for the same reason your muscles do: fast energy when demand spikes. Research is exploring its role in mental performance, with the clearest signals on short sleep and long days.</p>"
          }
        },
        "f4": {
          "type": "benefit",
          "settings": {
            "panel": "feel",
            "title": "Healthy Ageing",
            "sub": "Strength for years, not seasons",
            "text": "<p>Strength is part of ageing well. With regular training, a daily scoop helps you keep building it — the trial evidence in adults over 50 is about lean mass kept, not just gained.</p>"
          }
        },
        "pt": {
          "type": "panel",
          "settings": {
            "label": "Benefits you can track",
            "key": "track",
            "heading": "Then check it in\nyour own log",
            "lede": "Same programme, same routine, noted before your first scoop. Check in at weeks 4 and 8, alongside your NAD+ check-in.",
            "image": "shopify://shop_images/crea-benefits-track-bike.jpg",
            "image_fallback": "",
            "image_alt": "",
            "image_position": "",
            "cta_label": "Start your 90 days",
            "cta_link": ""
          }
        },
        "t1": {
          "type": "benefit",
          "settings": {
            "panel": "track",
            "title": "Interval Splits",
            "sub": "Repeat efforts, timed",
            "text": "<p>Pick one repeatable session and time every effort in it. The number to watch is not the first split but the spread between the first and the last.</p>"
          }
        },
        "t2": {
          "type": "benefit",
          "settings": {
            "panel": "track",
            "title": "Repetitions",
            "sub": "Your cleanest strength signal",
            "text": "<p>Same lift, same load, same rest. Reps completed at a fixed weight is the least noisy strength measure you can take without a lab.</p>"
          }
        },
        "t3": {
          "type": "benefit",
          "settings": {
            "panel": "track",
            "title": "Sharpness on Long Days",
            "sub": "Rated 1–10, on short sleep",
            "text": "<p>Rate how sharp you felt out of ten, and note the hours you slept beside it. The effect to look for is on the short nights, not the good ones.</p>"
          }
        },
        "t4": {
          "type": "benefit",
          "settings": {
            "panel": "track",
            "title": "Session Consistency",
            "sub": "Training you can keep up",
            "text": "<p>Count the sessions you actually completed each week. Consistency is what turns any of the above into a trend rather than a good day.</p>"
          }
        }
      },
